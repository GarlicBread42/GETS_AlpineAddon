//Spriteset B Gummiwulst

spriteset(spriteset_BLS_RIC_Wulst_B, "gfx/BLS_RIC/BLS_RIC_Wulst_B_1x_8bpp.png")
									{ template_138trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_RIC_Wulst_B, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_RIC/BLS_RIC_Wulst_B_1x_32bpp.png", "gfx/BLS_RIC/BLS_RIC_Wulst_B_1x_mask.png")
