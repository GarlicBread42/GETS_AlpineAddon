									{template_138trains_4x(0, 0)}

spriteset(spriteset_BLS_RIC_Wulst_B_loading, "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_1x_8bpp.png")
									{ template_138trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_RIC_Wulst_B_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_1x_32bpp.png", "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_1x_mask.png")
									{template_138trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_RIC_Wulst_B_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_2x_32bpp.png", "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_2x_mask.png")
									{template_138trains_2x(0, 0)}
	alternative_sprites (spriteset_BLS_RIC_Wulst_B_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_4x_32bpp.png", "gfx/BLS_RIC/BLS_RIC_Wulst_B_loading_4x_mask.png")
									{template_138trains_4x(0, 0)}  

spritegroup spritegroup_BLS_RIC_Wulst_B_loading
		{loaded: 	[spriteset_empty];
		loading: 	[spriteset_BLS_RIC_Wulst_B_loading];}	         

//Spritesets purchase                                                                                     

spriteset(spriteset_BLS_RIC_B_purchase, "gfx/BLS_RIC/BLS_RIC_B_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BLS_RIC_B_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_RIC/BLS_RIC_B_1x_32bpp.png", "gfx/BLS_RIC/BLS_RIC_B_1x_mask.png")
									{template_purchase(0, 0)}

spriteset(spriteset_BLS_RIC_Wulst_B_purchase, "gfx/BLS_RIC/BLS_RIC_Wulst_B_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_BLS_RIC_Wulst_B_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_RIC/BLS_RIC_Wulst_B_1x_32bpp.png", "gfx/BLS_RIC/BLS_RIC_Wulst_B_1x_mask.png")
									{template_purchase(0, 0)}  

//Switches


    switch (FEAT_TRAINS,SELF, switch_BLS_RIC_purchase,build_year){
            0 .. 1964: spriteset_BLS_RIC_B_purchase;
        1965 .. 2050: spriteset_BLS_RIC_Wulst_B_purchase;
            spriteset_BLS_RIC_Wulst_B_purchase;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_RIC_A, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_RIC_A;
        1: spritegroup_BLS_RIC_A_loading;}
        
    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_RIC_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_RIC_B;
        1: spritegroup_BLS_RIC_B_loading;}
        
    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_RIC_AB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_RIC_AB;
        1: spritegroup_BLS_RIC_AB_loading;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_RIC_Wulst_A, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_RIC_Wulst_A;
        1: spritegroup_BLS_RIC_Wulst_A_loading;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_RIC_Wulst_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_RIC_Wulst_B;
        1: spritegroup_BLS_RIC_Wulst_B_loading;}

    switch (FEAT_TRAINS, SELF, random_choose_BLS_RIC, switch_alternative_var_random_bits(1, 2)) {
        1: switch_spritestack_BLS_RIC_A;
        2: switch_spritestack_BLS_RIC_B;
        3: switch_spritestack_BLS_RIC_AB;							
            switch_spritestack_BLS_RIC_B;}   

    switch (FEAT_TRAINS, SELF, random_choose_BLS_RIC_Wulst, switch_alternative_var_random_bits(1, 2)) {
        1: switch_spritestack_BLS_RIC_Wulst_A;
        2: switch_spritestack_BLS_RIC_Wulst_B;
        3: switch_spritestack_BLS_RIC_Wulst_B;							
            switch_spritestack_BLS_RIC_Wulst_B;}   

    switch(FEAT_TRAINS, SELF, switch_length_BLS_RIC, position_in_articulated_veh % 3) {
        0: 4;
        1: 5;
        2: 4;}	

    switch (FEAT_TRAINS, PARENT, switch_running_cost_BLS_RIC,  switch_check_Restaurant_0()) {
        1: return 0;
        0: return 2200;}	
        
    switch (FEAT_TRAINS, PARENT, switch_cargo_aging_BLS_RIC,  switch_check_Restaurant_0()) {
        1: return 233;
        0: return 185;}	  

    switch (FEAT_TRAINS,SELF, switch_BLS_RIC_build_year,build_year){
            0 .. 1964: random_choose_BLS_RIC;
        1965 .. 2050: random_choose_BLS_RIC_Wulst;
            random_choose_BLS_RIC_Wulst;}

    switch(FEAT_TRAINS, SELF, switch_graphics_BLS_RIC_build, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_BLS_RIC_build_year;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_BLS_RIC_build, extra_callback_info1) {
        1 .. 2: return ITEM_BLS_RIC_BUILD;												
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

item (FEAT_TRAINS , ITEM_BLS_RIC_BUILD, 6844)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_RIC_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1950,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						33 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					24;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_BLS_RIC_build;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_EXPRESS),);
			length							: switch_length_BLS_RIC;
			articulated_part				: switch_articulated_BLS_RIC_build;
			purchase						: switch_BLS_RIC_purchase;
			cost_factor						: 470;
			running_cost_factor				: switch_running_cost_BLS_RIC;
			purchase_running_cost_factor	: 2200;
			cargo_age_period				: switch_cargo_aging_BLS_RIC;	
			}
		}   


    switch (FEAT_TRAINS,SELF, switch_BLS_RIC_current_year,current_year){
            0 .. 1964: random_choose_BLS_RIC;
        1965 .. 2050: random_choose_BLS_RIC_Wulst;
            random_choose_BLS_RIC_Wulst;}

    switch(FEAT_TRAINS, SELF, switch_graphics_BLS_RIC_current, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_BLS_RIC_current_year;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_BLS_RIC_current, extra_callback_info1) {
        1 .. 2: return ITEM_BLS_RIC_CURRENT;												
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

item (FEAT_TRAINS , ITEM_BLS_RIC_CURRENT, 6845)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_RIC_CURRENT);
						variant_group:					6844;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);	
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1950,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						33 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					24;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_BLS_RIC_current;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_EXPRESS),);
			length							: switch_length_BLS_RIC;
			articulated_part				: switch_articulated_BLS_RIC_current;
			purchase						: switch_BLS_RIC_purchase;
			cost_factor						: 470;
			running_cost_factor				: switch_running_cost_BLS_RIC;
			purchase_running_cost_factor	: 2200;
