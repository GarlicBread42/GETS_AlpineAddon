									{ template_118trains_1x(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_gruen_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_gruen_loading_1x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_gruen_loading_1x_mask.png")
									{template_118trains_1x(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_gruen_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_gruen_loading_2x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_gruen_loading_2x_mask.png")
									{template_118trains_2x(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_gruen_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_gruen_loading_4x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_gruen_loading_4x_mask.png")
									{template_118trains_4x(0, 0)}
									
spritegroup spritegroup_SBB_Corail_gruen_loading
		{loaded: 	[spriteset_empty];
		loading: 	[spriteset_SBB_Corail_gruen_loading];}										

