//Spritesets purchase

spriteset(spriteset_SBB_Corail_gruen_purchase, "gfx/SBB_Corail/SBB_Corail_gruen_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_gruen_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_gruen_1x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_gruen_1x_mask.png")
									{template_purchase(0, 0)}

spriteset(spriteset_SBB_Corail_weiss_purchase, "gfx/SBB_Corail/SBB_Corail_weiss_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_weiss_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_weiss_1x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_weiss_1x_mask.png")
									{template_purchase(0, 0)}

spriteset(spriteset_SBB_Corail_BLS_purchase, "gfx/SBB_Corail/SBB_Corail_BLS_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_BLS_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_BLS_1x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_BLS_1x_mask.png")
									{template_purchase(0, 0)}

//Switches

						switch (FEAT_TRAINS,SELF, switch_SBB_Corail_purchase,build_year){
							   0 .. 2004: spriteset_SBB_Corail_gruen_purchase;
							2005 .. 2050: spriteset_SBB_Corail_weiss_purchase;
								spriteset_SBB_Corail_weiss_purchase;}
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Corail_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Corail_gruen;
							1: spritegroup_SBB_Corail_gruen_loading;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Corail_weiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Corail_weiss;
							1: spritegroup_SBB_Corail_weiss_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Corail_BLS, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Corail_BLS;
							1: spritegroup_SBB_Corail_BLS_loading;}							

						switch(FEAT_TRAINS, SELF, switch_length_SBB_Corail, position_in_articulated_veh % 3) {
							0: 4;
							1: 3;
							2: 4;}								

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Corail, 1){
							return 1950;}
							
						switch (FEAT_TRAINS,SELF, switch_SBB_Corail_build_year,build_year){
							   0 .. 2004: switch_spritestack_SBB_Corail_gruen;
							2005 .. 2050: switch_spritestack_SBB_Corail_weiss;
								switch_spritestack_SBB_Corail_weiss;}

						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Corail_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_SBB_Corail_build_year;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Corail_build, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_CORAIL_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
item (FEAT_TRAINS , ITEM_SBB_CORAIL_BUILD, 7712)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_CORAIL_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1990,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_MAIL);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[MAIL, GOOD, VALU];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						31 ton;
						dual_headed: 					0;
						default_cargo_type:				MAIL;
						cargo_capacity:					49;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_SBB_Corail_build;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_BAGG_EXP),);
			length							: switch_length_SBB_Corail;
			articulated_part				: switch_articulated_SBB_Corail_build;
			purchase						: switch_SBB_Corail_purchase;
			cost_factor						: 510;
			running_cost_factor				: switch_running_cost_SBB_Corail;
			purchase_running_cost_factor	: 1950;
			}
		}


						switch (FEAT_TRAINS,SELF, switch_SBB_Corail_current_year,current_year){
							   0 .. 2004: switch_spritestack_SBB_Corail_gruen;
							2005 .. 2050: switch_spritestack_SBB_Corail_weiss;
								switch_spritestack_SBB_Corail_weiss;}

						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Corail_current, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_SBB_Corail_current_year;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Corail_current, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_CORAIL_CURRENT;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
