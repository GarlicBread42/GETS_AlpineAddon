		alternative_sprites (spriteset_SBB_Corail_gruen, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_gruen_1x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_gruen_1x_mask.png")
									{template_118trains_1x(0, 0)}
