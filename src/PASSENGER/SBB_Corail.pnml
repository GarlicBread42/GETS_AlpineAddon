									{template_118trains_2x(0, 0)}
		alternative_sprites (spriteset_SBB_Corail_gruen, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/SBB_Corail/SBB_Corail_gruen_4x_32bpp.png", "gfx/SBB_Corail/SBB_Corail_gruen_4x_mask.png")
									{template_118trains_4x(0, 0)}

