									{template_128trains_2x(0, 0)}
	alternative_sprites (spriteset_BLS_BDt_LS_lights_back, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/BLS_BDt_LS/BLS_BDt_LS_lights_back_4x_32bpp.png", "gfx/BLS_BDt_LS/BLS_BDt_LS_lights_back_4x_mask.png")
									{template_128trains_4x(0, 0)}        


//Spritesets purchase

spriteset(spriteset_BLS_BDt_LS_gruen, "gfx/BLS_BDt_LS/BLS_BDt_LS_gruen_1x_8bpp.png")
									{ template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_BDt_LS_gruen, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_BDt_LS/BLS_BDt_LS_gruen_1x_32bpp.png", "gfx/BLS_BDt_LS/BLS_BDt_LS_gruen_1x_mask.png")
									{template_128trains_1x(0, 0)}

spriteset(spriteset_BLS_BDt_LS_LB, "gfx/BLS_BDt_LS/BLS_BDt_LS_LB_1x_8bpp.png")
									{ template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_BDt_LS_LB, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_BDt_LS/BLS_BDt_LS_LB_1x_32bpp.png", "gfx/BLS_BDt_LS/BLS_BDt_LS_LB_1x_mask.png")
									{template_128trains_1x(0, 0)}

spriteset(spriteset_BLS_BDt_LS_Zebra, "gfx/BLS_BDt_LS/BLS_BDt_LS_Zebra_1x_8bpp.png")
									{ template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_BDt_LS_Zebra, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_BDt_LS/BLS_BDt_LS_Zebra_1x_32bpp.png", "gfx/BLS_BDt_LS/BLS_BDt_LS_Zebra_1x_mask.png")
									{template_128trains_1x(0, 0)}     

spriteset(spriteset_BLS_BDt_LS_Gold, "gfx/BLS_BDt_LS/BLS_BDt_LS_Gold_1x_8bpp.png")
									{ template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_BDt_LS_Gold, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_BDt_LS/BLS_BDt_LS_Gold_1x_32bpp.png", "gfx/BLS_BDt_LS/BLS_BDt_LS_Gold_1x_mask.png")
									{template_128trains_1x(0, 0)}

//Switches

    switch (FEAT_TRAINS,SELF, switch_BLS_BDt_LS_purchase,build_year){
            0 .. 1998: spriteset_BLS_BDt_LS_gruen;
        1999 .. 2005: spriteset_BLS_BDt_LS_LB;
        2006 .. 2050: spriteset_BLS_BDt_LS_Zebra;
            spriteset_BLS_BDt_LS_Zebra;} 


    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_BDt_LS_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_BDt_LS_gruen;
        1: spritegroup_BLS_BDt_LS_gruen_loading;
        2: spriteset_BLS_BDt_LS_lights_back;}       

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_BDt_LS_LB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_BDt_LS_LB;
        1: spritegroup_BLS_BDt_LS_Zebra_loading;
        2: spriteset_BLS_BDt_LS_lights_back;}                     

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_BDt_LS_Zebra, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_BDt_LS_Zebra;
        1: spritegroup_BLS_BDt_LS_Zebra_loading;
        2: spriteset_BLS_BDt_LS_lights_back;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_BDt_LS_Gold, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_BDt_LS_Gold;
        1: spritegroup_BLS_BDt_LS_Gold_loading;
        2: spriteset_BLS_BDt_LS_lights_back;}   

    switch(FEAT_TRAINS, SELF, switch_length_BLS_BDt_LS, position_in_articulated_veh % 3) {
        0: 4;
        1: 4;
        2: 4;}	    

    switch (FEAT_TRAINS, PARENT, switch_running_cost_BLS_BDt,  switch_check_Restaurant_0()) {
        1: return 0;
        0: return 1600;}	
        
    switch (FEAT_TRAINS, PARENT, switch_cargo_aging_BLS_BDt,  switch_check_Restaurant_0()) {
        1: return 233;
        0: return 185;}	 

    switch (FEAT_TRAINS,SELF, switch_BLS_BDt_LS_build_year,build_year){
            0 .. 1998: switch_spritestack_BLS_BDt_LS_gruen;
        1999 .. 2005: switch_spritestack_BLS_BDt_LS_LB;
        2006 .. 2050: switch_spritestack_BLS_BDt_LS_Zebra;
            switch_spritestack_BLS_BDt_LS_Zebra;}    

    switch (FEAT_TRAINS,SELF, switch_BLS_BDt_LS_current_year,current_year){
            0 .. 1998: switch_spritestack_BLS_BDt_LS_gruen;
        1999 .. 2005: switch_spritestack_BLS_BDt_LS_LB;
        2006 .. 2050: switch_spritestack_BLS_BDt_LS_Zebra;
            switch_spritestack_BLS_BDt_LS_Zebra;}     

    switch(FEAT_TRAINS, SELF, switch_cargo_capacity_BLS_BDt_LS, cargo_type_in_veh ) {
        PASS: 22;
        TOUR: 22;
        MAIL: 22;
        GOOD: 22;
        VALU: 22;}	
                                    
    switch(FEAT_TRAINS, SELF, switch_BLS_BDt_LS_graphics_build, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_BLS_BDt_LS_build_year;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_BLS_BDt_LS_build, extra_callback_info1) {
        1: return ITEM_BLS_BDT_BUILD;	
        2: return ITEM_MAIL_22;												
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}     

item (FEAT_TRAINS , ITEM_BLS_BDT_BUILD, 7943)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_BDT_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1979,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR, MAIL, GOOD, VALU];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						26 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					22;
						ai_engine_rank: 				0;
						length: 						8;													
			}
			
	//Vehicels Graphics
			graphics{
			default							:switch_BLS_BDt_LS_graphics_build;
			additional_text					: string(STR_CONCAT_3,
											  string(STR_GAUGE_STANDARD),                                                                                          
											  string(STR_DESC_HALFBAGG),
                                              string(STR_DESC_DVT),);
			length							: switch_length_BLS_BDt_LS;
			articulated_part				: switch_articulated_BLS_BDt_LS_build;
			purchase						: switch_BLS_BDt_LS_purchase;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_BLS_BDt;
			purchase_running_cost_factor	: 1600;
			cargo_age_period				: switch_cargo_aging_BLS_BDt;
			cargo_capacity					: switch_cargo_capacity_BLS_BDt_LS;	
			}
		}                                                                       