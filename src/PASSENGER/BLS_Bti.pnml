									{template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_Bti, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BLS_Bti/BLS_Bti_2x_32bpp.png", "gfx/BLS_Bti/BLS_Bti_2x_mask.png")
									{template_128trains_2x(0, 0)}
