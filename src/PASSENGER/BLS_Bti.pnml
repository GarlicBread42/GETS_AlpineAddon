									{ template_128trains_REV_1x(0, 0)}
	alternative_sprites (spriteset_BLS_Bti_lights_front_REV, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_Bti/BLS_Bti_lights_front_1x_32bpp.png", "gfx/BLS_Bti/BLS_Bti_lights_front_1x_mask.png")
									{template_128trains_REV_1x(0, 0)}
	alternative_sprites (spriteset_BLS_Bti_lights_front_REV, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BLS_Bti/BLS_Bti_lights_front_2x_32bpp.png", "gfx/BLS_Bti/BLS_Bti_loading_2x_mask.png")
									{template_128trains_REV_2x(0, 0)}
	alternative_sprites (spriteset_BLS_Bti_lights_front_REV, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/BLS_Bti/BLS_Bti_lights_front_4x_32bpp.png", "gfx/BLS_Bti/BLS_Bti_loading_4x_mask.png")
									{template_128trains_REV_4x(0, 0)}       
                                    
 spriteset(spriteset_BLS_Bti_lights_back, "gfx/BLS_Bti/BLS_Bti_lights_back_1x_8bpp.png")
									{ template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_Bti_lights_back, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_Bti/BLS_Bti_lights_back_1x_32bpp.png", "gfx/BLS_Bti/BLS_Bti_lights_back_1x_mask.png")
									{template_128trains_1x(0, 0)}
	alternative_sprites (spriteset_BLS_Bti_lights_back, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/BLS_Bti/BLS_Bti_lights_back_2x_32bpp.png", "gfx/BLS_Bti/BLS_Bti_loading_2x_mask.png")
