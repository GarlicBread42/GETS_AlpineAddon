    switch (FEAT_TRAINS, PARENT, switch_running_cost_BLS_EW1_Coach,  switch_check_Restaurant_0()) {
        1: return 0;
        0: return 1600;}	
        
    switch (FEAT_TRAINS, PARENT, switch_cargo_aging_BLS_EW1_Coach,  switch_check_Restaurant_0()) {
        1: return 233;
        0: return 185;}	        

