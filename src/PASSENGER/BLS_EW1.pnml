    switch (FEAT_TRAINS, SELF, random_choose_BLS_EW1_gruen, switch_alternative_var_random_bits(1, 2)) {
        1: switch_loadstack_BLS_EW1_gruen_A;
        2: switch_loadstack_BLS_EW1_gruen_B;
        3: switch_loadstack_BLS_EW1_gruen_AB;							
