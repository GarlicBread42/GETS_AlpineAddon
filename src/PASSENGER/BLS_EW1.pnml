            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

item (FEAT_TRAINS , ITEM_BLS_EW1_COACH_BUILD, 6850)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_EW1_COACH_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1957,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						30 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					26;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_BLS_EW1_Coach_build;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_EXPRESS),);
			length							: switch_length_BLS_EW1_Coach;
			articulated_part				: switch_articulated_BLS_EW1_Coach_build;
			purchase						: switch_BLS_EW1_Coach_purchase;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_BLS_EW1_Coach;
			purchase_running_cost_factor	: 2650;
			cargo_age_period				: switch_cargo_aging_BLS_EW1_Coach;	
			}
		}   

    switch(FEAT_TRAINS, SELF, switch_graphics_BLS_EW1_Coach_current, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_BLS_EW1_Coach_current_year;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_BLS_EW1_Coach_current, extra_callback_info1) {
