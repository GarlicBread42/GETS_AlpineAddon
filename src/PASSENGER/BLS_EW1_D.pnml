						switch(FEAT_TRAINS, SELF, switch_BLS_EW1_D_graphics_gruen, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_spritestack_BLS_EW1_D_gruen;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_BLS_EW1_D_gruen, extra_callback_info1) {
							1 .. 2: return ITEM_BLS_EW1_GRUEN;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


