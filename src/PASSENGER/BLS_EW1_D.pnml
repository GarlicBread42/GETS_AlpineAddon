		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_EW1_CURRENT);
						variant_group:					7760;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
