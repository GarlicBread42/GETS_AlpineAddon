//Spritesets purchase                                                                                     

spriteset(spriteset_SBB_RIC_B_purchase, "gfx/SBB_RIC/SBB_RIC_B_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_SBB_RIC_B_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_RIC/SBB_RIC_B_1x_32bpp.png", "gfx/SBB_RIC/SBB_RIC_B_1x_mask.png")
									{template_purchase(0, 0)}

spriteset(spriteset_SBB_RIC_SR_purchase, "gfx/SBB_RIC/SBB_RIC_SR_1x_8bpp.png")
									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_SBB_RIC_SR_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_RIC/SBB_RIC_SR_1x_32bpp.png", "gfx/SBB_RIC/SBB_RIC_SR_1x_mask.png")
									{template_purchase(0, 0)}  

//Switches

    switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RIC_A, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_SBB_RIC_A;
        1: spritegroup_SBB_RIC_A_loading;}
        
    switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RIC_B, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_SBB_RIC_B;
        1: spritegroup_SBB_RIC_B_loading;}
        
    switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RIC_B2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_SBB_RIC_B2;
        1: spritegroup_SBB_RIC_B2_loading;}
       
    switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RIC_SR, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_SBB_RIC_SR;
        1: spritegroup_SBB_RIC_SR_loading;}

    switch (FEAT_TRAINS, SELF, random_choose_SBB_RIC, switch_alternative_var_random_bits(1, 2)) {
        1: switch_spritestack_SBB_RIC_A;
        2: switch_spritestack_SBB_RIC_B;
        3: switch_spritestack_SBB_RIC_B2;							
            switch_spritestack_SBB_RIC_B;}   

    switch(FEAT_TRAINS, SELF, switch_length_SBB_RIC, position_in_articulated_veh % 3) {
        0: 4;
        1: 5;
        2: 4;}	

    switch (FEAT_TRAINS, PARENT, switch_running_cost_SBB_RIC,  switch_check_Restaurant_0()) {
        1: return 0;
        0: return 2200;}	
        
    switch (FEAT_TRAINS, PARENT, switch_cargo_aging_SBB_RIC,  switch_check_Restaurant_0()) {
        1: return 233;
        0: return 185;}	  

    switch(FEAT_TRAINS, SELF, switch_graphics_SBB_RIC, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return random_choose_SBB_RIC;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_SBB_RIC, extra_callback_info1) {
        1 .. 2: return ITEM_SBB_RIC;												
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

item (FEAT_TRAINS , ITEM_SBB_RIC, 6665)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_RIC);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1954,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						33 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					24;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_SBB_RIC;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_EXPRESS),);
			length							: switch_length_SBB_RIC;
			articulated_part				: switch_articulated_SBB_RIC;
			purchase						: spriteset_SBB_RIC_B_purchase;
			cost_factor						: 470;
			running_cost_factor				: switch_running_cost_SBB_RIC;
			purchase_running_cost_factor	: 2200;
			cargo_age_period				: switch_cargo_aging_SBB_RIC;	
			}
		}   


    switch(FEAT_TRAINS, SELF, switch_graphics_SBB_RIC_SR, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_spritestack_SBB_RIC_SR;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_SBB_RIC_SR, extra_callback_info1) {
        1 .. 2: return ITEM_SBB_RIC_SR;												
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

item (FEAT_TRAINS , ITEM_SBB_RIC_SR, 6666)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_RIC_SR);
						variant_group:					6665;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);	
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1984,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						33 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					24;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_SBB_RIC_SR;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_EXPRESS),);
			length							: switch_length_SBB_RIC;
			articulated_part				: switch_articulated_SBB_RIC_SR;
			purchase						: spriteset_SBB_RIC_SR_purchase;
			cost_factor						: 470;
			running_cost_factor				: switch_running_cost_SBB_RIC;
			purchase_running_cost_factor	: 2200;
			cargo_age_period				: switch_cargo_aging_SBB_RIC;	
			}
		}                                         