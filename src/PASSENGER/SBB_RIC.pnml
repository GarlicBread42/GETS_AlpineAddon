									{ template_138trains_1x(0, 0)}
	alternative_sprites (spriteset_SBB_RIC_SR_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_RIC/SBB_RIC_SR_loading_1x_32bpp.png", "gfx/SBB_RIC/SBB_RIC_SR_loading_1x_mask.png")
									{template_138trains_1x(0, 0)}
	alternative_sprites (spriteset_SBB_RIC_SR_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/SBB_RIC/SBB_RIC_SR_loading_2x_32bpp.png", "gfx/SBB_RIC/SBB_RIC_SR_loading_2x_mask.png")
