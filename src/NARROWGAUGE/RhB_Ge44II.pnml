	alternative_sprites (spriteset_RhB_Ge_44II_Sudostschweiz_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44II/RhB_Ge_44II_Sudostschweiz_1x_32bpp.png", "gfx/RhB_Ge_44II/RhB_Ge_44II_Sudostschweiz_1x_mask.png")
									{template_purchase(0, 0)}

//Switches

    switch(FEAT_TRAINS,SELF, switch_purchase_RhB_GE_44II, current_year){
           0 .. 1998: spriteset_RhB_Ge_44II_1973_green_purchase;
        1999 .. 2003: spriteset_RhB_Ge_44II_1999_red_purchase;
        2004 .. 2050: spriteset_RhB_Ge_44II_2004_red_purchase;
            spriteset_RhB_Ge_44II_2004_red_purchase;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_GE_44II_1985, switch_alternative_var_random_bits(1, 1)) {
        1: spriteset_RhB_Ge_44II_1973_green;							
            spriteset_RhB_Ge_44II_1973_red;}  

    switch (FEAT_TRAINS, SELF, random_choose_RhB_GE_44II_2004, switch_alternative_var_random_bits(1, 1)) {
        1: spriteset_RhB_Ge_44II_2004_RHB;							
            spriteset_RhB_Ge_44II_2004_red;}  

    switch(FEAT_TRAINS, SELF, switch_FX_RhB_Ge_44II, position_in_vehid_chain % 2) {
        0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
            return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		

    switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_Ge_44II, 1){
        return 730;}   

    switch (FEAT_TRAINS,SELF, switch_RhB_Ge_44II_build_year,build_year){
           0 .. 1984: spriteset_RhB_Ge_44II_1973_green;
        1985 .. 1998: random_choose_RhB_GE_44II_1985;	
        1999 .. 2003: spriteset_RhB_Ge_44II_1999_red;							   
        2004 .. 2050: random_choose_RhB_GE_44II_2004;
            random_choose_RhB_GE_44II_2004;}

    switch (FEAT_TRAINS,SELF, switch_RhB_Ge_44II_current_year,current_year){
           0 .. 1984: spriteset_RhB_Ge_44II_1973_green;
        1985 .. 1998: random_choose_RhB_GE_44II_1985;	
        1999 .. 2003: spriteset_RhB_Ge_44II_1999_red;							   
        2004 .. 2050: random_choose_RhB_GE_44II_2004;
            random_choose_RhB_GE_44II_2004;} 
    

item (FEAT_TRAINS , ITEM_RHB_GE_44II_BUILD, 5010)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_GE_44II_BUILD);					
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1973,01,01);
						model_life: 					45;
						vehicle_life: 					45;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							90 km/h;
						refit_cost: 					0;
						track_type: 					NGEL;
						power:  						2300 hp;
						weight: 						50 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.358;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							:switch_RhB_Ge_44II_build_year;
			additional_text					:string(STR_CONCAT_3, 
											 string(STR_GAUGE_NARROW), 
											 string(STR_TRACTION_ELECTRIC), 
											 string(STR_DESC_UNIVERSAL),);
			purchase_cargo_capacity		    :0 ;
			cargo_capacity	                :return 0 ;
			purchase						:switch_purchase_RhB_GE_44II;
			cost_factor						:38;
			running_cost_factor				:switch_running_cost_RhB_Ge_44II;			
			visual_effect_and_powered		:switch_FX_RhB_Ge_44II;	
			}
	}      

