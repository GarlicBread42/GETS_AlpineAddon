item (FEAT_TRAINS , ITEM_RHB_EW_II_BUILD, 5688)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_EW_II_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1975,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							90 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;					
						weight: 						15 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					17;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_RhB_EW_II_build;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_NARROW),
											  string(STR_DESC_PASS),);
			length							: switch_length_RhB_EW_II;
			articulated_part				: switch_articulated_RhB_EW_II_build;
			purchase						: switch_purchase_RhB_EW_II;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_RhB_EW_II;
			purchase_running_cost_factor	: 2650;
			}
		}


