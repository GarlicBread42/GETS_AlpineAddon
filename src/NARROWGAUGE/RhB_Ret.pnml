			WOOD: return switch_loadstack_RhB_Ret_Wood;
			GLAS: return switch_loadstack_RhB_Ret_Box;
			BRCK: return switch_loadstack_RhB_Ret_Box;
				switch_loadstack_RHb_Ret_load_bulk;}					 

switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_Ret, 1){
    return 290;}

switch(FEAT_TRAINS, SELF, switch_length_RhB_Ret, position_in_vehid_chain % 2) {
    0: 4;
    1: 6;}													

switch(FEAT_TRAINS, SELF, switch_graphics_RhB_Ret, position_in_vehid_chain % 2) {
    0:	   spriteset_empty;
    1:     return switch_RhB_Ret_cargo_type;}
    
switch (FEAT_TRAINS, SELF, switch_articulated_RhB_Ret, extra_callback_info1) {
    1: return ITEM_RHB_RET; 
        return CB_RESULT_NO_MORE_ARTICULATED_PARTS;} 

