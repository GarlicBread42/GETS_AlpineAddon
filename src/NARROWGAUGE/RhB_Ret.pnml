spriteset (spriteset_RhB_Ret_purchase, "gfx\RhB_Ret/RhB_Ret_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_RhB_Ret_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\RhB_Ret/RhB_Ret_1x_32bpp.png", "gfx\RhB_Ret/RhB_Ret_1x_mask.png")
					{template_purchase(0, 0)}	


//Switches

	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Barren, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Barren;}

	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Box;}	
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_ENSP, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_ENSP_1980;}	
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Farm, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Farm_1980;}	
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Draht, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Draht;}
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Pipe, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Pipe;}
								
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Profile, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Profile;}							
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Timber, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Timber;}						
		
	switch(FEAT_TRAINS, SELF, switch_loadstack_RhB_Ret_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_Ret;
		1: spritegroup_RhB_Ret_load_Wood;}		

	switch(FEAT_TRAINS, SELF, switch_loadstack_RHb_Ret_load_bulk, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return spriteset_RHb_Ret_base;
		1: spritegroup_RHb_Ret_load_bulk;
        2: spritegroup_RHb_Ret_load_bulk_loading;}
   
	switch(FEAT_TRAINS, SELF, switch_RhB_Ret_current_CC_Piece, hasbit(cargo_classes, CC_PIECE_GOODS)) {
			0: switch_loadstack_RhB_Ret_Box;
				switch_loadstack_RhB_Ret_Box;}		

	switch(FEAT_TRAINS, SELF, switch_RhB_Ret_current_CC_Bulk, hasbit(cargo_classes, CC_BULK)) {
		0: switch_RhB_Ret_current_CC_Piece;
			switch_loadstack_RHb_Ret_load_bulk;}

	switch(FEAT_TRAINS, SELF, switch_RhB_Ret_current_CC_Bulk_Covered, hasbit(cargo_classes, CC_COVERED & CC_BULK)) {
		0: switch_RhB_Ret_current_CC_Bulk;
			switch_loadstack_RHb_Ret_load_bulk;}			

	switch (FEAT_TRAINS, SELF, switch_RhB_Ret_cargo_type, cargo_type_in_veh) {
			ALUM: return switch_loadstack_RhB_Ret_Barren;
			STEL: return switch_loadstack_RhB_Ret_Profile;
			METL: return switch_loadstack_RhB_Ret_Barren;
			ZINC: return switch_loadstack_RhB_Ret_Profile;
			COPR: return switch_loadstack_RhB_Ret_Barren;
			STST: return switch_loadstack_RhB_Ret_Barren;
			STSH: return switch_loadstack_RhB_Ret_Barren;
			STSE: return switch_loadstack_RhB_Ret_Profile;
			STAL: return switch_loadstack_RhB_Ret_Barren;
			STCB: return switch_loadstack_RhB_Ret_Barren;
			STWR: return switch_loadstack_RhB_Ret_Draht; 
			CSTI: return switch_loadstack_RhB_Ret_Pipe;
			PIPE: return switch_loadstack_RhB_Ret_Pipe;

			ENSP: return switch_loadstack_RhB_Ret_ENSP;
			FMSP: return switch_loadstack_RhB_Ret_Farm;
			MNSP: return switch_loadstack_RhB_Ret_Box;
			POWR: return switch_loadstack_RhB_Ret_Box;
			VPTS: return switch_loadstack_RhB_Ret_Box;
			MPTS: return switch_loadstack_RhB_Ret_Box;
			GOOD: return switch_loadstack_RhB_Ret_Box;
			PAPR: return switch_loadstack_RhB_Ret_Box;
			TYRE: return switch_loadstack_RhB_Ret_Box;
			WOOL: return switch_loadstack_RhB_Ret_Box;
			TEXT: return switch_loadstack_RhB_Ret_Box;	
			SEED: return switch_loadstack_RhB_Ret_Box;	
			FERT: return switch_loadstack_RhB_Ret_Box;

			FRVG: return switch_loadstack_RHb_Ret_load_bulk;
			TATO: return switch_loadstack_RHb_Ret_load_bulk;
			FRUT: return switch_loadstack_RHb_Ret_load_bulk;
			CERE: return switch_loadstack_RHb_Ret_load_bulk;
			FICR: return switch_loadstack_RHb_Ret_load_bulk;
			OLSD: return switch_loadstack_RHb_Ret_load_bulk;
			QLME: return switch_loadstack_RHb_Ret_load_bulk;
			MNO2: return switch_loadstack_RHb_Ret_load_bulk;

			BDMT: return switch_loadstack_RhB_Ret_Timber;
