									{ template_98trains_1x(0, 0)}
	alternative_sprites (spriteset_SBB_HGe_44II_SBB_Bruenig, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_HGe_44II/SBB_HGe_44II_SBB_Bruenig_1x_32bpp.png", "gfx/SBB_HGe_44II/SBB_HGe_44II_SBB_Bruenig_1x_mask.png")
									{template_98trains_1x(0, 0)}
	alternative_sprites (spriteset_SBB_HGe_44II_SBB_Bruenig, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/SBB_HGe_44II/SBB_HGe_44II_SBB_Bruenig_2x_32bpp.png", "gfx/SBB_HGe_44II/SBB_HGe_44II_SBB_Bruenig_2x_mask.png")
									{template_98trains_2x(0, 0)}
	alternative_sprites (spriteset_SBB_HGe_44II_SBB_Bruenig, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/SBB_HGe_44II/SBB_HGe_44II_SBB_Bruenig_4x_32bpp.png", "gfx/SBB_HGe_44II/SBB_HGe_44II_SBB_Bruenig_4x_mask.png")
									{template_98trains_4x(0, 0)}	
									

