spritegroup spritegroup_RHb_Re-t_load_bulk_loading
		{loaded: 	[spriteset_empty];
			loading: 	[spriteset_RHb_Re-t_load_bulk_25, spriteset_RHb_Re-t_load_bulk_50, spriteset_RHb_Re-t_load_bulk_75, spriteset_RHb_Re-t_load_bulk_99];}	     

//Spritesets purchase
  
spriteset (spriteset_RHb_Re-t_purchase, "gfx\RHb_Re-t/RHb_Re-t_base_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_RHb_Re-t_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\RHb_Re-t/RHb_Re-t_base_1x_32bpp.png", "gfx\RHb_Re-t/RHb_Re-t_base_1x_mask.png")
					{template_purchase  (0, 0)}	

//Switches

	switch(FEAT_TRAINS, SELF, switch_loadstack_RHb_Re-t_load_bulk, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: return spriteset_RHb_Re-t_base;
		1: spritegroup_RHb_Re-t_load_bulk;
        2: spritegroup_RHb_Re-t_load_bulk_loading;}

	switch(FEAT_TRAINS, SELF, switch_RHb_Re-t_current_CC_Bulk, hasbit(cargo_classes, CC_BULK)) {
		0: spriteset_RHb_Re-t_base;
			switch_loadstack_RHb_Re-t_load_bulk;}        

	switch(FEAT_TRAINS, SELF, switch_length_RHb_Re-t, position_in_vehid_chain % 2) {
		0: 4;
		1: 6;}  

	switch(FEAT_TRAINS, SELF, switch_RHb_Re-t_graphics, position_in_articulated_veh % 2) {
		0:	   spriteset_empty;
		1:     return switch_RHb_Re-t_current_CC_Bulk;}

	switch (FEAT_TRAINS, SELF, switch_articulated_RHb_Re-t, extra_callback_info1) {
		1 .. 2: return ITEM_RHB_RE-T;
		return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
	
	switch(FEAT_TRAINS, SELF, switch_running_cost_RHb_Re-t, extra_callback_info1) {
		return 3000;}                  

item (FEAT_TRAINS , ITEM_RHB_RE-T, 8612)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_RE-T);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1955,01,01);
						model_life: 					51;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK, CC_COVERED, CC_PIECE_GOODS, CC_LIQUID);
						non_refittable_cargo_classes: 	bitmask(CC_REFRIGERATED, CC_HAZARDOUS, CC_OVERSIZED);
						cargo_allow_refit:              [WOOD, BDMT, WDPR, TWOD, FRUT ];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;						
						weight: 						11 ton;
						dual_headed: 					0;
						default_cargo_type:				COAL;
						cargo_capacity:					28;
						ai_engine_rank: 				0;
						length: 						6;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_Omm_55_cargo_type;
			additional_text					: string(STR_DESC_OMM_55);
			purchase						: spriteset_Omm_55_purchase;
			cost_factor						: 80;
			speed							: switch_speed_Omm_55;
			running_cost_factor				: switch_running_cost_Omm_55;
			colour_mapping					: switch_bulk_recolour;
			 }
		}	
                         