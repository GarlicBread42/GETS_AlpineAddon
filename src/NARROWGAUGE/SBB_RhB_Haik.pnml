//Spritesets

spriteset (spriteset_SBB_Rhb_Haik, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_1x_8bpp.png")
					{template_98trains_1x(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_1x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_1x_mask.png")
					{template_98trains_1x(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_2x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_2x_mask.png")
					{template_98trains_2x(0, 0)}					
		alternative_sprites (spriteset_SBB_Rhb_Haik, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_4x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_4x_mask.png")
						{template_98trains_4x(0, 0)}			

spriteset (spriteset_SBB_Rhb_Haik_loading, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_1x_8bpp.png")
						{template_98trains_1x(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_1x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_1x_mask.png")
						{template_98trains_1x(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_2x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_2x_mask.png")
					{template_98trains_2x(0,0)}				
		alternative_sprites (spriteset_SBB_Rhb_Haik_loading, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_4x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_4x_mask.png")
					{template_98trains_4x(0,0)}							

spriteset (spriteset_SBB_Rhb_Haik_loading_50, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_1x_8bpp.png")
						{template_98trains_1x(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik_loading_50, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_1x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_1x_mask.png")
						{template_98trains_1x(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik_loading_50, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_2x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_2x_mask.png")
					{template_98trains_2x(0,0)}				
		alternative_sprites (spriteset_SBB_Rhb_Haik_loading_50, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_4x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_loading_50_4x_mask.png")
					{template_98trains_4x(0,0)}
											
spritegroup spritegroup_SBB_Rhb_Haik_loading
		{loaded: 	[spriteset_empty];
		 loading: 	[spriteset_SBB_Rhb_Haik_loading, spriteset_SBB_Rhb_Haik_loading_50];}

//Spritesets purchase

spriteset (spriteset_SBB_Rhb_Haik_purchase, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_SBB_Rhb_Haik_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_1x_32bpp.png", "gfx\SBB_Rhb_Haik/SBB_Rhb_Haik_1x_mask.png")
					{template_purchase(0, 0)}

//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Rhb_Haik, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Rhb_Haik;
							1: spritegroup_SBB_Rhb_Haik_loading;}	
							
					switch(FEAT_TRAINS, SELF, switch_length_SBB_Rhb_Haik, position_in_vehid_chain % 3) {
							0: 3;
							1: 3;
							2: 3;}			
							
					switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Rhb_Haik, 1){
						return 170;}

					switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Rhb_Haik, position_in_vehid_chain % 3) {
						0:	   spriteset_empty;
						1:     switch_spritestack_SBB_Rhb_Haik;
						2: 	   spriteset_empty;}
																			
					switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Rhb_Haik, extra_callback_info1) {
						1 .. 2: return ITEM_SBB_RHB_HAIK;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
													
item (FEAT_TRAINS , ITEM_SBB_RHB_HAIK, 5750)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_RHB_HAIK);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1970,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PIECE_GOODS);
						cargo_allow_refit:              [MAIL,GOOD,VALU,PAPR,DIAM,BDMT,BEER,BOOM,BRCK,CERA,CERE,DYES,ENSP,FERT,FICR,FMSP,GLAS,JAVA,PLAS,TYRE,WDPR,WOOL,ZINC,ALUM,BAKE,CIGR,COAT,COBL,FURN,METL,MNSP,MPTS,NUTS,PCL_,PIPE,SEED,SESP,SOAP,STAL,STCB,STSE,STSH,STST,STWR,TATO,VENG,VPTS,BATT,BUBL,FZDR,TOYS,];
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						loading_speed:					7;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;						
						weight: 						14 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					17;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_SBB_Rhb_Haik;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_GAUGE_NARROW), 
											  string(STR_DESC_GOODS),);
			articulated_part			  	: switch_articulated_SBB_Rhb_Haik;
			length							: switch_length_SBB_Rhb_Haik;			
			purchase						: spriteset_SBB_Rhb_Haik_purchase;
			cost_factor						: 73;
			running_cost_factor				: switch_running_cost_SBB_Rhb_Haik;				
			
			 }
		}											
