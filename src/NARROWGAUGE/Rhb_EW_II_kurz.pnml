//Switches

    switch (FEAT_TRAINS,SELF,switch_purchase_RhB_EW_II_kurz,current_year) {
               0 .. 1982 : spriteset_RhB_EW_II_A_1978_kurz_Var1_purchase;
            1983 .. 1999 : spriteset_RhB_EW_II_A_1983_kurz_Var2_purchase;
            2000 .. 2003 : spriteset_RhB_EW_II_A_2000_kurz_Var1_purchase;
            2004 .. 2005 : spriteset_RhB_EW_II_A_2004_kurz_Var3_purchase;
            2006 .. 2050 : spriteset_RhB_EW_II_A_2006_kurz_Var2_purchase;
                spriteset_RhB_EW_II_A_2006_kurz_Var2_purchase;} 

	switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_EW_II_A_1978_kurz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_EW_II_A_1978_kurz_Var1;
		1: spritegroup_RhB_EW_II_A_1978_kurz_loading;}	  

	switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_EW_II_A_1983_kurz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_EW_II_A_1983_kurz_Var2;
		1: spritegroup_RhB_EW_II_A_1983_kurz_Var2_loading;}	

	switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_EW_II_A_2000_kurz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_EW_II_A_2000_kurz_Var1;
		1: spritegroup_RhB_EW_II_A_2000_kurz_Var1_loading;}	

	switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_EW_II_A_2004_kurz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_EW_II_A_2004_kurz_Var3;
		1: spritegroup_RhB_EW_II_A_2004_kurz_Var3_loading;}	 

	switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_EW_II_A_2006_kurz, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
		0: spriteset_RhB_EW_II_A_2006_kurz_Var2;
		1: spritegroup_RhB_EW_II_A_2006_kurz_Var2_loading;}	 

	switch(FEAT_TRAINS, SELF, switch_length_RhB_EW_II_kurz, position_in_articulated_veh % 3) {
		0: 3;
		1: 3;
		2: 3;}	

	switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_EW_II_kurz, 1){
		return 725;}

    switch (FEAT_TRAINS,SELF,switch_build_year_RhB_EW_II_kurz,build_year) {
               0 .. 1982 : switch_spritestack_RhB_EW_II_A_1978_kurz;
            1983 .. 1999 : switch_spritestack_RhB_EW_II_A_1983_kurz;
            2000 .. 2003 : switch_spritestack_RhB_EW_II_A_2000_kurz;
            2004 .. 2005 : switch_spritestack_RhB_EW_II_A_2004_kurz;
            2006 .. 2050 : switch_spritestack_RhB_EW_II_A_2006_kurz;
                switch_spritestack_RhB_EW_II_A_2006_kurz;}        								   

	switch(FEAT_TRAINS, SELF, switch_graphics_RhB_EW_II_kurz_build, position_in_articulated_veh  % 3) {
		0:     spriteset_empty;
		1:     return switch_build_year_RhB_EW_II_kurz;
		2:     spriteset_empty;}

	switch (FEAT_TRAINS, SELF, switch_articulated_RhB_EW_II_kurz_build, extra_callback_info1) {
		1 .. 2: return ITEM_RHB_EW_II_KURZ_BUILD;												
			return CB_RESULT_NO_MORE_ARTICULATED_PARTS;} 
																						
item (FEAT_TRAINS , ITEM_RHB_EW_II_KURZ_BUILD, 5695)
