//#####################
//### RhB Ge 4/4 II ###
//#####################

spriteset(spriteset_RhB_Ge_44III_1993, "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_1x_8bpp.png")
									{ template_108trains_1x(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_1993, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_1x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_1x_mask.png")
									{template_108trains_1x(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_1993, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_2x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_2x_mask.png")
									{template_108trains_2x(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_1993, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_4x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_4x_mask.png")
									{template_108trains_4x(0, 0)}	



spriteset(spriteset_RhB_Ge_44III_2016, "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_1x_8bpp.png")
									{ template_108trains_1x(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_2016, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_1x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_1x_mask.png")
									{template_108trains_1x(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_2016, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_2x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_2x_mask.png")
									{template_108trains_2x(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_2016, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_4x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_4x_mask.png")
									{template_108trains_4x(0, 0)}
									

//Spritesets purchase                                                                                                                                            

spriteset(spriteset_RhB_Ge_44III_1993_purchase, "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_1x_8bpp.png")
									{template_purchase(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_1993_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_1x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_1993_1x_mask.png")
									{template_purchase(0, 0)}

spriteset(spriteset_RhB_Ge_44III_2016_purchase, "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_1x_8bpp.png")
									{template_purchase(0, 0)}
	alternative_sprites (spriteset_RhB_Ge_44III_2016_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_1x_32bpp.png", "gfx/RhB_Ge_44III/RhB_Ge_44III_2016_1x_mask.png")
									{template_purchase(0, 0)}

//Switches

    switch(FEAT_TRAINS,SELF, switch_purchase_RhB_GE_44III, current_year){
           0 .. 2015: spriteset_RhB_Ge_44III_1993_purchase;
        2016 .. 2050: spriteset_RhB_Ge_44III_2016_purchase;
            spriteset_RhB_Ge_44III_2016_purchase;}	

    switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_Ge_44III, 1){
        return 730;}  

    switch(FEAT_TRAINS, SELF, switch_length_RhB_Ge_44III, position_in_vehid_chain % 2) {
        0: 4;
        1: 6;}         

    switch(FEAT_TRAINS, SELF, switch_FX_RhB_Ge_44III, position_in_vehid_chain % 3) {
        0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
        return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	        

    switch (FEAT_TRAINS,SELF, switch_RhB_Ge_44III_build_year,build_year){
           0 .. 2015: spriteset_RhB_Ge_44III_1993;						   
        2016 .. 2050: spriteset_RhB_Ge_44III_2016;
            spriteset_RhB_Ge_44III_2016;}

    switch (FEAT_TRAINS,SELF, switch_RhB_Ge_44III_current_year,current_year){
           0 .. 2015: spriteset_RhB_Ge_44III_1993;						   
        2016 .. 2050: spriteset_RhB_Ge_44III_2016;
            spriteset_RhB_Ge_44III_2016;}

    switch(FEAT_TRAINS, SELF, switch_RhB_Ge_44III_graphics_build, position_in_vehid_chain % 2) {
        0:	   spriteset_empty;
        1:     return switch_RhB_Ge_44III_build_year;}
        
    switch (FEAT_TRAINS, SELF, switch_articulated_RhB_Ge_44III_build, extra_callback_info1) {
        1: return ITEM_RHB_GE_44III_BUILD; 
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


item (FEAT_TRAINS , ITEM_RHB_GE_44III_BUILD, 5020)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_GE_44III_BUILD);					
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1993,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					NGEL;
						power:  						3264 hp;
						weight: 						62 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.323;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							:switch_RhB_Ge_44III_graphics_build;
			additional_text					:string(STR_CONCAT_3, 
											 string(STR_GAUGE_NARROW), 
											 string(STR_TRACTION_ELECTRIC), 
											 string(STR_DESC_UNIVERSAL),);
			length							:switch_length_RhB_Ge_44III;
			articulated_part				:switch_articulated_RhB_Ge_44III_build;                                             
			purchase_cargo_capacity		    :0 ;
			cargo_capacity	                :return 0 ;
			purchase						:switch_purchase_RhB_GE_44III;
			cost_factor						:38;
			running_cost_factor				:switch_running_cost_RhB_Ge_44III;			
			visual_effect_and_powered		:switch_FX_RhB_Ge_44III;	
			}
	}      

    switch(FEAT_TRAINS, SELF, switch_RhB_Ge_44III_graphics_current, position_in_vehid_chain % 2) {
        0:	   spriteset_empty;
        1:     return switch_RhB_Ge_44III_current_year;}
        
    switch (FEAT_TRAINS, SELF, switch_articulated_RhB_Ge_44III_current, extra_callback_info1) {
        1: return ITEM_RHB_GE_44III_CURRENT; 
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


