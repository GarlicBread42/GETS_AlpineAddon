			visual_effect_and_powered		:switch_FX_RhB_Ge_44III;	
			}
	}     

    switch(FEAT_TRAINS, SELF, switch_RhB_Ge_44III_graphics_1993, position_in_vehid_chain % 2) {
        0:	   spriteset_empty;
        1:     return spriteset_RhB_Ge_44III_1993;}
        
    switch (FEAT_TRAINS, SELF, switch_articulated_RhB_Ge_44III_1993, extra_callback_info1) {
        1: return ITEM_RHB_GE_44III_1993; 
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}


