					{template_purchase(0, 0)}					
					
//Switches

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base_purchase;
        1: spriteset_RhB_Fac_RhB_870x_purchase;
        2: spriteset_RhB_Fac_RhB_xxx1_purchase;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_brown_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_brown_purchase;
        1: spriteset_RhB_Fac_RhB_870x_purchase;
        2: spriteset_RhB_Fac_RhB_xxx1_purchase;}

    switch (FEAT_TRAINS,SELF, switch_RhB_Fac_purchase,current_year){
           0 .. 1999: switch_spritestack_RhB_Fac_brown_purchase;
        2000 .. 2050: switch_spritestack_RhB_Fac_base_purchase;				 					 
        switch_spritestack_RhB_Fac_base_purchase;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit1_uneven, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_871x;
        2: spriteset_RhB_Fac_RhB_873x;
        3: spriteset_RhB_Fac_RhB_875x;
        4: spriteset_RhB_Fac_RhB_877x;
        5: spriteset_RhB_Fac_RhB_871x;
        6: spriteset_RhB_Fac_RhB_873x;
        7: spriteset_RhB_Fac_RhB_875x;
            spriteset_RhB_Fac_RhB_877x;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit1_even, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_870x;
        2: spriteset_RhB_Fac_RhB_872x;
        3: spriteset_RhB_Fac_RhB_874x;
        4: spriteset_RhB_Fac_RhB_876x;
        5: spriteset_RhB_Fac_RhB_870x;
        6: spriteset_RhB_Fac_RhB_872x;
        7: spriteset_RhB_Fac_RhB_874x;
            spriteset_RhB_Fac_RhB_876x;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit2_uneven, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_xxx1;
        2: spriteset_RhB_Fac_RhB_xxx3;
        3: spriteset_RhB_Fac_RhB_xxx5;
        4: spriteset_RhB_Fac_RhB_xxx7;
        5: spriteset_RhB_Fac_RhB_xxx9;
        6: spriteset_RhB_Fac_RhB_xxx7;
        7: spriteset_RhB_Fac_RhB_xxx5;
            spriteset_RhB_Fac_RhB_xxx3;}            

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit2_even, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_xxx2;
        2: spriteset_RhB_Fac_RhB_xxx4;
        3: spriteset_RhB_Fac_RhB_xxx6;
        4: spriteset_RhB_Fac_RhB_xxx8;
        5: spriteset_RhB_Fac_RhB_xxx6;
        6: spriteset_RhB_Fac_RhB_xxx4;
        7: spriteset_RhB_Fac_RhB_xxx2;
            spriteset_RhB_Fac_RhB_xxx6;}              

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_uneven;
        2: return random_choose_RhB_Fac_numbers_digit2_uneven;
        3: spritegroup_RhB_Fac_load;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_uneven;
        2: return random_choose_RhB_Fac_numbers_digit2_even;
        3: spritegroup_RhB_Fac_load;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_even;
        2: return random_choose_RhB_Fac_numbers_digit2_uneven;
        3: spritegroup_RhB_Fac_load;}              

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_even;
