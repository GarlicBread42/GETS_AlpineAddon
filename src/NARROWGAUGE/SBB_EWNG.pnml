			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_SBB_EWNG_BD_Bruenig;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_NARROW),
											  string(STR_DESC_HALFBAGG),);										  
			length							: switch_length_SBB_EWNG;
			articulated_part				: switch_articulated_SBB_EWNG_BD_Bruenig;
