			}
		}

	switch(FEAT_TRAINS, SELF, switch_graphics_SBB_EWNG_PAN_Bruenig, position_in_articulated_veh  % 3) {
		0:     spriteset_empty;
		1:     return switch_spritestack_SBB_EWNG_PAN_Bruenig;
		2:     spriteset_empty;}


	switch (FEAT_TRAINS, SELF, switch_articulated_SBB_EWNG_PAN_Bruenig, extra_callback_info1) {
		1 .. 2: return ITEM_SBB_EWNG_PAN_BRUENIG;								
			return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
