//Switches

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Uac, switch_alternative_var_random_bits(3, 3)) {
        1: spriteset_RhB_Uac_RhB_grey_7937;
        2: spriteset_RhB_Uac_RhB_grey_7938;
        3: spriteset_RhB_Uac_RhB_grey_7939;
        4: spriteset_RhB_Uac_RhB_grey_7993;
        5: spriteset_RhB_Uac_RhB_grey_7997;
        6: spriteset_RhB_Uac_RhB_grey_7998;
        7: spriteset_RhB_Uac_RhB_grey_7999;
            spriteset_RhB_Uac_RhB_grey_7988;}

    switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_Uac, 1){
        return 175;}   

item (FEAT_TRAINS , ITEM_RHB_UAC, 5990)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_UAC);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1991,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_POWDERIZED );
						cargo_allow_refit:              [CBLK, CMNT, CLAY, QLME, SASH, SULP];
						cargo_disallow_refit: 			[ALUM];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;							
						weight: 						17 ton;
						dual_headed: 					0;
						default_cargo_type:				IORE;
						cargo_capacity:					34;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: random_choose_RhB_Uac;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_GAUGE_NARROW), 
											  string(STR_DESC_GOODS),);
			purchase						: spriteset_RhB_Uac_purchase;
			cost_factor						: 75;
			running_cost_factor				: switch_running_cost_RhB_Uac;				
			colour_mapping					: switch_generic_recolour;
			 }
		}                 
