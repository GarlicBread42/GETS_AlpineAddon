//Switches

    switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1014_purchase,build_year){
            0 .. 2006: spriteset_OBB_Rh_1014_rotweiss_purchase;
        2007 .. 2050: spriteset_OBB_Rh_1014_Wort_purchase;
            spriteset_OBB_Rh_1014_Wort_purchase;} 

    switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_1014_rotweiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_OBB_Rh_1014_rotweiss;
        1: spriteset_OBB_Rh_1014_lights_front;
        2: spriteset_OBB_Rh_1014_lights_back;}   

    switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_1014_Wort, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_OBB_Rh_1014_Wort;
        1: spriteset_OBB_Rh_1014_lights_front;
        2: spriteset_OBB_Rh_1014_lights_back;}       

    switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_1014_RCA, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_OBB_Rh_1014_RCA;
        1: spriteset_OBB_Rh_1014_lights_front;
        2: spriteset_OBB_Rh_1014_lights_back;}           

    switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_1014_CAT, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_OBB_Rh_1014_CAT;
        1: spriteset_OBB_Rh_1014_lights_front;
        2: spriteset_OBB_Rh_1014_lights_back;}    

    switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_1014_ZTT, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_OBB_Rh_1014_ZTT;
        1: spriteset_OBB_Rh_1014_lights_front;
        2: spriteset_OBB_Rh_1014_lights_back;} 

    switch(FEAT_TRAINS, SELF, switch_cargo_dependant_OBB_Rh_1014_rotweiss, most_common_cargo_type){
        PASS: switch_spritestack_OBB_Rh_1014_rotweiss;
        MAIL: switch_spritestack_OBB_Rh_1014_rotweiss;
            switch_spritestack_OBB_Rh_1014_RCA;} 

    switch(FEAT_TRAINS, SELF, switch_cargo_dependant_OBB_Rh_1014_Wort, most_common_cargo_type){
        PASS: switch_spritestack_OBB_Rh_1014_Wort;
        MAIL: switch_spritestack_OBB_Rh_1014_Wort;
            switch_spritestack_OBB_Rh_1014_RCA;} 

    switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1014_build_year,build_year){
           0 .. 1996: switch_spritestack_OBB_Rh_1014_rotweiss;
        1997 .. 2006: switch_cargo_dependant_OBB_Rh_1014_rotweiss;
        2007 .. 2050: switch_cargo_dependant_OBB_Rh_1014_Wort;					 					 
            switch_cargo_dependant_OBB_Rh_1014_Wort;}							

    switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1014_current_year,current_year){
           0 .. 1996: switch_spritestack_OBB_Rh_1014_rotweiss;
        1997 .. 2006: switch_cargo_dependant_OBB_Rh_1014_rotweiss;
        2007 .. 2050: switch_cargo_dependant_OBB_Rh_1014_Wort;					 					 
            switch_cargo_dependant_OBB_Rh_1014_Wort;}

    switch(FEAT_TRAINS, SELF, switch_length_OBB_Rh_1014, position_in_vehid_chain % 3) {
        0: 4;
        1: 4;
        2: 4;}
    
    switch(FEAT_TRAINS, SELF, switch_FX_OBB_Rh_1014, position_in_vehid_chain % 3) {
        0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
            return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}						

    switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_Rh_1014, 1){
        return 2625;}

    switch(FEAT_TRAINS, SELF, switch_OBB_Rh_1014_graphics_build, position_in_vehid_chain % 3) {
        0:	   spriteset_empty;
        1:     return switch_OBB_Rh_1014_build_year;
        2:	   spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Rh_1014_build, extra_callback_info1) {
        1 .. 2: return ITEM_OBB_RH_1014_BUILD; 				
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}       

item (FEAT_TRAINS , ITEM_OBB_RH_1014_BUILD, 1021)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_RH_1014_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);							
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1993,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							175 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						4078 hp;
						weight: 						74 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.375;
						length: 						8;												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_OBB_Rh_1014_graphics_build;
			additional_text					: string(STR_CONCAT_3, 
                                              string(STR_GAUGE_STANDARD), 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_UNIVERSAL),);
			length							: switch_length_OBB_Rh_1014;
			articulated_part				: switch_articulated_OBB_Rh_1014_build;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: switch_OBB_Rh_1014_purchase;
			cost_factor						: 151;
			running_cost_factor				: switch_running_cost_OBB_Rh_1014;
			visual_effect_and_powered		: switch_FX_OBB_Rh_1014;
			}
	}	                                   


   switch(FEAT_TRAINS, SELF, switch_OBB_Rh_1014_graphics_current, position_in_vehid_chain % 3) {
        0:	   spriteset_empty;
        1:     return switch_OBB_Rh_1014_current_year;
        2:	   spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Rh_1014_current, extra_callback_info1) {
        1 .. 2: return ITEM_OBB_RH_1014_CURRENT; 				
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}       

