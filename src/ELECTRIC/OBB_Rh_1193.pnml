//Spritesets purchase    

spriteset(spriteset_OBB_Rh_1193_WLC2_purchase, "gfx/OBB_Rh_1193/OBB_Rh_1193_WLC2_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_OBB_Rh_1193_WLC2_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_Rh_1193/OBB_Rh_1193_WLC2_1x_32bpp.png", "gfx/OBB_Rh_1193/OBB_Rh_1193_WLC2_1x_mask.png")
									{ template_purchase(0, 0)}

//Switches

						switch(FEAT_TRAINS, SELF, switch_length_OBB_Rh_1193, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_Rh_1193, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_Rh_1193, 1){
							return 4625;}


						switch (FEAT_TRAINS, SELF, random_choose_OBB_Rh_1193_WLC, switch_alternative_var_random_bits(1, 2)) {
							1: spriteset_OBB_Rh_1193_WLC1;
							2: spriteset_OBB_Rh_1193_WLC2;
							3: spriteset_OBB_Rh_1193_WLC3;
							spriteset_OBB_Rh_1193_WLC2;}

						switch(FEAT_TRAINS, SELF, switch_graphics_OBB_Rh_1193_WLC, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return random_choose_OBB_Rh_1193_WLC;
							2:	   spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Rh_1193_WLC, extra_callback_info1) {
							1 .. 2: return ITEM_OBB_RH_1193_WLC;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
														
item (FEAT_TRAINS , ITEM_OBB_RH_1193_WLC, 1414)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_RH_1193_WLC);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2010,01,01);
						model_life:						VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					30;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					ELEC;
						power:  						8704 hp;
						weight: 						87 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.345;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_OBB_Rh_1193_WLC;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_TRACTION_ELECTRIC), 
											  string(STR_DESC_UNIVERSAL),);
			length							: switch_length_OBB_Rh_1193;
			articulated_part				: switch_articulated_OBB_Rh_1193_WLC;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_OBB_Rh_1193_WLC2_purchase;
			cost_factor						: 314;
			running_cost_factor				: switch_running_cost_OBB_Rh_1193;
			visual_effect_and_powered		: switch_FX_OBB_Rh_1193;
			}
	}                            