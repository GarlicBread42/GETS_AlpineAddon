									{ template_128trains_1x(0, 0)}
		alternative_sprites (spriteset_OBB_Rh_1193_WLC3, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_Rh_1193/OBB_Rh_1193_WLC3_1x_32bpp.png", "gfx/OBB_Rh_1193/OBB_Rh_1193_WLC3_1x_mask.png")
