						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_B1_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_B1_rot;
							1: spritegroup_OBB_Eurofima_loading_rot;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_B2_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_B2_rot;
							1: spritegroup_OBB_Eurofima_loading_rot;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_A1_grau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_A1_grau;
							1: spritegroup_OBB_Eurofima_loading_grau;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_A2_grau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
