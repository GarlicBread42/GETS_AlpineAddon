						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIc_KFNB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIc_KFNB_purchase;
							1: spriteset_OBB_KFNB_IIc_anim_purchase;}
	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIc_kkstb_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIc_kkstb_purchase;
							1: spriteset_OBB_KFNB_IIc_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIc_purchase,current_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_IIc_KFNB_purchase;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IIc_kkstb_purchase;					 					 
								switch_spritestack_OBB_KFNB_IIc_kkstb_purchase;}																				

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_IIc, motion_counter % 4) {
							0: spriteset_OBB_KFNB_IIc_anim1;
							1: spriteset_OBB_KFNB_IIc_anim2;
							2: spriteset_OBB_KFNB_IIc_anim3;
							3: spriteset_OBB_KFNB_IIc_anim4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIc_KFNB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIc_KFNB;
							1: return switch_animation_OBB_KFNB_IIc;}			
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIc_kkstb, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIc_kkstb;
							1: return switch_animation_OBB_KFNB_IIc;}																											
							
						switch(FEAT_TRAINS, SELF, switch_length_OBB_KFNB_IIc, position_in_articulated_veh % 2) {
							0: 6;
							1: 4;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_IIc, 1){
							return 270;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_IIc, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIc_Loco_build_year,build_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_IIc_KFNB;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IIc_kkstb;					 					 
								switch_spritestack_OBB_KFNB_IIc_kkstb;}	
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIc_Tender_build_year,build_year){
							    0 .. 1908: spriteset_OBB_KFNB_IXa_Tender_KFNB;	
							 1909 .. 2050: spriteset_OBB_KFNB_IXa_Tender_kkstb;					 					 
								spriteset_OBB_KFNB_IXa_Tender_kkstb;}																					   
							   
					switch(FEAT_TRAINS, SELF, switch_graphics_OBB_KFNB_IIc_build, position_in_vehid_chain % 2) {
							0:	   return switch_OBB_KFNB_IIc_Loco_build_year;
							1:     return switch_OBB_KFNB_IIc_Tender_build_year;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_KFNB_IIc_build, extra_callback_info1) {
							1: return ITEM_OBB_KFNB_IIC_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

