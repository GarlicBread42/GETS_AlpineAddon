											  string(STR_GAUGE_NARROW),
											  string(STR_DESC_PASS),);
			length							: switch_length_RhB_EW_II;
			articulated_part				: switch_articulated_RhB_EW_II_2004_Var2;
			purchase						: spriteset_RhB_EW_II_B_2004_Var2_purchase;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_RhB_EW_II;
			purchase_running_cost_factor	: 2650;
			}
		}		


	switch(FEAT_TRAINS, SELF, switch_graphics_RhB_EW_II_2004_Var3, position_in_articulated_veh  % 3) {
		0:     spriteset_empty;
		1:     return random_choose_RhB_EW_II_2004_Var3;
		2:     spriteset_empty;}

	switch (FEAT_TRAINS, SELF, switch_articulated_RhB_EW_II_2004_Var3, extra_callback_info1) {
		1 .. 2: return ITEM_RHB_EW_II_2004_VAR3;												
			return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
item (FEAT_TRAINS , ITEM_RHB_EW_II_2004_VAR3, 5694)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_EW_II_2004_VAR3);
						variant_group:					5688;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2004,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							90 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;					
						weight: 						15 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					17;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_RhB_EW_II_2004_Var3;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_NARROW),
											  string(STR_DESC_PASS),);
			length							: switch_length_RhB_EW_II;
			articulated_part				: switch_articulated_RhB_EW_II_2004_Var3;
			purchase						: spriteset_RhB_EW_II_B_2004_Var3_purchase;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_RhB_EW_II;
			purchase_running_cost_factor	: 2650;
			}
		}						
