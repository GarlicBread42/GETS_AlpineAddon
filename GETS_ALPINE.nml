						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RBe_540_Serie_Kolibri_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 5 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_RBe_540_base_back;
							1: spriteset_SBB_RBe_540_Serie_Kolibri_back;
							2: spritegroup_SBB_RBe_540_loading_Kolibri;
							3: switch_spritechoose_SBB_RBe_540_plug_Kolibri_front;
							4: switch_spritechoose_SBB_RBe_540_lights_back_Kolibri;
							5: switch_spritechoose_SBB_RBe_540_lights_front_Kolibri;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RBe_540_Serie_Kolibri_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 5 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_RBe_540_base_front;
