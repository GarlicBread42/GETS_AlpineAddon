	alternative_sprites (spriteset_SZU_DPZ_neu_weiss_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SZU_DPZ/SZU_DPZ_neu_weiss_1x_32bpp.png", "gfx/SZU_DPZ/SZU_DPZ_neu_weiss_1x_mask.png")
									{template_purchase(0, 0)}
									
//Switches
						
						switch (FEAT_TRAINS,SELF, switch_purchase_SZU_DPZ,current_year){
							   0 .. 2010: spriteset_SZU_DPZ_rot_purchase;
							2011 .. 2015: spriteset_SZU_DPZ_neu_rot_purchase;
							2016 .. 2050: spriteset_SZU_DPZ_neu_weiss_purchase;															 					 
								spriteset_SZU_DPZ_neu_weiss_purchase;}	
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_DPZ_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_DPZ_rot;
							1: spritegroup_SZU_DPZ_rot_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_DPZ_weiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_DPZ_weiss;
							1: spritegroup_SZU_DPZ_weiss_loading;}																		

						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_DPZ_neu_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_DPZ_neu_rot;
							1: spritegroup_SZU_DPZ_neu_rot_loading;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_DPZ_neu_weiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_DPZ_neu_weiss;
							1: spritegroup_SZU_DPZ_neu_weiss_loading;}							
							   
						switch (FEAT_TRAINS, SELF, random_choose_SZU_DPZ_2011, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SZU_DPZ_neu_rot;
							2: switch_loadstack_SZU_DPZ_rot;
							3: switch_loadstack_SZU_DPZ_rot;
							   switch_loadstack_SZU_DPZ_rot;}			
							   
						switch (FEAT_TRAINS, SELF, random_choose_SZU_DPZ_2016, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SZU_DPZ_neu_weiss;
							2: switch_loadstack_SZU_DPZ_weiss;
							3: switch_loadstack_SZU_DPZ_weiss;
							   switch_loadstack_SZU_DPZ_weiss;}								   						   	
							   
						switch(FEAT_TRAINS, SELF, switch_length_SZU_DPZ, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SZU_DPZ, 1){
							return 3100;}									
								
						switch (FEAT_TRAINS,SELF, switch_build_year_SZU_DPZ,build_year){
							   0 .. 2010: switch_loadstack_SZU_DPZ_rot;
							2011 .. 2015: random_choose_SZU_DPZ_2011;
							2016 .. 2050: random_choose_SZU_DPZ_2016;															 					 
								random_choose_SZU_DPZ_2016;}
							
						switch(FEAT_TRAINS, SELF, switch_graphics_SZU_DPZ_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_SZU_DPZ;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SZU_DPZ_build, extra_callback_info1) {
							1 .. 2: return ITEM_SZU_DPZ_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
item (FEAT_TRAINS , ITEM_SZU_DPZ_BUILD, 6994)
		{
