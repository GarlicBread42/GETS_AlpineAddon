//Switches

    switch (FEAT_TRAINS,SELF, switch_BLS_Bt_EW1_purchase,build_year){
            0 .. 1968: spriteset_BLS_Bt_EW1_gruen_purchase;
        1969 .. 1979: spriteset_BLS_Bt_EW1_blau1_purchase;
        1980 .. 1998: spriteset_BLS_Bt_EW1_blau2_purchase;
        1999 .. 2005: spriteset_BLS_Bt_EW1_LB_purchase;
        2006 .. 2050: spriteset_BLS_Bt_EW1_Zebra_purchase;
            spriteset_BLS_Bt_EW1_Zebra_purchase;}     

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Bt_EW1_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_Bt_EW1_gruen;
        1: spritegroup_BLS_Bt_EW1_gruen_loading;
        2: spriteset_BLS_Bt_EW1_lights_back;}                                                                                                                                                                                         

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Bt_EW1_blau1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_Bt_EW1_blau1;
        1: spritegroup_BLS_Bt_EW1_gruen_loading;
        2: spriteset_BLS_Bt_EW1_lights_back;}    

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Bt_EW1_blau2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_Bt_EW1_blau2;
        1: spritegroup_BLS_Bt_EW1_gruen_loading;
        2: spriteset_BLS_Bt_EW1_lights_back;}    

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Bt_EW1_LB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_Bt_EW1_LB;
        1: spritegroup_BLS_Bt_EW1_LB_loading;
        2: spriteset_BLS_Bt_EW1_lights_back;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Bt_EW1_Zebra, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_BLS_Bt_EW1_Zebra;
        1: spritegroup_BLS_Bt_EW1_Zebra_loading;
        2: spriteset_BLS_Bt_EW1_lights_back;}      

    switch(FEAT_TRAINS, SELF, switch_length_BLS_Bt_EW1, position_in_articulated_veh % 3) {
        0: 4;
        1: 6;
        2: 4;}	    

    switch (FEAT_TRAINS, PARENT, switch_running_cost_BLS_Bt_EW1,  switch_check_Restaurant_0()) {
        1: return 0;
        0: return 1600;}	
        
    switch (FEAT_TRAINS, PARENT, switch_cargo_aging_BLS_Bt_EW1,  switch_check_Restaurant_0()) {
        1: return 233;
        0: return 185;}	          

    switch (FEAT_TRAINS,SELF, switch_BLS_Bt_EW1_build_year,build_year){
            0 .. 1968: switch_spritestack_BLS_Bt_EW1_gruen;
        1969 .. 1979: switch_spritestack_BLS_Bt_EW1_blau1;
        1980 .. 1998: switch_spritestack_BLS_Bt_EW1_blau2;
        1999 .. 2005: switch_spritestack_BLS_Bt_EW1_LB;
        2006 .. 2050: switch_spritestack_BLS_Bt_EW1_Zebra;
            switch_spritestack_BLS_Bt_EW1_Zebra;}     

    switch (FEAT_TRAINS,SELF, switch_BLS_Bt_EW1_current_year,current_year){
            0 .. 1968: switch_spritestack_BLS_Bt_EW1_gruen;
        1969 .. 1979: switch_spritestack_BLS_Bt_EW1_blau1;
        1980 .. 1998: switch_spritestack_BLS_Bt_EW1_blau2;
        1999 .. 2005: switch_spritestack_BLS_Bt_EW1_LB;
        2006 .. 2050: switch_spritestack_BLS_Bt_EW1_Zebra;
            switch_spritestack_BLS_Bt_EW1_Zebra;}  

    switch(FEAT_TRAINS, SELF, switch_graphics_BLS_Bt_EW1_build, position_in_articulated_veh  % 3) {
        0:     spriteset_empty;
        1:     return switch_BLS_Bt_EW1_build_year;
        2:     spriteset_empty;}

    switch (FEAT_TRAINS, SELF, switch_articulated_BLS_Bt_EW1_build, extra_callback_info1) {
        1 .. 2: return ITEM_BLS_BT_EW1_BUILD;												
            return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}	

item (FEAT_TRAINS , ITEM_BLS_BT_EW1_BUILD, 7935)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_BT_EW1_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1961,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						34 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					24;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_BLS_Bt_EW1_build;
			additional_text					: string(STR_CONCAT_3,
											  string(STR_GAUGE_STANDARD),                                                                                          
											  string(STR_DESC_EXPRESS),
                                              string(STR_DESC_DVT),);
			length							: switch_length_BLS_Bt_EW1;
			articulated_part				: switch_articulated_BLS_Bt_EW1_build;
			purchase						: switch_BLS_Bt_EW1_purchase;
			cost_factor						: 500;
			running_cost_factor				: switch_running_cost_BLS_Bt_EW1;
			purchase_running_cost_factor	: 1600;
			cargo_age_period				: switch_cargo_aging_BLS_Bt_EW1;	
