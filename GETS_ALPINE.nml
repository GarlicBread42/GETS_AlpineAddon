			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_SOB_Revvivo_DVT;
			additional_text					: string(STR_DESC_PASS);
			length							: switch_length_SOB_Revvivo_Coach;
			articulated_part				: switch_articulated_SOB_Revvivo_DVT;
