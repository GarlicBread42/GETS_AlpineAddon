								switch_spritestack_SBB_Am_842_2_Vossloh_REV;}										
																							
						switch (FEAT_TRAINS, SELF, random_choose_Am_842_2_SBBC, switch_alternative_var_random_bits(1, 1)) {
							1: switch_reverse_SBB_Am_842_2_SBBC1;
