							1 .. 2: return ITEM_SAADKMS_CURRENT;
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}																																																																												

							
item (FEAT_TRAINS , ITEM_SAADKMS_CURRENT, 8950)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SAADKMS_CURRENT);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1986,01,01);
						model_life: 					50;
						vehicle_life: 					50;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						cargo_allow_refit:              [];
						cargo_disallow_refit: 			[];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							120 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						20 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					14;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_Saadkms_current;
			additional_text					: string(STR_DESC_GOODS);
			articulated_part			  	: switch_articulated_Saadkms_current;
			length							: switch_length_Saadkms;
			purchase						: switch_purchase_Saadkms;
			cost_factor						: 195;
			running_cost_factor				: switch_running_cost_Saadkms;
			colour_mapping					: switch_generic_recolour;
			 }
		}										


