								spriteset_SZU_PENDEL_weiss_purchase;}	

						switch (FEAT_TRAINS,SELF, switch_purchase_SZU_PENDEL_DVT,current_year){
							   0 .. 1992: spriteset_SZU_PENDEL_DVT_orange_purchase;
							1993 .. 2013: spriteset_SZU_PENDEL_DVT_rot_purchase;
