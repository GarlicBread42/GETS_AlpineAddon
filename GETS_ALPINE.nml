					switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Bm_596_Thurbo, position_in_vehid_chain % 5) {
							0:	   spriteset_empty;
							1:     switch_reverse_SBB_Bm_596_front_Thurbo;
							2:     switch_reverse_SBB_Bm_596_middle_MTHB;
							3:	   spriteset_empty;
							4:     switch_reverse_SBB_Bm_596_back_Thurbo;}	
							
					switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Bm_596_Thurbo, extra_callback_info1) {
						1 .. 4: return ITEM_SBB_BM_596_THURBO; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

