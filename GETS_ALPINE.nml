//Checks for gfx														
//Checks for De 4/4 Seetal livery (ID 4976)
								
						switch (FEAT_TRAINS,PARENT,switch_7822_graphics_check_6565_2,(count_veh_id(6565))) {
							0: random_loadstack_SBB_Seetal_DVT_yellow; 
								switch_reverse_SBB_Seetal_DVT_yellow_4976;}								

						switch (FEAT_TRAINS,PARENT,switch_7822_graphics_check_4976,(count_veh_id(4976))) {
							0: random_loadstack_SBB_Seetal_DVT_yellow;
							 switch_7822_graphics_check_6565_2;}


						switch (FEAT_TRAINS,PARENT,switch_7822_graphics_check_4976_7822,(count_veh_id(4976)+count_veh_id(6565) +count_veh_id(7822)==num_vehs_in_consist)) {
							0: random_loadstack_SBB_Seetal_DVT_yellow; 
								switch_7822_graphics_check_4976;}
								
								
//Checks if Seetal Coach is in consist
								
						switch (FEAT_TRAINS,PARENT,switch_7822_graphics_check_6565,(count_veh_id(6565))) {
							0: switch_7822_graphics_check_4976_7822; 
								switch_reverse_SBB_Seetal_DVT_yellow_4975;}								

//Checks if exactly one De 4/4 is in consist - if check fails fallback to De 4/4 "standard"

						switch (FEAT_TRAINS,PARENT,switch_7822_graphics_check_4975,(count_veh_id(4975))) {
							0: switch_7822_graphics_check_4976_7822;
							 switch_7822_graphics_check_6565;}
								
//Checks if Consist is only De 4/4 + Seetal coach + Seetal DVT

						switch (FEAT_TRAINS,PARENT,switch_7822_graphics_check_4975_7822,(count_veh_id(4975)+count_veh_id(6565) +count_veh_id(7822)==num_vehs_in_consist)) {
							0: switch_7822_graphics_check_4976_7822; 
								switch_7822_graphics_check_4975;}

						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Seetal_DVT_yellow, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_7822_graphics_check_4975_7822;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Seetal_DVT_yellow, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_SEETAL_DVT_YELLOW;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
