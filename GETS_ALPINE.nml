											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_EXPRESS),);
			length						   : switch_length_OBB_KFNB_Ib;
			articulated_part			   : switch_articulated_OBB_KFNB_Ib_KFNB;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_spritestack_OBB_KFNB_Ib_KFNB_purchase;
			cost_factor					    :7;
			running_cost_factor				:switch_running_cost_OBB_KFNB_Ib;
			visual_effect_and_powered		:switch_FX_OBB_KFNB_Ib;
			
			}
	}


					switch(FEAT_TRAINS, SELF, switch_graphics_OBB_KFNB_Ib_kkstb, position_in_vehid_chain % 2) {
							0:	   return switch_spritestack_OBB_KFNB_Ib_kkstb;
							1:     spriteset_OBB_KFNB_IXa_Tender_kkstb;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_KFNB_Ib_kkstb, extra_callback_info1) {
							1: return ITEM_OBB_KFNB_IB_KKSTB; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_KFNB_IB_KKSTB, 0006)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_IB_KKSTB);
						variant_group: 					0003;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1909,01,01);
						model_life: 					40;
						vehicle_life: 					50;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						343 hp;
						weight: 						60 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_graphics_OBB_KFNB_Ib_kkstb;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_EXPRESS),);
			length						   : switch_length_OBB_KFNB_Ib;
			articulated_part			   : switch_articulated_OBB_KFNB_Ib_kkstb;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_spritestack_OBB_KFNB_Ib_kkstb_purchase;
			cost_factor					    :7;
			running_cost_factor				:switch_running_cost_OBB_KFNB_Ib;
			visual_effect_and_powered		:switch_FX_OBB_KFNB_Ib;
			
			}
	}
