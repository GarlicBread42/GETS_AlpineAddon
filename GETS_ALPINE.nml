									{ template_148trains_1x(0, 0)}
				
alternative_sprites (spriteset_SOB_Revvivo_DVT_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SOB_Revvivo/SOB_Revvivo_DVT_loading_1x_32bpp.png", "gfx/SOB_Revvivo/SOB_Revvivo_DVT_loading_1x_mask.png")
									{template_148trains_1x(0, 0)}
				
alternative_sprites (spriteset_SOB_Revvivo_DVT_loading, ZOOM_LEVEL_IN_2X, BIT_DEPTH_32BPP, "gfx/SOB_Revvivo/SOB_Revvivo_DVT_loading_2x_32bpp.png", "gfx/SOB_Revvivo/SOB_Revvivo_DVT_loading_2x_mask.png")
									{template_148trains_2x(0, 0)}
				
