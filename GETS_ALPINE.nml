									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_SBB_Seetal_ABD_window_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/SBB_Seetal_ABD/SBB_Seetal_ABD_window4_1x_32bpp.png", "gfx/SBB_Seetal_ABD/SBB_Seetal_ABD_window4_1x_mask.png")
									{template_purchase(0, 0)}									
									
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Seetal_ABD_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Seetal_ABD_purchase;
							1: spriteset_SBB_Seetal_ABD_window_purchase;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_Seetal_ABD_window1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Seetal_ABD;
							1: spriteset_SBB_Seetal_ABD_window1;
							2: spritegroup_SBB_Seetal_ABD_loading;}																																					

						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_Seetal_ABD_window2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Seetal_ABD;
							1: spriteset_SBB_Seetal_ABD_window2;
							2: spritegroup_SBB_Seetal_ABD_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_Seetal_ABD_window3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Seetal_ABD;
							1: spriteset_SBB_Seetal_ABD_window3;
							2: spritegroup_SBB_Seetal_ABD_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_Seetal_ABD_window4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Seetal_ABD;
							1: spriteset_SBB_Seetal_ABD_window4;
							2: spritegroup_SBB_Seetal_ABD_loading;}														

					random_switch(FEAT_TRAINS, SELF, random_loadstack_SBB_Seetal_ABD, bitmask(TRIGGER_VEHICLE_UNLOAD_ALL, TRIGGER_VEHICLE_NEW_LOAD,)) {
							1: switch_loadstack_SBB_Seetal_ABD_window1;
							1: switch_loadstack_SBB_Seetal_ABD_window2;
							1: switch_loadstack_SBB_Seetal_ABD_window3;
							3: switch_loadstack_SBB_Seetal_ABD_window4;}

						switch(FEAT_TRAINS, SELF, switch_length_SBB_Seetal_ABD, position_in_articulated_veh % 3) {
							0: 4;
							1: 5;
							2: 4;}	

					switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Seetal_ABD, 1){
							return 950;}
							
						switch(FEAT_TRAINS, SELF, switch_cargo_capacity_SBB_Seetal_ABD, cargo_type_in_veh ) {
							PASS: 24;
							TOUR: 24;
						    MAIL: 24;
						    GOOD: 24;
						    VALU: 24;}							

						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Seetal_ABD, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return random_loadstack_SBB_Seetal_ABD;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Seetal_ABD, extra_callback_info1) {
							1: return ITEM_SBB_SEETAL_ABD;
							2: return ITEM_MAIL_48;													
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
item (FEAT_TRAINS , ITEM_SBB_SEETAL_ABD, 7754)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_SEETAL_ABD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1947,01,01);
						model_life: 					50;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR, MAIL, GOOD, VALU];
						loading_speed:					4;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							100 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						20 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					21;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_graphics_SBB_Seetal_ABD;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_PASS),);
			length							: switch_length_SBB_Seetal_ABD;
			articulated_part				: switch_articulated_SBB_Seetal_ABD;
			purchase						: switch_spritestack_SBB_Seetal_ABD_purchase;
			cost_factor						: 210;
			running_cost_factor				: switch_running_cost_SBB_Seetal_ABD;
			purchase_running_cost_factor	: 950;
			}
		}
