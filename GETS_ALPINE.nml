					{template_158trains_1x(0, 0)}	
				
		alternative_sprites (spriteset_OBB_Eurofima_BD_grau_loading, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_Eurofima_BD/OBB_Eurofima_BD_grau_loading_1x_32bpp.png", "gfx/OBB_Eurofima_BD/OBB_Eurofima_BD_grau_loading_1x_mask.png")
