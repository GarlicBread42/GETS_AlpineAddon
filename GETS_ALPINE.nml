						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_De_44_Seetal, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_4976_graphics_check_6565_7820;
							2:     spriteset_empty;}

					switch (FEAT_TRAINS, SELF, switch_articulated_SBB_De_44_Seetal, extra_callback_info1) {
						1 .. 2: return ITEM_SBB_DE_44_SEETAL; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }

item (FEAT_TRAINS , ITEM_SBB_DE_44_SEETAL, 4976)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(ITEM_SBB_DE_44_SEETAL);
						variant_group:					4975;
						extra_flags:					bitmask(VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);					
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1960,01,01);
						model_life: 					30;
						vehicle_life: 					30;
						retire_early: 					-10;							
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask();
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[MAIL, GOOD, VALU];
						loading_speed:					4;
						cargo_capacity: 				32 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							85 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						1096 hp;
						weight: 						62 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.164;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							:switch_graphics_SBB_De_44_Seetal;
			additional_text					:string(STR_CONCAT_3, 
											 string(STR_GAUGE_STANDARD), 
											 string(STR_TRACTION_ELECTRIC), 
											 string(STR_DESC_UNIVERSAL),);
			length							:switch_4976_length_check_6565_7820;
			articulated_part				:switch_articulated_SBB_De_44_Seetal;
			purchase						:spriteset_SBB_De_44_Seetal_purchase;
			cost_factor						: 49;
			running_cost_factor				:switch_running_cost_SBB_De_44;			
			visual_effect_and_powered		:switch_FX_SBB_De_44;	
			}
	}
