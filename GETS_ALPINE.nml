	alternative_sprites (spriteset_OBB_KFNB_VI_kkstb_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_KFNB_VI/OBB_KFNB_VI_kkstb_1x_32bpp.png", "gfx/OBB_KFNB_VI/OBB_KFNB_VI_kkstb_1x_mask.png")
									{template_purchase(0, 0)}	
									
spriteset(spriteset_OBB_KFNB_VI_anim_purchase, "gfx/OBB_KFNB_VI/OBB_KFNB_VI_anim1_1x_8bpp.png")
									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_OBB_KFNB_VI_anim_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_KFNB_VI/OBB_KFNB_VI_anim1_1x_32bpp.png", "gfx/OBB_KFNB_VI/OBB_KFNB_VI_anim1_1x_mask.png")
									{template_purchase(0, 0)}
									
																																			
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_VI_KFNB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_VI_KFNB_purchase;
							1: spriteset_OBB_KFNB_VI_anim_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_VI_kkstb_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_VI_kkstb_purchase;
							1: spriteset_OBB_KFNB_VI_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_VI_purchase,current_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_VI_KFNB_purchase;
							 1909 .. 2050: switch_spritestack_OBB_KFNB_VI_kkstb_purchase;					 					 
								switch_spritestack_OBB_KFNB_VI_kkstb_purchase;}																				

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_VI, motion_counter % 4) {
							0: spriteset_OBB_KFNB_VI_anim1;
							1: spriteset_OBB_KFNB_VI_anim2;
							2: spriteset_OBB_KFNB_VI_anim3;
							3: spriteset_OBB_KFNB_VI_anim4;}
							
						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_VI_REV, motion_counter % 4) {
							0: spriteset_OBB_KFNB_VI_anim1_REV;
							1: spriteset_OBB_KFNB_VI_anim2_REV;
							2: spriteset_OBB_KFNB_VI_anim3_REV;
							3: spriteset_OBB_KFNB_VI_anim4_REV;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_VI_KFNB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_VI_KFNB;
							1: return switch_animation_OBB_KFNB_VI;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_VI_KFNB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_VI_KFNB_REV;
							1: return switch_animation_OBB_KFNB_VI_REV;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_VI_kkstb, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_VI_kkstb;
							1: return switch_animation_OBB_KFNB_VI;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_VI_kkstb_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_VI_kkstb_REV;
							1: return switch_animation_OBB_KFNB_VI_REV;}	
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_KFNB_VI_KFNB, vehicle_is_reversed) {
							0: switch_spritestack_OBB_KFNB_VI_KFNB;
								switch_spritestack_OBB_KFNB_VI_KFNB_REV;}	
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_KFNB_VI_kkstb, vehicle_is_reversed) {
							0: switch_spritestack_OBB_KFNB_VI_kkstb;
								switch_spritestack_OBB_KFNB_VI_kkstb_REV;}																																								

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_VI, 1){
							return 225;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_VI, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_VI_Loco_build_year,build_year){
							    0 .. 1908: switch_reverse_OBB_KFNB_VI_KFNB;
							 1909 .. 2050: switch_reverse_OBB_KFNB_VI_kkstb;					 					 
								switch_reverse_OBB_KFNB_VI_kkstb;}																					   				


item (FEAT_TRAINS , ITEM_OBB_KFNB_VI_BUILD, 0055)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_VI_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1870,01,01);
						model_life: 					60;
						vehicle_life: 					40;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						310 hp;
						weight: 						41 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						5;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_OBB_KFNB_VI_Loco_build_year;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_GOODS),);
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_OBB_KFNB_VI_purchase;
			cost_factor					    :6;
			running_cost_factor				:switch_running_cost_OBB_KFNB_VI;
			visual_effect_and_powered		:switch_FX_OBB_KFNB_VI;
			
			}
	}


						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_VI_Loco_current_year,current_year){
							    0 .. 1908: switch_reverse_OBB_KFNB_VI_KFNB;
							 1909 .. 2050: switch_reverse_OBB_KFNB_VI_kkstb;					 					 
								switch_reverse_OBB_KFNB_VI_kkstb;}																							   

