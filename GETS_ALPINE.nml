//Switches Private Companies


						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_BT_alt, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_BT_alt;
								spriteset_SBB_TM4_BT_alt_REV;}								

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_BT_neu, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_BT_neu;
								spriteset_SBB_TM4_BT_neu_REV;}								

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_CJ_alt, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_CJ_alt;
								spriteset_SBB_TM4_CJ_alt_REV;}	

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_CJ_alt_Refresh, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_CJ_alt_Refresh;
								spriteset_SBB_TM4_CJ_alt_Refresh_REV;}	

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_CJ_neu, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_CJ_neu;
								spriteset_SBB_TM4_CJ_neu_REV;}																	

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_ST, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_ST;
								spriteset_SBB_TM4_ST_REV;}	

						switch (FEAT_TRAINS, SELF, random_choose_SBB_TM4_PRIV, switch_alternative_var_random_bits(1, 3)) {
							1: switch_reverse_SBB_TM4_BT_alt;
							2: switch_reverse_SBB_TM4_BT_neu;
							3: switch_reverse_SBB_TM4_CJ_alt_Refresh;
							4: switch_reverse_SBB_TM4_CJ_neu;
							5: switch_reverse_SBB_TM4_ST;
							6: switch_reverse_SBB_TM4_BT_neu;
							7: switch_reverse_SBB_TM4_CJ_alt;
							   switch_reverse_SBB_TM4_CJ_neu;}

