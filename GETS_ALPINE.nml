//Switches	

						switch (FEAT_TRAINS,SELF,switch_purchase_OBB_Rh_2070,current_year) {
							   0 .. 2002 : spriteset_OBB_Rh_2070_Pflatsch_purchase;
							2003 .. 2050 : spriteset_OBB_Rh_2070_Wort_purchase;
								spriteset_OBB_Rh_2070_Wort_purchase;}
																
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_2070_Pflatsch, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_2070_Pflatsch;
							1: spriteset_OBB_Rh_2070_lights_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_2070_Pflatsch_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_2070_Pflatsch_REV;
							1: spriteset_OBB_Rh_2070_lights_back_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_2070_Wort, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_2070_Wort;
							1: spriteset_OBB_Rh_2070_lights_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_2070_Wort_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_2070_Wort_REV;
							1: spriteset_OBB_Rh_2070_lights_back_REV;}							

						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_Rh_2070_Pflatsch, vehicle_is_reversed) {
							0: switch_spritestack_OBB_Rh_2070_Pflatsch;
								switch_spritestack_OBB_Rh_2070_Pflatsch_REV;}							
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_Rh_2070_Wort, vehicle_is_reversed) {
							0: switch_spritestack_OBB_Rh_2070_Wort;
								switch_spritestack_OBB_Rh_2070_Wort_REV;}	
																																																			
																				
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_Rh_2070_REV, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);
								1:return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_Rh_2070_REV2, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);
								1:return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
										
						switch (FEAT_TRAINS, PARENT, switch_FX_OBB_Rh_2070, vehicle_is_reversed) {
							0: switch_FX_OBB_Rh_2070_REV;
								switch_FX_OBB_Rh_2070_REV2;}	

						switch(FEAT_TRAINS, SELF, switch_length_OBB_Rh_2070, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
																											
						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_Rh_2070, 1){
							return 1075;}

						switch (FEAT_TRAINS,SELF,switch_build_year_OBB_Rh_2070,build_year) {
							   0 .. 2002 : switch_reverse_OBB_Rh_2070_Pflatsch;
							2003 .. 2050 : switch_reverse_OBB_Rh_2070_Wort;
								switch_reverse_OBB_Rh_2070_Wort;}
								
						switch(FEAT_TRAINS, SELF, switch_graphics_OBB_Rh_2070_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     return switch_build_year_OBB_Rh_2070;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Rh_2070_build, extra_callback_info1) {
							1: return ITEM_OBB_RH_2070_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

