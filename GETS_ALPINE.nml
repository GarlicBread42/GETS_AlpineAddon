							1976 .. 1989 : switch_spritestack_OBB_Rh_4010_back_OBB;
							1990 .. 2100 : switch_spritestack_OBB_Rh_4010_back_rot;
								switch_spritestack_OBB_Rh_4010_back_rot;}																							

						switch(FEAT_TRAINS, SELF, switch_graphics_build_year_OBB_Rh_4010, position_in_vehid_chain % 17) {
							0:	   spriteset_empty;
							1:     return switch_build_year_OBB_Rh_4010_front;
							2:	   spriteset_empty;
							3: 	   switch_build_year_OBB_Rh_4010_middle1;
							4:     spriteset_empty;
							5: 	   spriteset_empty;
							6: 	   switch_build_year_OBB_Rh_4010_middle2;
							7:     spriteset_empty;
							8: 	   spriteset_empty;
							9: 	   switch_build_year_OBB_Rh_4010_middle3;
						   10:     spriteset_empty;
						   11: 	   spriteset_empty;
						   12: 	   switch_build_year_OBB_Rh_4010_middle4;
						   13:     spriteset_empty;
						   14: 	   spriteset_empty;
						   15: 	   switch_build_year_OBB_Rh_4010_back;
						   16: 	   spriteset_empty;}								
							
						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Rh_4010_build, extra_callback_info1) {
							1 .. 16: return ITEM_OBB_RH_4010_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_RH_4010_BUILD, 4000)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_RH_4010_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1965,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_allow_refit:              [PASS, TOUR];
