						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW1_DVTB_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW1_DVTB_rot;
							1: spritegroup_SBB_EW1_DVTB_gruen_loading;}
																																			
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW1_DVTB_colibri, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW1_DVTB_colibri;
							1: spritegroup_SBB_EW1_DVTB_colibri_loading;}
																																			
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW1_DVTB_Autozug, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW1_DVTB_Autozug;
							1: spritegroup_SBB_EW1_DVTB_colibri_loading;}
																																																								
						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_gruen, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_A_gruen;
							2: switch_loadstack_SBB_EW1_B_gruen;
							3: switch_loadstack_SBB_EW1_B_gruen;							
							   switch_loadstack_SBB_EW1_B_gruen;}	

						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_gruen_1962, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_A_gruen;
							2: switch_loadstack_SBB_EW1_B_gruen;
							3: switch_loadstack_SBB_EW1_B2_gruen;							
							   switch_loadstack_SBB_EW1_B_gruen;}	
														
						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_B_gruen_1962, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_B_gruen;
							2: switch_loadstack_SBB_EW1_B_gruen;
							3: switch_loadstack_SBB_EW1_B2_gruen;							
							   switch_loadstack_SBB_EW1_B_gruen;}	
							   														
						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_gruen_neu, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_A_gruen_neu;
							2: switch_loadstack_SBB_EW1_B_gruen_neu;
							3: switch_loadstack_SBB_EW1_B2_gruen_neu;							
							   switch_loadstack_SBB_EW1_B_gruen_neu;}
														
						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_B_gruen_neu, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_B_gruen_neu;
							2: switch_loadstack_SBB_EW1_B_gruen_neu;
							3: switch_loadstack_SBB_EW1_B2_gruen_neu;							
							   switch_loadstack_SBB_EW1_B_gruen_neu;}	
							   							   							   
						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_colibri, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_A_colibri;
							2: switch_loadstack_SBB_EW1_B_colibri;
							3: switch_loadstack_SBB_EW1_AB_colibri;							
							   switch_loadstack_SBB_EW1_B_colibri;}	

						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_Papagei, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_SBB_EW1_A_Papagei;
							2: switch_loadstack_SBB_EW1_B_Papagei;
							3: switch_loadstack_SBB_EW1_B_Papagei;							
							   switch_loadstack_SBB_EW1_B_Papagei;}
														
						switch (FEAT_TRAINS, SELF, random_choose_SBB_EW1_DVTB_gruen_neu, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_SBB_EW1_DVTB_gruen_neu;							
							   switch_loadstack_SBB_EW1_DVTB_gruen_neu2;}

							   							   							   
						switch(FEAT_TRAINS, SELF, switch_length_SBB_EW1_Coach, position_in_articulated_veh % 3) {
							0: 4;
							1: 5;
							2: 4;}	

						switch (FEAT_TRAINS, PARENT, switch_running_cost_SBB_EW1_Coach,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 1600;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_SBB_EW1_Coach,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}								   							

						switch(FEAT_TRAINS, SELF, switch_autoconsist1_SBB_EW1_gruen, position_in_vehid_chain) {
							 1: return switch_loadstack_SBB_EW1_A_gruen;
								default: switch_loadstack_SBB_EW1_B_gruen;}
								
						switch(FEAT_TRAINS, SELF, switch_autoconsist2_SBB_EW1_gruen, position_in_vehid_chain) {
							 1: return switch_loadstack_SBB_EW1_A_gruen;
							 4: return switch_loadstack_SBB_EW1_B_gruen;
								default: switch_loadstack_SBB_EW1_B_gruen;}	
								
						switch(FEAT_TRAINS, SELF, switch_autoconsist3_SBB_EW1_gruen, position_in_vehid_chain) {
							 1: return switch_loadstack_SBB_EW1_A_gruen;
							 4: return switch_loadstack_SBB_EW1_A_gruen;
							 7: return switch_loadstack_SBB_EW1_B_gruen;
								default: switch_loadstack_SBB_EW1_B_gruen;}															
																
						switch(FEAT_TRAINS, SELF, switch_autoconsist_SBB_EW1_gruen, position_in_vehid_chain) {
							 1: return switch_loadstack_SBB_EW1_A_gruen;
							 4: return switch_loadstack_SBB_EW1_A_gruen;
							 7: return switch_loadstack_SBB_EW1_A_gruen;
							10: return switch_loadstack_SBB_EW1_B_gruen;
							13: return switch_loadstack_SBB_EW1_B_gruen;
							16: return switch_loadstack_SBB_EW1_B_gruen; 
								default: switch_loadstack_SBB_EW1_B_gruen;}
								
						switch (FEAT_TRAINS, SELF, switch_SBB_EW1_gruen_lengthcheck2, num_vehs_in_vehid_chain) {
						     0 .. 12: switch_autoconsist1_SBB_EW1_gruen;
						     13 .. 15: switch_autoconsist2_SBB_EW1_gruen;
						     16 .. 21: switch_autoconsist3_SBB_EW1_gruen;
