						switch (FEAT_TRAINS,SELF, switch_SBB_Bm_66_purchase,current_year){
							  00 .. 1983: spriteset_SBB_Bm_66_braun1_purchase;
							1984 .. 2050: spriteset_SBB_Bm_66_rot1_purchase;
								spriteset_SBB_Bm_66_rot1_purchase;}
							
						switch (FEAT_TRAINS, SELF, switch_animation_SBB_Bm_66, motion_counter % 4) {
							0: spriteset_SBB_Bm_66_Vent_anim1;
							1: spriteset_SBB_Bm_66_Vent_anim2;
							2: spriteset_SBB_Bm_66_Vent_anim3;
							3: spriteset_SBB_Bm_66_Vent_anim4;}
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_66_braun1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_66_braun1;
							1: switch_animation_SBB_Bm_66;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_66_braun2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_66_braun2;
							1: switch_animation_SBB_Bm_66;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_66_rot1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_66_rot1;
							1: switch_animation_SBB_Bm_66;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_66_rot2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_66_rot2;
							1: switch_animation_SBB_Bm_66;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_66_rot3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_66_rot3;
							1: switch_animation_SBB_Bm_66;}
					
						switch (FEAT_TRAINS, SELF, random_choose_SBB_Bm_66_braun, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_SBB_Bm_66_braun1;
								switch_spritestack_SBB_Bm_66_braun2;}	
								
						switch (FEAT_TRAINS, SELF, random_choose_SBB_Bm_66_rot, switch_alternative_var_random_bits(1, 2)) {
							1: switch_spritestack_SBB_Bm_66_rot1;
							2: switch_spritestack_SBB_Bm_66_rot2;
							3: switch_spritestack_SBB_Bm_66_rot3;
								switch_spritestack_SBB_Bm_66_rot2;}																																																											
																				
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Bm_66, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);
							2 :return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS, SELF, switch_length_SBB_Bm_66, position_in_vehid_chain % 3) {
							0: 4;
							1: 3;
							2: 4;}
																											
						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Bm_66, 1){
							return 850;}

						switch (FEAT_TRAINS,SELF, switch_SBB_Bm_66_build_year,build_year){
							   00 .. 1983: random_choose_SBB_Bm_66_braun;
							 1920 .. 2050: random_choose_SBB_Bm_66_rot; 						 					 
							 random_choose_SBB_Bm_66_rot;}

						switch(FEAT_TRAINS, SELF, switch_SBB_Bm_66_graphics_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_SBB_Bm_66_build_year;
							2:	   spriteset_empty;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Bm_66_build, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_BM_66_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

item (FEAT_TRAINS , ITEM_SBB_BM_66_BUILD, 2366)
		{
		property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_BM_66_BUILD);
						climates_available: 			ALL_CLIMATES;
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						introduction_date: 				date(1954,01,01);
						model_life: 					45;
						vehicle_life: 					45;
						retire_early: 					-10;	
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							75 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						1300 hp;
						weight: 						106 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_DIESEL;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.315;
						length: 						8;										
			}

		graphics
			{
			default							:switch_SBB_Bm_66_graphics_build;
			additional_text				    :string(STR_CONCAT_3, 
											 string(STR_GAUGE_STANDARD),
											 string(STR_TRACTION_DIESEL), 
											 string(STR_DESC_SHUNT),);
			length							: switch_length_SBB_Bm_66;
			articulated_part				: switch_articulated_SBB_Bm_66_build;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: switch_SBB_Bm_66_purchase;
			cost_factor						: 24;
			running_cost_factor				: switch_running_cost_SBB_Bm_66;
			visual_effect_and_powered		: switch_FX_SBB_Bm_66;
			
			}
	}	

						switch (FEAT_TRAINS,SELF, switch_SBB_Bm_66_current_year,current_year){
							   00 .. 1983: random_choose_SBB_Bm_66_braun;
							 1920 .. 2050: random_choose_SBB_Bm_66_rot; 						 					 
							 random_choose_SBB_Bm_66_rot;}							 
							 
						switch(FEAT_TRAINS, SELF, switch_SBB_Bm_66_graphics_current, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
