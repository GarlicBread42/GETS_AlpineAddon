							0: spriteset_SBB_Eem_923_Panto_up;
							1: spriteset_SBB_Eem_923_lights_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Eem_923_Panto_up_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Eem_923_Panto_up_REV;
							1: spriteset_SBB_Eem_923_lights_back_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Eem_923_Panto_down, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Eem_923_Panto_down;
							1: spriteset_SBB_Eem_923_lights_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Eem_923_Panto_down_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Eem_923_Panto_down_REV;
							1: spriteset_SBB_Eem_923_lights_back_REV;}							

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Eem_923_Panto_up, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Eem_923_Panto_up;
								switch_spritestack_SBB_Eem_923_Panto_up_REV;}	
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Eem_923_Panto_down, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Eem_923_Panto_down;
								switch_spritestack_SBB_Eem_923_Panto_down_REV;}			
								
						switch(FEAT_TRAINS,PARENT,switch_graphics_railtype_SBB_Eem_923, tile_powers_railtype("AC15")){
							1: return switch_reverse_SBB_Eem_923_Panto_up;
								return switch_reverse_SBB_Eem_923_Panto_down;}															

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Eem_923, tile_powers_railtype("AC15")){
							1: return 800;
								return 175;}	
								
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Eem_923_REV, position_in_vehid_chain % 1) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -2, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Eem_923_REV2, position_in_vehid_chain % 1) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, -2, DISABLE_WAGON_POWER);}		
										
						switch (FEAT_TRAINS, PARENT, switch_FX_SBB_Eem_923_ELRL, vehicle_is_reversed) {
							0: switch_FX_SBB_Eem_923_REV;
								switch_FX_SBB_Eem_923_REV2;}
								
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Eem_923_REV3, position_in_vehid_chain % 1) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Eem_923_REV4, position_in_vehid_chain % 1) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);}		
										
						switch (FEAT_TRAINS, PARENT, switch_FX_SBB_Eem_923_RAIL, vehicle_is_reversed) {
							0: switch_FX_SBB_Eem_923_REV3;
								switch_FX_SBB_Eem_923_REV4;}
								
						switch (FEAT_TRAINS, SELF, switch_FX_SBB_Eem_923, tile_powers_railtype("ELRL")) {
							1: return switch_FX_SBB_Eem_923_ELRL;
								switch_FX_SBB_Eem_923_RAIL;}	
								
						switch (FEAT_TRAINS, SELF, switch_power_SBB_Eem_923, tile_powers_railtype("AC15")) {
							1: return 2040;
							return 400;}																							

item (FEAT_TRAINS , ITEM_SBB_EEM_923, 1763)
