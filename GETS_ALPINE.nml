							0: spriteset_OBB_Rh_4010_back_rot;
							1: spritegroup_OBB_Rh_4010_back_rot_loading;}								

					switch(FEAT_TRAINS, SELF, switch_length_OBB_Rh_4010, position_in_vehid_chain % 17) {
							0: 4;
							1: 6;
							2: 4;
							3: 7;
							4: 4;
							5: 4;
							6: 7;
							7: 4;
							8: 4;
							9: 7;
						   10: 4;
						   11: 4;
						   12: 7;
						   13: 4;
						   14: 4;
						   15: 7;
						   16: 4;}
						   
					switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_Rh_4010, 1){
							return 3750;}						   

					switch(FEAT_TRAINS, SELF, switch_FX_OBB_Rh_4010, position_in_vehid_chain % 17) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);														
								2 .. 16: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

//Build year switches

						switch (FEAT_TRAINS,SELF,switch_build_year_OBB_Rh_4010_front,build_year) {
							   0 .. 1975 : spriteset_OBB_Rh_4010_front_BBO;
							1976 .. 1989 : spriteset_OBB_Rh_4010_front_OBB;
							1990 .. 2100 : spriteset_OBB_Rh_4010_front_rot;
