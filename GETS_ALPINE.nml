						switch (FEAT_TRAINS, SELF, random_choose_SBB_RBe_540_Serie_gruen, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_SBB_RBe_540_Serie_gruen_back;
								switch_spritestack_SBB_RBe_540_Serie_gruen_front;}		
								
						switch (FEAT_TRAINS, SELF, random_choose_SBB_RBe_540_Serie_gruen_neu, switch_alternative_var_random_bits(1, 1)) {
