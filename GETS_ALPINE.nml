									{ template_purchase(0, 0)}
				
	alternative_sprites (spriteset_OBB_KFNB_IXa_anim_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_KFNB_IXa/OBB_KFNB_IXa_anim1_1x_32bpp.png", "gfx/OBB_KFNB_IXa/OBB_KFNB_IXa_anim1_1x_mask.png")
									{template_purchase(0, 0)}
									
																																			
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IXa_KFNB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IXa_KFNB_purchase;
							1: spriteset_OBB_KFNB_IXa_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IXa_KFNB_roofed_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IXa_KFNB_roofed_purchase;
							1: spriteset_OBB_KFNB_IXa_anim_purchase;}	
							
