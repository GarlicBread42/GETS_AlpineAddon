							1976 .. 1989 : switch_spritestack_OBB_Rh_4010_middle1_OBB;
							1990 .. 2100 : switch_spritestack_OBB_Rh_4010_middle1_rot;
								switch_spritestack_OBB_Rh_4010_middle1_rot;}

