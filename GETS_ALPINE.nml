		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_RAILJET_2008_RANDOM);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2008,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							230 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						417 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					20;
						cargo_age_period:               185;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_OBB_Railjet_2008_check_ID1045;
			additional_text					: string(STR_DESC_EXPRESS);
			length							: switch_length_OBB_Railjet;
			articulated_part				: switch_articulated_OBB_Railjet_2008_random;
			purchase						: spriteset_OBB_Railjet_2008_purchase;
			cost_factor						: 540;
			running_cost_factor				: switch_running_cost_OBB_Railjet;
			}
		}
