			running_cost_factor				:switch_running_cost_SBB_Re_420;			
			visual_effect_and_powered		:switch_FX_SBB_Re_420;	
			}
	}	

																								
						switch (FEAT_TRAINS,SELF, switch_SBB_Re_420_current_year,current_year){
