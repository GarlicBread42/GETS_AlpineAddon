							 1909 .. 2050: spriteset_OBB_KFNB_IXa_Tender_kkstb;					 					 
								spriteset_OBB_KFNB_IXa_Tender_kkstb;}																					   
							   
					switch(FEAT_TRAINS, SELF, switch_graphics_OBB_KFNB_Ib2_build, position_in_vehid_chain % 2) {
							0:	   return switch_OBB_KFNB_Ib2_Loco_build_year;
							1:     return switch_OBB_KFNB_Ib2_Tender_build_year;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_KFNB_Ib2_build, extra_callback_info1) {
							1: return ITEM_OBB_KFNB_IB2_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_KFNB_IB2_BUILD, 0011)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_IB2_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1883,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							90 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						400 hp;
						weight: 						60 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_graphics_OBB_KFNB_Ib2_build;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
