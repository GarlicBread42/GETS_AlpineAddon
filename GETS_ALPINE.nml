						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						10 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					24;
						ai_engine_rank: 				0;
						length: 						5;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: random_choose_OBB_KFNB_1854;
			additional_text				    : string(STR_CONCAT_2, 
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_PASS),);
			purchase						: spriteset_OBB_KFNB_1854_purchase;
			cost_factor						: 96;
			running_cost_factor				: switch_running_cost_OBB_KFNB_1854;
			}
		}
