//Switches

						switch (FEAT_TRAINS,SELF, switch_OBB_Schlieren_BD_purchase,build_year){
							   0 .. 1982: spriteset_OBB_Schlieren_Jaffa1_BD_purchase;							   
							1983 .. 1986: spriteset_OBB_Schlieren_Jaffa2_BD_purchase;
							1986 .. 1991: spriteset_OBB_Schlieren_Spar_BD_purchase;
							1992 .. 2050: spriteset_OBB_Schlieren_Valousek_BD_purchase;
								spriteset_OBB_Schlieren_Valousek_BD_purchase;}							
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Schlieren_Jaffa1_BD, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Schlieren_Jaffa1_BD;
							1: spritegroup_OBB_Schlieren_BD_Jaffa_loading;}																									
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Schlieren_Jaffa2_BD, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Schlieren_Jaffa2_BD;
							1: spritegroup_OBB_Schlieren_BD_Jaffa_loading;}	
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Schlieren_Spar_BD, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Schlieren_Spar_BD;
							1: spritegroup_OBB_Schlieren_BD_Spar_loading;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Schlieren_Valousek_BD, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Schlieren_Valousek_BD;
							1: spritegroup_OBB_Schlieren_BD_Valousek_loading;}							

						switch(FEAT_TRAINS, SELF, switch_length_OBB_Schlieren_BD, position_in_articulated_veh % 3) {
							0: 4;
							1: 6;
							2: 4;}	
							
						switch (FEAT_TRAINS, PARENT, switch_running_cost_OBB_Schlieren_BD,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 1600;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_OBB_Schlieren_BD,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}								

						switch(FEAT_TRAINS, SELF, switch_cargo_capacity_OBB_Schlieren_BD, cargo_type_in_veh ) {
							PASS: 24;
							TOUR: 24;
						    MAIL: 24;
						    GOOD: 24;
						    VALU: 24;}	
						    
						switch (FEAT_TRAINS,SELF, switch_OBB_Schlieren_BD_build_year,build_year){
							   0 .. 1982: switch_loadstack_OBB_Schlieren_Jaffa1_BD;	
							1983 .. 1986: switch_loadstack_OBB_Schlieren_Jaffa2_BD;							   
							1987 .. 1991: switch_loadstack_OBB_Schlieren_Spar_BD;
							1992 .. 2050: switch_loadstack_OBB_Schlieren_Valousek_BD;
								switch_loadstack_OBB_Schlieren_Valousek_BD;}								
															
						switch(FEAT_TRAINS, SELF, switch_graphics_OBB_Schlieren_BD_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_OBB_Schlieren_BD_build_year;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Schlieren_BD_build, extra_callback_info1) {
							1: return ITEM_OBB_SCHLIEREN_BD_BUILD;
							2: return ITEM_MAIL_24;											
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

																						
item (FEAT_TRAINS , ITEM_OBB_SCHLIEREN_BD_BUILD, 7077)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_SCHLIEREN_BD_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1975,01,01);
						model_life: 					40;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR, MAIL, GOOD, VALU];
						loading_speed:					5;
