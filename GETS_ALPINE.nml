						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW1_DVTB_gruen_neu, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW1_DVTB_gruen_neu;
							1: spritegroup_SBB_EW1_DVTB_gruen_loading;}															
														
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW1_DVTB_gruen_neu2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW1_DVTB_gruen_neu2;
