							1976 .. 1989 : spriteset_OBB_Rh_4010_front_OBB_purchase;
							1990 .. 2100 : spriteset_OBB_Rh_4010_front_rot_purchase;
								spriteset_OBB_Rh_4010_front_rot_purchase;}	
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_4010_middle1_BBO, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
