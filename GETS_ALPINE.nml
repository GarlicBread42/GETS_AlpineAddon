//Switches	
									
						switch (FEAT_TRAINS,SELF, switch_SBB_Am_66_purchase,current_year){
							  00 .. 1983: spriteset_SBB_Am_66_braun_purchase;
							1984 .. 2050: spriteset_SBB_Am_66_rot_purchase;
								spriteset_SBB_Am_66_rot_purchase;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Am_66_braun, vehicle_is_reversed) {
							0: spriteset_SBB_Am_66_braun;
								spriteset_SBB_Am_66_braun_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Am_66_rot, vehicle_is_reversed) {
							0: spriteset_SBB_Am_66_rot;
								spriteset_SBB_Am_66_rot_REV;}
																													
						switch(FEAT_TRAINS, SELF, switch_length_SBB_Am_66, position_in_vehid_chain % 3) {
							0: 4;
							1: 3;
							2: 4;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Am_66_1, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -1, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
								
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Am_66_2, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -1, DISABLE_WAGON_POWER);}	
							
						switch (FEAT_TRAINS, PARENT, switch_FX_SBB_Am_66, vehicle_is_reversed) {
							0: switch_FX_SBB_Am_66_1;
								switch_FX_SBB_Am_66_2;}													
						
						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Am_66, 1){
							return 1100;}
						
						switch (FEAT_TRAINS,SELF, switch_SBB_Am_66_build_year,build_year){
							  00 .. 1983: switch_reverse_SBB_Am_66_braun;
							1984 .. 2050: switch_reverse_SBB_Am_66_rot;
								switch_reverse_SBB_Am_66_rot;}												
						
					switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Am_66_build, position_in_vehid_chain % 3) {
						0:	   spriteset_empty;
						1:     switch_SBB_Am_66_build_year;
						2:	   spriteset_empty;}

					switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Am_66_build, extra_callback_info1) {
						1: return ITEM_SBB_AM_66_BUILD; 
						2: return ITEM_SBB_AM_66_BUILD;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }									

