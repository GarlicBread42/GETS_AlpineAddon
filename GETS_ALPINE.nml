//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Ce_68_3_brown_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Ce_68_3_brown_purchase;
							1: spriteset_SBB_Ce_68_3_anim_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Ce_68_3_green_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Ce_68_3_green_purchase;
							1: spriteset_SBB_Ce_68_3_anim_purchase;}
						
						switch (FEAT_TRAINS,SELF, switch_purchase_SBB_Ce_68_3,current_year){
							1900 .. 1928: switch_spritestack_SBB_Ce_68_3_brown_purchase;
							1929 .. 2050: switch_spritestack_SBB_Ce_68_3_green_purchase;															 					 
								switch_spritestack_SBB_Ce_68_3_green_purchase;}	
								
						switch (FEAT_TRAINS, SELF, switch_animation_SBB_Ce_68_3, motion_counter % 4) {
								0: spriteset_SBB_Ce_68_3_anim1;
								1: spriteset_SBB_Ce_68_3_anim2;
								2: spriteset_SBB_Ce_68_3_anim3;
								3: spriteset_SBB_Ce_68_3_anim4;}	

