							2:  		spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_RBe_540_build, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_RBE_540_BUILD; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

