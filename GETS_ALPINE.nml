							1970 .. 1989: return random_choose_OBB_Rh_1020;	
							1990 .. 2050: spriteset_OBB_Rh_1020_blutorange;				 					 
										spriteset_OBB_Rh_1020_blutorange;}	
							
						switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1020_current_year,current_year){
