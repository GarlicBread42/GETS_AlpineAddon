			articulated_part				: switch_articulated_SBB_Am_842_1;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_SBB_Am_842_1_VAR1_purchase;
			cost_factor						: 23;
			running_cost_factor				: switch_running_cost_SBB_Am_842_1;
			visual_effect_and_powered		: switch_FX_SBB_Am_842_1;
			
			}
	}	


						switch(FEAT_TRAINS, SELF, switch_SBB_Am_842_1_Sersa_graphics, position_in_vehid_chain % 3) {
