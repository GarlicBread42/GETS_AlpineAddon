					{template_purchase(0, 0)}

//Switches

					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1845_Flat_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1845_Flat;
						1: spritegroup_OBB_KFNB_1845_Flat_load_Box;}						

					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1845_Flat_Oversize, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1845_Flat;
						1: spritegroup_OBB_KFNB_1845_Flat_load_Oversize;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1845_Flat_Steel, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1845_Flat;
						1: spritegroup_OBB_KFNB_1845_Flat_load_Steel;}		
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1845_Flat_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1845_Flat;
						1: spritegroup_OBB_KFNB_1845_Flat_load_Wood;}						

					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1845_Flat_VEHI, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1845_Flat;
						1: spritegroup_OBB_KFNB_1845_Flat_load_VEHI;}						
								
					switch(FEAT_TRAINS, SELF, switch_OBB_KFNB_1845_Flat_cargo_classes, cargo_classes) {
							bitmask(CC_MAIL): return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							bitmask(CC_EXPRESS): return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							bitmask(CC_ARMOURED): return switch_loadstack_OBB_KFNB_1845_Flat_Oversize;
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							bitmask(CC_HAZARDOUS): return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							bitmask(CC_POWDERIZED): return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							bitmask(CC_NON_POURABLE): return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							bitmask(CC_OVERSIZED): return switch_loadstack_OBB_KFNB_1845_Flat_Oversize;
								switch_loadstack_OBB_KFNB_1845_Flat_Box;}
						
					switch (FEAT_TRAINS, SELF, switch_OBB_KFNB_1845_Flat_cargo_type, cargo_type_in_veh) {
							STEL: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							METL: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							ZINC: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							COPR: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							STST: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							STSH: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							STSE: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							STAL: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							STCB: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							STWR: return switch_loadstack_OBB_KFNB_1845_Flat_Steel; 
							CSTI: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;
							PIPE: return switch_loadstack_OBB_KFNB_1845_Flat_Steel;

							ENSP: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							FMSP: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							MNSP: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							POWR: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							VPTS: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							MPTS: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							GOOD: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							PAPR: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							TYRE: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							WOOL: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							TEXT: return switch_loadstack_OBB_KFNB_1845_Flat_Box;	
	
							BDMT: return switch_loadstack_OBB_KFNB_1845_Flat_Wood;
							WDPR: return switch_loadstack_OBB_KFNB_1845_Flat_Wood;
							WOOD: return switch_loadstack_OBB_KFNB_1845_Flat_Wood;
							GLAS: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							BRCK: return switch_loadstack_OBB_KFNB_1845_Flat_Box;
							
							VEHI: return switch_loadstack_OBB_KFNB_1845_Flat_VEHI;
								switch_OBB_KFNB_1845_Flat_cargo_classes;}																								
																		
					switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_1845_Flat, 1){
						return 45;}						
						
item (FEAT_TRAINS , ITEM_OBB_KFNB_1845_FLAT, 8045)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_1845_FLAT);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1845,01,01);
						model_life: 					30;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_MAIL, CC_EXPRESS, CC_ARMOURED, CC_PIECE_GOODS, CC_HAZARDOUS, CC_POWDERIZED, CC_NON_POURABLE, CC_OVERSIZED);
						non_refittable_cargo_classes:	bitmask(CC_BULK, CC_LIQUID, CC_REFRIGERATED, CC_COVERED, CC_NEO_BULK);
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						cargo_allow_refit:              [MAIL,GOOD, STEL, METL, ZINC, COPR, STST, STSH, STSE, STAL, STCB, STWR, CSTI, PIPE, ENSP, FMSP, MNSP, POWR, VPTS, MPTS, GOOD, PAPR, TYRE, WOOL, TEXT, BDMT, WDPR, WOOD, GLAS, BRCK, VEHI];
						cargo_disallow_refit: 			[PASS, LVST];
						loading_speed:					4;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							40 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						6 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					10;
						ai_engine_rank: 				0;
						length: 						4;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_OBB_KFNB_1845_Flat_cargo_type;
			additional_text				    : string(STR_CONCAT_2, 
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_GOODS),);
			purchase						: spriteset_OBB_KFNB_1845_Flat_purchase;
			cost_factor						: 2;
			running_cost_factor				: switch_running_cost_OBB_KFNB_1845_Flat;	
			colour_mapping					: switch_generic_recolour;			
			
			 }
		}
