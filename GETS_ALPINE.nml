									{ template_purchase(0, 0)}
	alternative_sprites (spriteset_OBB_Schlieren_Valousek_BD_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_Schlieren_BD/OBB_Schlieren_Valousek_BD_1x_32bpp.png", "gfx/OBB_Schlieren_BD/OBB_Schlieren_Valousek_BD_1x_mask.png")
