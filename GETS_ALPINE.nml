								spriteset_SZU_PENDEL_DVT_weiss_purchase;}
																
						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_PENDEL_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_PENDEL_orange;
							1: spritegroup_SZU_PENDEL_orange_loading;}
															
						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_PENDEL_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_PENDEL_rot;
							1: spritegroup_SZU_PENDEL_rot_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_PENDEL_weiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_PENDEL_weiss;
							1: spritegroup_SZU_PENDEL_weiss_loading;}																		
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_PENDEL_DVT_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_PENDEL_DVT_orange;
							1: spritegroup_SZU_PENDEL_DVT_orange_loading;}
															
						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_PENDEL_DVT_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_PENDEL_DVT_rot;
							1: spritegroup_SZU_PENDEL_DVT_rot_loading;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_SZU_PENDEL_DVT_weiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SZU_PENDEL_DVT_weiss;
							1: spritegroup_SZU_PENDEL_DVT_weiss_loading;}							
							   
						switch(FEAT_TRAINS, SELF, switch_length_SZU_PENDEL, position_in_articulated_veh % 3) {
							0: 4;
							1: 6;
							2: 4;}	
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_SZU_PENDEL, 1){
							return 1500;}
								
						switch (FEAT_TRAINS,SELF, switch_build_year_SZU_PENDEL,build_year){
							   0 .. 1992: switch_loadstack_SZU_PENDEL_orange;
							1993 .. 2013: switch_loadstack_SZU_PENDEL_rot;
							2014 .. 2050: switch_loadstack_SZU_PENDEL_weiss;															 					 
								switch_loadstack_SZU_PENDEL_weiss;}
								
						switch (FEAT_TRAINS,SELF, switch_build_year_SZU_PENDEL_DVT,build_year){
							   0 .. 1992: switch_loadstack_SZU_PENDEL_DVT_orange;
							1993 .. 2013: switch_loadstack_SZU_PENDEL_DVT_rot;
							2014 .. 2050: switch_loadstack_SZU_PENDEL_DVT_weiss;															 					 
								switch_loadstack_SZU_PENDEL_DVT_weiss;}								
																
						switch(FEAT_TRAINS, SELF, switch_DVT_SZU_PENDEL_build, position_in_consist_from_end) {
							1: return switch_build_year_SZU_PENDEL_DVT;
								default: return switch_build_year_SZU_PENDEL;}								
															
						switch(FEAT_TRAINS, SELF, switch_graphics_SZU_PENDEL_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_DVT_SZU_PENDEL_build;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SZU_PENDEL_build, extra_callback_info1) {
							1 .. 2: return ITEM_SZU_PENDEL_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
item (FEAT_TRAINS , ITEM_SZU_PENDEL_BUILD, 6987)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SZU_PENDEL_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1986,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							130 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						38 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					25;
