						switch (FEAT_TRAINS, SELF, random_choose_BLS_EW3_silber_Coach, switch_alternative_var_random_bits(1, 1)) {
							1: switch_loadstack_BLS_EW3_silber_A;
							   switch_loadstack_BLS_EW3_silber_B;}									   	
							   
						switch(FEAT_TRAINS, SELF, switch_length_BLS_EW3_silber_Coach, position_in_articulated_veh % 3) {
							0: 4;
							1: 6;
							2: 4;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BLS_EW3, 1){
