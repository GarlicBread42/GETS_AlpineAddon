							1984 .. 2013: spriteset_SBB_Bm_840_rot_purchase;
								spriteset_SBB_Bm_840_rot_purchase;}
								
						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_braun, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_840_braun;
							1: spriteset_SBB_Bm_840_lights_old_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_braun_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_840_braun_REV;
							1: spriteset_SBB_Bm_840_lights_old_back_REV;}

