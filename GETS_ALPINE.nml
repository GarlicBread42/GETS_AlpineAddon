						dual_headed: 					0;
						tractive_effort_coefficient: 	0.375;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							:switch_graphics_SBB_Re_446_rot;
			additional_text					:string(STR_CONCAT_3, 
