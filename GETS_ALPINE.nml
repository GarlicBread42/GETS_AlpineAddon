item (FEAT_TRAINS , ITEM_BLS_RE_486, 1835)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_RE_486);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2008,01,01);
						model_life: 					30;
