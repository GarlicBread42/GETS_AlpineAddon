//Switches

						switch(FEAT_TRAINS,SELF, switch_purchase_SBB_TM4_SBB, current_year){
							   0 .. 1988: spriteset_SBB_TM4_SBBRot1_purchase;
							1989 .. 2013: spriteset_SBB_TM4_SBBRot2_purchase;
							2014 .. 2100: spriteset_SBB_TM4_SBBCargo_purchase;
								spriteset_SBB_TM4_SBBCargo_purchase;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_SBBRot1, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_SBBRot1;
								spriteset_SBB_TM4_SBBRot1_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_SBBRot2, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_SBBRot2;
								spriteset_SBB_TM4_SBBRot2_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_SBBCargo, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_SBBCargo;
								spriteset_SBB_TM4_SBBCargo_REV;}								
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_SBBPAX, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_SBBPAX;
								spriteset_SBB_TM4_SBBPAX_REV;}								
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_TM4_SBBInfra, vehicle_is_reversed) {
							0: spriteset_SBB_TM4_SBBInfra;
								spriteset_SBB_TM4_SBBInfra_REV;}
								
						switch (FEAT_TRAINS, SELF, random_choose_SBB_TM4_SBB, switch_alternative_var_random_bits(1, 2)) {
							1: switch_reverse_SBB_TM4_SBBPAX;
							2: switch_reverse_SBB_TM4_SBBInfra;
							3: switch_reverse_SBB_TM4_SBBCargo;
							   switch_reverse_SBB_TM4_SBBCargo;}
							   
						switch(FEAT_TRAINS, PARENT, switch_FX_SBB_TM4_SBB, vehicle_is_reversed) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -3, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);}							
						
						switch (FEAT_TRAINS, PARENT, switch_running_cost_SBB_TM4_SBB, 1) {
							return 200;}							   							   
							
						switch (FEAT_TRAINS,SELF, switch_SBB_TM4_SBB_build_year,build_year){
							   0 .. 1988: switch_reverse_SBB_TM4_SBBRot1;
							1989 .. 2013: switch_reverse_SBB_TM4_SBBRot2;
							2014 .. 2100: random_choose_SBB_TM4_SBB;
								random_choose_SBB_TM4_SBB;}							   								

							
item (FEAT_TRAINS , ITEM_SBB_TM4_SBB_BUILD, 2830)

		{//property Block
					property 
					{
					//common properties
								name: 							string(STR_NAME_SBB_TM4_SBB_BUILD);
								extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
								climates_available: 			ALL_CLIMATES;
								introduction_date: 				date(1970,01,01);
								model_life: 					40;
								vehicle_life: 					40;
								retire_early: 					-10;								
								reliability_decay: 				20;
								cargo_allow_refit: 				[PASS] ;
								cargo_capacity: 				1 ;
								cost_factor: 					30;
								misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
								running_cost_base: 				RUNNING_COST_STEAM;
								running_cost_factor: 			90;
								
					//Train specific properties
								sprite_id: 						SPRITE_ID_NEW_TRAIN;
								speed: 							60 km/h;
								refit_cost: 					0;
								track_type: 					RAIL;
								power:  						380 hp;
								weight: 						30 ton;
								ai_engine_rank: 				0;
								engine_class: 					ENGINE_CLASS_STEAM;
								visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -3, DISABLE_WAGON_POWER);
								dual_headed: 					0;
								tractive_effort_coefficient: 	0.3;
								length: 						4;															
			}
			
			//Vehicels Graphics
					graphics
				{
						default						    : switch_SBB_TM4_SBB_build_year;
						additional_text				    : string(STR_CONCAT_3,
														  string(STR_GAUGE_STANDARD),
														  string(STR_TRACTION_DIESEL), 
														  string(STR_DESC_SHUNT),);
						purchase_cargo_capacity         : 0 ;
						cargo_capacity                  : return 0 ;
						purchase					    : switch_purchase_SBB_TM4_SBB;
						cost_factor						: 5;
						running_cost_factor				: switch_running_cost_SBB_TM4_SBB;
						visual_effect_and_powered		: switch_FX_SBB_TM4_SBB;
			 }
		}								

						switch (FEAT_TRAINS,SELF, switch_SBB_TM4_SBB_current_year,current_year){
							   0 .. 1987: switch_reverse_SBB_TM4_SBBRot1;
							1988 .. 1999: switch_reverse_SBB_TM4_SBBRot2;
							2000 .. 2100: random_choose_SBB_TM4_SBB;
								random_choose_SBB_TM4_SBB;}							   								

							
