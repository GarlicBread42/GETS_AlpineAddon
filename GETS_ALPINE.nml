			length							: switch_length_SBB_Bm_66;
			articulated_part				: switch_articulated_SBB_Bm_66_rot;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_SBB_Bm_66_rot1_purchase;
			cost_factor						: 24;
			running_cost_factor				: switch_running_cost_SBB_Bm_66;
			visual_effect_and_powered		: switch_FX_SBB_Bm_66;
			
			}
	}
