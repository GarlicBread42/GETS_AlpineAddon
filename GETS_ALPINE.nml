						weight: 						14 ton;
						dual_headed: 					0;
						default_cargo_type:				GOOD;
						cargo_capacity:					17;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
