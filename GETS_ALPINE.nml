//Spritesets purchase

spriteset (spriteset_OBB_KFNB_1850_Flat_purchase, "gfx\OBB_KFNB_1850_Flat/OBB_KFNB_1850_Flat_1x_8bpp.png")
					{template_purchase(0, 0)}	
				
		alternative_sprites (spriteset_OBB_KFNB_1850_Flat_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\OBB_KFNB_1850_Flat/OBB_KFNB_1850_Flat_1x_32bpp.png", "gfx\OBB_KFNB_1850_Flat/OBB_KFNB_1850_Flat_1x_mask.png")
					{template_purchase(0, 0)}

//Switches

					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1850_Flat_Box, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1850_Flat;
						1: spritegroup_OBB_KFNB_1850_Flat_load_Box;}						

					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1850_Flat_Oversize, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1850_Flat;
						1: spritegroup_OBB_KFNB_1850_Flat_load_Oversize;}
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1850_Flat_Steel, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1850_Flat;
						1: spritegroup_OBB_KFNB_1850_Flat_load_Steel;}		
						
					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1850_Flat_Wood, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1850_Flat;
						1: spritegroup_OBB_KFNB_1850_Flat_load_Wood;}						

					switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_KFNB_1850_Flat_VEHI, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
						0: spriteset_OBB_KFNB_1850_Flat;
						1: spritegroup_OBB_KFNB_1850_Flat_load_VEHI;}						
								
					switch(FEAT_TRAINS, SELF, switch_OBB_KFNB_1850_Flat_cargo_classes, cargo_classes) {
							bitmask(CC_MAIL): return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							bitmask(CC_EXPRESS): return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							bitmask(CC_ARMOURED): return switch_loadstack_OBB_KFNB_1850_Flat_Oversize;
							bitmask(CC_PIECE_GOODS) : return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							bitmask(CC_HAZARDOUS): return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							bitmask(CC_POWDERIZED): return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							bitmask(CC_NON_POURABLE): return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							bitmask(CC_OVERSIZED): return switch_loadstack_OBB_KFNB_1850_Flat_Oversize;
								switch_loadstack_OBB_KFNB_1850_Flat_Box;}
						
					switch (FEAT_TRAINS, SELF, switch_OBB_KFNB_1850_Flat_cargo_type, cargo_type_in_veh) {
							STEL: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							METL: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							ZINC: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							COPR: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							STST: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							STSH: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							STSE: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							STAL: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							STCB: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							STWR: return switch_loadstack_OBB_KFNB_1850_Flat_Steel; 
							CSTI: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;
							PIPE: return switch_loadstack_OBB_KFNB_1850_Flat_Steel;

							ENSP: return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							FMSP: return switch_loadstack_OBB_KFNB_1850_Flat_Box;
							MNSP: return switch_loadstack_OBB_KFNB_1850_Flat_Box;
