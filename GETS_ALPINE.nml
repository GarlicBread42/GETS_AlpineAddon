						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Am_843_REV, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);
							2 :return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Am_843_REV2, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 0, DISABLE_WAGON_POWER);
								1 .. 2 :return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
										
						switch (FEAT_TRAINS, PARENT, switch_FX_SBB_Am_843, vehicle_is_reversed) {
							0: switch_FX_SBB_Am_843_REV;
								switch_FX_SBB_Am_843_REV2;}	

						switch(FEAT_TRAINS, SELF, switch_length_SBB_Am_843, position_in_vehid_chain % 3) {
							0: 4;
							1: 3;
							2: 4;}
																											
						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Am_843, 1){
							return 1800;}

						switch(FEAT_TRAINS, SELF, switch_SBB_Am_843_graphics, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return random_choose_SBB_Am_843;
							2:	   spriteset_empty;}	
							
						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Am_843, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_AM_843; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							

item (FEAT_TRAINS , ITEM_SBB_AM_843, 2323)
