							1:     return switch_OBB_KFNB_IXa_Tender_build_year;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_KFNB_IXa_build, extra_callback_info1) {
							1: return ITEM_OBB_KFNB_IXA_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_KFNB_IXA_BUILD, 0050)
