item (FEAT_TRAINS , ITEM_SBB_ETR_610_CIS, 4530)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_ETR_610_CIS);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2007,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit:              [PASS, TOUR];
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);
						cargo_capacity:                 21 ;
						loading_speed:					3;
						cost_factor: 					108;
						running_cost_base:				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;

						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							250 km/h;
						refit_cost: 					0;
						track_type: 					ELRL;	
						power:  						7500 hp;
						weight: 						450 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.1;
						length: 						8;
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_SBB_ETR_610_CIS;
			additional_text					: string(STR_CONCAT_3, 
											  string(STR_GAUGE_STANDARD), 
											  string(STR_TRACTION_MULTISYS), 
											  string(STR_DESC_INTEX),);
			length							: switch_length_SBB_ETR_610;
			articulated_part				: switch_articulated_SBB_ETR_610_CIS;
			visual_effect_and_powered		: switch_FX_SBB_SBB_ETR_610;
			purchase						: spriteset_SBB_ETR_610_front_CIS_purchase;
			cost_factor						: 680;
			running_cost_factor				: switch_running_cost_SBB_ETR_610;			
			}
	}
