							 1868 .. 1908: switch_spritestack_OBB_KFNB_IXa_KFNB_roofed_purchase;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IXa_kkstb_purchase;					 					 
								switch_spritestack_OBB_KFNB_IXa_kkstb_purchase;}																				

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_IXa, motion_counter % 4) {
							0: spriteset_OBB_KFNB_IXa_anim1;
							1: spriteset_OBB_KFNB_IXa_anim2;
							2: spriteset_OBB_KFNB_IXa_anim3;
							3: spriteset_OBB_KFNB_IXa_anim4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IXa_KFNB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IXa_KFNB;
							1: return switch_animation_OBB_KFNB_IXa;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IXa_KFNB_roofed, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IXa_KFNB_roofed;
							1: return switch_animation_OBB_KFNB_IXa;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IXa_kkstb, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IXa_kkstb;
							1: return switch_animation_OBB_KFNB_IXa;}																											
							
						switch(FEAT_TRAINS, SELF, switch_length_OBB_KFNB_IXa, position_in_articulated_veh % 2) {
							0: 5;
							1: 4;}	

