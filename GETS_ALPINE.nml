item (FEAT_TRAINS , ITEM_MAIL_25, 3980)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_MAIL_25);
						climates_available: 			NO_CLIMATE;
						introduction_date: 				date(1600,01,01);
						model_life: 					99;
						vehicle_life: 					99;
						retire_early:					-10;						
						reliability_decay: 				20;
						cargo_allow_refit:				[MAIL, GOOD, VALU];
						loading_speed:					8;
