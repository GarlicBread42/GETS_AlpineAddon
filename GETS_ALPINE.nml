			PAPR: return switch_loadstack_RhB_Rw_Box;							
			
				switch_RhB_Rw_CC_Piece;}        

switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_Rw, 1){
    return 260;}

switch(FEAT_TRAINS, SELF, switch_length_RhB_Rw, position_in_vehid_chain % 2) {
    0: 4;
    1: 6;}													

switch(FEAT_TRAINS, SELF, switch_graphics_RhB_Rw, position_in_vehid_chain % 2) {
    0:	   spriteset_empty;
    1:     return switch_RhB_Rw_cargo_type;}
    
switch (FEAT_TRAINS, SELF, switch_articulated_RhB_Rw, extra_callback_info1) {
    1: return ITEM_RHB_RW; 
        return CB_RESULT_NO_MORE_ARTICULATED_PARTS;} 

item (FEAT_TRAINS , ITEM_RHB_RW, 5850)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_RW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1979,01,01);
						model_life: 					60;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_PIECE_GOODS );
						non_refittable_cargo_classes: 	bitmask(CC_EXPRESS,	CC_ARMOURED, CC_BULK, CC_LIQUID, CC_REFRIGERATED, CC_COVERED, CC_POWDERIZED);
						cargo_allow_refit:              [STAL, ALUM, STCB, STST, STSH, POWR, VENG, VPTS, GOOD, GLAS, ENSP, FMSP, STWR, STEL, STSE, PIPE, BDMT, WDPR, WOOD, MNSP, MPTS, PAPR,];
						cargo_disallow_refit: 			[LVST, FOOD, WATR, BEER, BOOM, FISH, IRON, EOIL, FERT, FICR, FRVG, FRUT, VEHI, ACID, NH3_, CHLO, O2__, RFPR, CBLK, CMNT,  ];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;					
						weight: 						16 ton;
						dual_headed: 					0;
						default_cargo_type:				WOOD;
						cargo_capacity:					21;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_graphics_RhB_Rw;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_GAUGE_NARROW), 
											  string(STR_DESC_GOODS),);
 			articulated_part				: switch_articulated_RhB_Rw;
            length							: switch_length_RhB_Rw;
			purchase						: spriteset_RhB_Rw_purchase;
			cost_factor						: 42;
			running_cost_factor				: switch_running_cost_RhB_Rw;
			colour_mapping					: switch_generic_recolour;
			 }
		}	                       
