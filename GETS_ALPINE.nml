						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIIb_KFNB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIIb_KFNB_purchase;
							1: spriteset_OBB_KFNB_IIIb_anim_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIIb_KFNB2_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIIb_KFNB2_purchase;
							1: spriteset_OBB_KFNB_IIIb_anim_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIIb_kkstb_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIIb_kkstb_purchase;
							1: spriteset_OBB_KFNB_IIIb_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIIb_purchase,current_year){
							    0 .. 1870: switch_spritestack_OBB_KFNB_IIIb_KFNB_purchase;
							 1871 .. 1908: switch_spritestack_OBB_KFNB_IIIb_KFNB2_purchase;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IIIb_kkstb_purchase;					 					 
								switch_spritestack_OBB_KFNB_IIIb_kkstb_purchase;}																				

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_IIIb, motion_counter % 4) {
							0: spriteset_OBB_KFNB_IIIb_anim1;
							1: spriteset_OBB_KFNB_IIIb_anim2;
							2: spriteset_OBB_KFNB_IIIb_anim3;
							3: spriteset_OBB_KFNB_IIIb_anim4;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIIb_KFNB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIIb_KFNB;
							1: return switch_animation_OBB_KFNB_IIIb;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIIb_KFNB2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIIb_KFNB2;
							1: return switch_animation_OBB_KFNB_IIIb;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IIIb_kkstb, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IIIb_kkstb;
							1: return switch_animation_OBB_KFNB_IIIb;}																											
							
						switch(FEAT_TRAINS, SELF, switch_length_OBB_KFNB_IIIb, position_in_articulated_veh % 2) {
							0: 5;
							1: 4;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_IIIb, 1){
							return 225;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_IIIb, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIIb_Loco_build_year,build_year){
							    0 .. 1870: switch_spritestack_OBB_KFNB_IIIb_KFNB;
							 1871 .. 1908: switch_spritestack_OBB_KFNB_IIIb_KFNB2;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IIIb_kkstb;					 					 
								switch_spritestack_OBB_KFNB_IIIb_kkstb;}	
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIIb_Tender_build_year,build_year){
							    0 .. 1870: spriteset_OBB_KFNB_IXa_Tender_KFNB;
							 1871 .. 1908: spriteset_OBB_KFNB_IXa_Tender_KFNB;	
							 1909 .. 2050: spriteset_OBB_KFNB_IXa_Tender_kkstb;					 					 
								spriteset_OBB_KFNB_IXa_Tender_kkstb;}																					   
							   
					switch(FEAT_TRAINS, SELF, switch_graphics_OBB_KFNB_IIIb_build, position_in_vehid_chain % 2) {
							0:	   return switch_OBB_KFNB_IIIb_Loco_build_year;
							1:     return switch_OBB_KFNB_IIIb_Tender_build_year;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_KFNB_IIIb_build, extra_callback_info1) {
							1: return ITEM_OBB_KFNB_IIIB_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_KFNB_IIIB_BUILD, 0033)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_IIIB_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1867,01,01);
						model_life: 					40;
						vehicle_life: 					50;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							60 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						350 hp;
						weight: 						38 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_graphics_OBB_KFNB_IIIb_build;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_PASS),);
			length						   : switch_length_OBB_KFNB_IIIb;
			articulated_part			   : switch_articulated_OBB_KFNB_IIIb_build;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_OBB_KFNB_IIIb_purchase;
			cost_factor					    :6;
			running_cost_factor				:switch_running_cost_OBB_KFNB_IIIb;
			visual_effect_and_powered		:switch_FX_OBB_KFNB_IIIb;
			
			}
	}


						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IIIb_Loco_current_year,current_year){
							    0 .. 1867: switch_spritestack_OBB_KFNB_IIIb_KFNB;
							 1868 .. 1908: switch_spritestack_OBB_KFNB_IIIb_KFNB2;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IIIb_kkstb;					 					 
								switch_spritestack_OBB_KFNB_IIIb_kkstb;}	
								
