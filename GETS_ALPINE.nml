						switch (FEAT_TRAINS, SELF, random_choose_SBB_RBe_540_Proto_ExSeetal, switch_alternative_var_random_bits(1, 1)) {
							1: switch_spritestack_SBB_RBe_540_Proto_ExSeetal_back;
								switch_spritestack_SBB_RBe_540_Proto_ExSeetal_front;}								

						switch (FEAT_TRAINS, SELF, random_choose_SBB_RBe_540_Proto_gruen, switch_alternative_var_random_bits(1, 1)) {
