									{ template_purchase(0, 0)}									
									
//Switches																	
							   									
						switch(FEAT_TRAINS, SELF, switch_BLS_Re_486_graphics, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     spriteset_BLS_Re_486;
							2:	   spriteset_empty;}								
					
						switch(FEAT_TRAINS, SELF, switch_length_BLS_Re_486, position_in_vehid_chain % 3) {
