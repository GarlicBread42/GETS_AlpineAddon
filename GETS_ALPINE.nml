						switch (FEAT_TRAINS,SELF, switch_SBB_EW2_D_purchase,build_year){
							   0 .. 1984: spriteset_SBB_EW2_D_gruen_purchase;
							1985 .. 1994: spriteset_SBB_EW2_D_Komfort_purchase;
							1995 .. 2050: spriteset_SBB_EW2_D_Papagei_purchase;
								spriteset_SBB_EW2_D_Papagei_purchase;}
								
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_D_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_D_gruen;
							1: spritegroup_SBB_EW2_D_gruen_loading;}						

						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_D_Komfort, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_D_Komfort;
							1: spritegroup_SBB_EW2_D_gruen_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_D_Papagei, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_D_Papagei;
							1: spritegroup_SBB_EW2_D_Papagei_loading;}		
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_D_gruenweiss, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_D_gruenweiss;
							1: spritegroup_SBB_EW2_D_gruenweiss_loading;}												
							   
						switch(FEAT_TRAINS, SELF, switch_length_SBB_EW2_D, position_in_articulated_veh % 3) {
							0: 4;
							1: 3;
							2: 4;}								

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_EW2_D, 1){
							return 1700;}
							
						switch (FEAT_TRAINS,SELF, switch_SBB_EW2_D_build_year,build_year){
							   0 .. 1984: switch_loadstack_SBB_EW2_D_gruen;
							1985 .. 1994: switch_loadstack_SBB_EW2_D_Komfort;
							1995 .. 2050: switch_loadstack_SBB_EW2_D_Papagei;
								switch_loadstack_SBB_EW2_D_Papagei;}
							
						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_EW2_D_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_SBB_EW2_D_build_year;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_EW2_D_build, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_EW2_D_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}							   												

																						
