//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_SBB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_SBB_purchase;
							1: spriteset_SBB_Aem_940_Pdown_purchase;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_Sersa_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_Sersa_purchase;
							1: spriteset_SBB_Aem_940_Pdown_purchase;}
							

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_SBB_Pup, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_SBB;
							1: spriteset_SBB_Aem_940_Pup;
							2: spriteset_SBB_Aem_940_light_front;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_SBB_Pup_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_SBB_REV;
							1: spriteset_SBB_Aem_940_Pup_REV;
							2: spriteset_SBB_Aem_940_light_back_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_SBB_Pdown, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_SBB;
							1: spriteset_SBB_Aem_940_Pdown;
							2: spriteset_SBB_Aem_940_light_front;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_SBB_Pdown_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_SBB_REV;
							1: spriteset_SBB_Aem_940_Pdown_REV;
							2: spriteset_SBB_Aem_940_light_back_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_Sersa_Pup, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_Sersa;
							1: spriteset_SBB_Aem_940_Pup;
							2: spriteset_SBB_Aem_940_light_front;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_Sersa_Pup_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_Sersa_REV;
							1: spriteset_SBB_Aem_940_Pup_REV;
							2: spriteset_SBB_Aem_940_light_back_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_Sersa_Pdown, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_Sersa;
							1: spriteset_SBB_Aem_940_Pdown;
							2: spriteset_SBB_Aem_940_light_front;}							

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Aem_940_Sersa_Pdown_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Aem_940_Sersa_REV;
							1: spriteset_SBB_Aem_940_Pdown_REV;
							2: spriteset_SBB_Aem_940_light_back_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_length_SBB_Aem_940, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}	
							
						switch (FEAT_TRAINS, SELF, switch_power_SBB_Aem_940, tile_powers_railtype("AC15")) {
							1: return 2720;
							return 1224;}						

						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Aem_940_ELRL, position_in_vehid_chain % 3) {
							    0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							1 ..2: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
							
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Aem_940_RAIL, position_in_vehid_chain % 3) {
							    0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
							1 ..2: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	
							
						switch (FEAT_TRAINS, SELF, switch_FX_SBB_Aem_940, tile_powers_railtype("ELRL")) {
							1: return switch_FX_SBB_Aem_940_ELRL;
								switch_FX_SBB_Aem_940_RAIL;}							

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Aem_940, tile_powers_railtype("AC15")){
							1: return 1075;
								return 1275;}	

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Aem_940_SBB_Pup, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Aem_940_SBB_Pup;
								switch_spritestack_SBB_Aem_940_SBB_Pup_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Aem_940_SBB_Pdown, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Aem_940_SBB_Pdown;
								switch_spritestack_SBB_Aem_940_SBB_Pdown_REV;}

						switch(FEAT_TRAINS,PARENT,switch_graphics_railtype_SBB_Aem_940, tile_powers_railtype("AC15")){
							1: return switch_reverse_SBB_Aem_940_SBB_Pup;
								return switch_reverse_SBB_Aem_940_SBB_Pdown;}

