			length							: switch_length_BLS_Re_486;
			articulated_part				: switch_articulated_BLS_Re_486;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_BLS_Re_486_purchase;
			cost_factor						: 244;
			running_cost_factor				: switch_running_cost_BLS_Re_486;
			visual_effect_and_powered		: switch_FX_BLS_Re_486;
			}
	}
