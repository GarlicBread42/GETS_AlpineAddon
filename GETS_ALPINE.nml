							0: spriteset_OBB_KFNB_Ib_KFNB;
							1: return switch_animation_OBB_KFNB_Ib;}			
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_Ib_kkstb, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_Ib_kkstb;
							1: return switch_animation_OBB_KFNB_Ib;}																											
							
						switch(FEAT_TRAINS, SELF, switch_length_OBB_KFNB_Ib, position_in_articulated_veh % 2) {
							0: 5;
							1: 4;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_Ib, 1){
							return 270;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_Ib, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_Ib_Loco_build_year,build_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_Ib_KFNB;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_Ib_kkstb;					 					 
								switch_spritestack_OBB_KFNB_Ib_kkstb;}	
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_Ib_Tender_build_year,build_year){
							    0 .. 1908: spriteset_OBB_KFNB_IXa_Tender_KFNB;	
							 1909 .. 2050: spriteset_OBB_KFNB_IXa_Tender_kkstb;					 					 
								spriteset_OBB_KFNB_IXa_Tender_kkstb;}																					   
							   
					switch(FEAT_TRAINS, SELF, switch_graphics_OBB_KFNB_Ib_build, position_in_vehid_chain % 2) {
							0:	   return switch_OBB_KFNB_Ib_Loco_build_year;
							1:     return switch_OBB_KFNB_Ib_Tender_build_year;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_KFNB_Ib_build, extra_callback_info1) {
							1: return ITEM_OBB_KFNB_IB_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_KFNB_IB_BUILD, 0003)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_IB_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1871,01,01);
						model_life: 					40;
						vehicle_life: 					50;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						343 hp;
						weight: 						60 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_graphics_OBB_KFNB_Ib_build;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
