							   0 .. 1980: spriteset_SBB_Re_420_green_old_purchase;
							1981 .. 1987: spriteset_SBB_Re_420_green_new_purchase;
							1988 .. 2010: spriteset_SBB_Re_420_red_purchase;
							2011 .. 2050: spriteset_SBB_Re_420_LION_purchase;
								spriteset_SBB_Re_420_LION_purchase;}									

						switch(FEAT_TRAINS, SELF, switch_length_SBB_Re_420, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
	
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Re_420, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}							

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Re_420, 1){
							return 3400;}

						switch (FEAT_TRAINS,PARENT,switch_enginecheck_SBB_Re_420_SwissEx1,(count_veh_id(6724))) {
							0: spriteset_SBB_Re_420_green_old; 
								spriteset_SBB_Re_420_SwissEx_old;}

						switch (FEAT_TRAINS,PARENT,switch_enginecheck_SBB_Re_420_SwissEx2,(count_veh_id(6724))) {
							0: spriteset_SBB_Re_420_green_new; 
								spriteset_SBB_Re_420_SwissEx_new;}

						switch(FEAT_TRAINS, SELF, switch_cargo_dependant_SBB_Re_420_era1, most_common_cargo_type){
							PASS: spriteset_SBB_Re_420_red;
							MAIL: spriteset_SBB_Re_420_red;
								spriteset_SBB_Re_420_Cargo_old;}

						switch(FEAT_TRAINS, SELF, switch_cargo_dependant_SBB_Re_420_era2, most_common_cargo_type){
							PASS: spriteset_SBB_Re_420_red;
							MAIL: spriteset_SBB_Re_420_red;
								spriteset_SBB_Re_420_Cargo_new;}
								
						switch(FEAT_TRAINS, SELF, switch_cargo_dependant_SBB_Re_420_era3, most_common_cargo_type){
							PASS: spriteset_SBB_Re_420_LION;
							MAIL: spriteset_SBB_Re_420_LION;
								spriteset_SBB_Re_420_Cargo_new;}								
																								
						switch (FEAT_TRAINS,SELF, switch_SBB_Re_420_build_year,build_year){
							   0 .. 1974: spriteset_SBB_Re_420_green_old;
							1975 .. 1980: switch_enginecheck_SBB_Re_420_SwissEx1;
							1981 .. 1987: switch_enginecheck_SBB_Re_420_SwissEx2;
							1988 .. 1999: spriteset_SBB_Re_420_red;
							2000 .. 2007: switch_cargo_dependant_SBB_Re_420_era1;
							2008 .. 2010: switch_cargo_dependant_SBB_Re_420_era2;
							2011 .. 2050: switch_cargo_dependant_SBB_Re_420_era3;
								switch_cargo_dependant_SBB_Re_420_era3;}

					switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Re_420_build, position_in_vehid_chain % 2) {
						0:	   spriteset_empty;
						1:     return switch_SBB_Re_420_build_year;}

					switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Re_420_build, extra_callback_info1) {
						1: return ITEM_SBB_RE_420_BUILD; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


item (FEAT_TRAINS , ITEM_SBB_RE_420_BUILD, 1606)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_RE_420_BUILD);					
