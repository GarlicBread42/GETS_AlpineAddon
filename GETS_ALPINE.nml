			articulated_part				:switch_articulated_BLS_Re_420;
			purchase_cargo_capacity		    :0 ;
			cargo_capacity	                :return 0 ;
			purchase						:switch_spritestack_BLS_Re_420_purchase;
			cost_factor						:61;
			running_cost_factor				:switch_running_cost_BLS_Re_420;			
			visual_effect_and_powered		:switch_1818_FX_check_EW3;	
			}
	}	
