						   11:	   spriteset_empty;							
						   12:	   spriteset_empty;
						   13:	   return switch_reverse_SBB_RABe_511_6_middle4_SBZ;
						   14:	   spriteset_empty;							
						   15:	   spriteset_empty;
						   16:	   return switch_reverse_SBB_RABe_511_6_back_SBZ;
						   17:	   spriteset_empty;}
						   
						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_RABe_511_6_SBZ, extra_callback_info1) {
							1 .. 17: return ITEM_SBB_RABE_511_6_SBZ; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

