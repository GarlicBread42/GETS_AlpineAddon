//Switches

						switch (FEAT_TRAINS, SELF, switch_purchase_OBB_Eurofima, current_year){
							1900 .. 1986 : spriteset_OBB_Eurofima_B1_orange_purchase;
							1987 .. 2007 : spriteset_OBB_Eurofima_B1_rot_purchase;
							2008 .. 2100 : spriteset_OBB_Eurofima_B1_grau_purchase;														
								spriteset_OBB_Eurofima_B1_grau_purchase;}	

						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_A_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_A_orange;
							1: spritegroup_OBB_Eurofima_loading_orange;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_AB_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_AB_orange;
							1: spritegroup_OBB_Eurofima_loading_orange;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_B1_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_B1_orange;
							1: spritegroup_OBB_Eurofima_loading_orange;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_B2_orange, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_B2_orange;
							1: spritegroup_OBB_Eurofima_loading_orange;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_A_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_A_rot;
