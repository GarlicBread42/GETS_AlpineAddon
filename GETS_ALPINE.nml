							0: spriteset_OBB_KFNB_IXa_kkstb_purchase;
							1: spriteset_OBB_KFNB_IXa_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IXa_purchase,current_year){
