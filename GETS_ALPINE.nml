							0: spriteset_OBB_Rh_4746_front_purchase;
							1: spriteset_OBB_Rh_4744_front_panto_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_4746_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_4746_front;
							1: spritegroup_OBB_Rh_4746_front_loading;
							2: spriteset_OBB_Rh_4744_front_lights_front;
							3: spriteset_OBB_Rh_4744_front_panto_up;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_4746_front_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_4746_front_REV;
							1: spritegroup_OBB_Rh_4746_front_loading_REV;
							2: spriteset_OBB_Rh_4744_front_lights_back_REV;
							3: spriteset_OBB_Rh_4744_front_panto_up_REV;}																

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_4746_middle, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_4746_middle;
							1: spritegroup_OBB_Rh_4746_middle_loading;}	

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_4746_middle_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_4746_middle_REV;
							1: spritegroup_OBB_Rh_4746_middle_loading_REV;}

						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_4746_back, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_4746_back;
							1: spritegroup_OBB_Rh_4746_back_loading;
							2: spriteset_OBB_Rh_4744_back_lights_back;}								

						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_4746_back_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_4746_back_REV;
							1: spritegroup_OBB_Rh_4746_back_loading_REV;
							2: spriteset_OBB_Rh_4744_back_lights_front_REV;}
							
						switch(FEAT_TRAINS, SELF, switch_length_OBB_4746, position_in_vehid_chain % 9) {
							0: 4;
							1: 6;
							2: 4;
							3: 4;
							4: 6;
							5: 4;
							6: 4;
							7: 6;
							8: 4;}	
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_4746_NONREV, position_in_vehid_chain % 9) {
								0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
								1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
								2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);	
					       3 .. 8: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}							

						switch(FEAT_TRAINS, SELF, switch_FX_OBB_4746_REV, position_in_vehid_chain % 9) {
						   0 .. 5: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
								6: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);
								7: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);	
							    8: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
							
						switch (FEAT_TRAINS, PARENT, switch_FX_OBB_4746, vehicle_is_reversed) {
							0: switch_FX_OBB_4746_NONREV;
								switch_FX_OBB_4746_REV;}
								
						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_4746, 1){
							return 2650;}
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_4746_front, vehicle_is_reversed) {
							0: switch_loadstack_OBB_4746_front;
								switch_loadstack_OBB_4746_back_REV;}																

						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_4746_middle, vehicle_is_reversed) {
							0: switch_spritestack_OBB_4746_middle;
								switch_spritestack_OBB_4746_middle_REV;}
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_4746_back, vehicle_is_reversed) {
							0: switch_loadstack_OBB_4746_back;
								switch_loadstack_OBB_4746_front_REV;}								

						switch(FEAT_TRAINS, SELF, switch_graphics_OBB_4746, position_in_vehid_chain % 9) {
							0:	   spriteset_empty;
							1:     return switch_reverse_OBB_4746_front;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_reverse_OBB_4746_middle;
							5:	   spriteset_empty;
							6:	   spriteset_empty;
							7:	   return switch_reverse_OBB_4746_back;
							8:	   spriteset_empty;}
						   
						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_4746, extra_callback_info1) {
							1 .. 8: return ITEM_OBB_4746; 
							return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

