						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_RABe_511_6_SBZ, position_in_vehid_chain % 18) {
							0:	   spriteset_empty;
							1:     return switch_reverse_SBB_RABe_511_6_front_SBZ;
							2:     spriteset_empty;
							3:	   spriteset_empty;
							4:	   return switch_reverse_SBB_RABe_511_6_middle1_SBZ;
							5:	   spriteset_empty;
							6:	   spriteset_empty;
