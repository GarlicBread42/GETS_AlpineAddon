							0: spriteset_SBB_RBe_540_base_back;
							1: spriteset_SBB_RBe_540_Serie_rot_back;
							2: spritegroup_SBB_RBe_540_loading_old;
							3: switch_spritechoose_SBB_RBe_540_plug_red_front;
							4: switch_spritechoose_SBB_RBe_540_lights_back_old;
							5: switch_spritechoose_SBB_RBe_540_lights_front_old;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_RBe_540_Serie_rot_front, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 5 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_RBe_540_base_front;
							1: spriteset_SBB_RBe_540_Serie_rot_front;
