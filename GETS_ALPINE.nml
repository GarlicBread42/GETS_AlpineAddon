							0: spriteset_OBB_KFNB_Ib2_kkstb;
							1: return switch_animation_OBB_KFNB_Ib2;}																											
							
						switch(FEAT_TRAINS, SELF, switch_length_OBB_KFNB_Ib2, position_in_articulated_veh % 2) {
							0: 5;
							1: 4;}	

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_Ib2, 1){
							return 270;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_Ib2, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_Ib2_Loco_build_year,build_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_Ib2_KFNB;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_Ib2_kkstb;					 					 
