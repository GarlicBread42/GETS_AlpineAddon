							0: spriteset_SBB_Bm_840_Stauffer_REV;
							1: spriteset_SBB_Bm_840_lights_new_back_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Bm_840_braun, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Bm_840_braun;
								switch_spritestack_SBB_Bm_840_braun_REV;}							
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Bm_840_rot, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Bm_840_rot;
								switch_spritestack_SBB_Bm_840_rot_REV;}	
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Bm_840_Marti, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Bm_840_Marti;
								switch_spritestack_SBB_Bm_840_Marti_REV;}		
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Bm_840_Mueller, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Bm_840_Mueller;
								switch_spritestack_SBB_Bm_840_Mueller_REV;}	
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Bm_840_SRT, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Bm_840_SRT;
								switch_spritestack_SBB_Bm_840_SRT_REV;}		
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_SBB_Bm_840_Stauffer, vehicle_is_reversed) {
							0: switch_spritestack_SBB_Bm_840_Stauffer;
								switch_spritestack_SBB_Bm_840_Stauffer_REV;}																																											
																				
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Bm_840_REV, position_in_vehid_chain % 1) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, -2, DISABLE_WAGON_POWER);}
						
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Bm_840_REV2, position_in_vehid_chain % 1) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);}		
										
						switch (FEAT_TRAINS, PARENT, switch_FX_SBB_Bm_840, vehicle_is_reversed) {
							0: switch_FX_SBB_Bm_840_REV;
								switch_FX_SBB_Bm_840_REV2;}	
																					
						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Bm_840, 1){
							return 550;}

						switch(FEAT_TRAINS,SELF, switch_graphics_SBB_Bm_840_build_year, build_year){
							   0 .. 1983: return switch_reverse_SBB_Bm_840_braun;
							1984 .. 2013: return switch_reverse_SBB_Bm_840_rot;
								return switch_reverse_SBB_Bm_840_rot;}								

item (FEAT_TRAINS , ITEM_SBB_BM_840_BUILD, 2353)
		{
		property 
			{
			//common properties
						name: 							string(STR_NAME_BM_840_BUILD);
						climates_available: 			ALL_CLIMATES;
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);						
						introduction_date: 				date(1960,01,01);
						model_life: 					50;
						vehicle_life: 					50;
						retire_early: 					-10;	
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							75 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						843 hp;
						weight: 						72 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_DIESEL;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.296;
						length: 						8;										
			}

		graphics
			{
			default							:switch_graphics_SBB_Bm_840_build_year;
			additional_text				    :string(STR_CONCAT_3, 
											 string(STR_GAUGE_STANDARD),
											 string(STR_TRACTION_DIESEL), 
											 string(STR_DESC_SHUNT),);
			purchase_cargo_capacity        	:0 ;
			cost_factor						:14;
			cargo_capacity                 	:return 0 ;
			purchase					   	:switch_purchase_SBB_Bm_840;
			running_cost_factor				:switch_running_cost_SBB_Bm_840;
			visual_effect_and_powered		:switch_FX_SBB_Bm_840;
			
			}
	}	

						switch(FEAT_TRAINS,SELF, switch_graphics_SBB_Bm_840_current_year, current_year){
							   0 .. 1983: return switch_reverse_SBB_Bm_840_braun;
							1984 .. 2013: return switch_reverse_SBB_Bm_840_rot;
								return switch_reverse_SBB_Bm_840_rot;}	

