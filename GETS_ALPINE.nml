						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_B1_grau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_B1_grau;
							1: spritegroup_OBB_Eurofima_loading_grau;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_OBB_Eurofima_B2_grau, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Eurofima_B2_grau;
							1: spritegroup_OBB_Eurofima_loading_grau;}																										

						switch (FEAT_TRAINS, SELF, random_choose_OBB_Eurofima_orange, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_OBB_Eurofima_A_orange;
							2: switch_loadstack_OBB_Eurofima_AB_orange;
							3: switch_loadstack_OBB_Eurofima_B1_orange;
							   switch_loadstack_OBB_Eurofima_B2_orange;}

						switch (FEAT_TRAINS, SELF, random_choose_OBB_Eurofima_rot, switch_alternative_var_random_bits(1, 2)) {
							1: switch_loadstack_OBB_Eurofima_A_rot;
							2: switch_loadstack_OBB_Eurofima_AB_rot;
							3: switch_loadstack_OBB_Eurofima_B1_rot;
							   switch_loadstack_OBB_Eurofima_B2_rot;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_OBB_Eurofima_grau, switch_alternative_var_random_bits(1, 3)) {
							1: switch_loadstack_OBB_Eurofima_A1_grau;
							2: switch_loadstack_OBB_Eurofima_AB_grau;
							3: switch_loadstack_OBB_Eurofima_B1_grau;
							4: switch_loadstack_OBB_Eurofima_B2_grau;
							5: switch_loadstack_OBB_Eurofima_A2_grau;
							6: switch_loadstack_OBB_Eurofima_AB_grau;
							7: switch_loadstack_OBB_Eurofima_B1_grau;							
							   switch_loadstack_OBB_Eurofima_B2_grau;}							   

					switch (FEAT_TRAINS,SELF,switch_build_year_OBB_Eurofima,build_year) {
							1900 .. 1986 : random_choose_OBB_Eurofima_orange;
							1987 .. 2007 : random_choose_OBB_Eurofima_rot;
							2008 .. 2100 : random_choose_OBB_Eurofima_grau;														
								random_choose_OBB_Eurofima_grau;}
						
						switch (FEAT_TRAINS,SELF,switch_current_year_OBB_Eurofima,current_year) {
							1900 .. 1986 : random_choose_OBB_Eurofima_orange;
							1987 .. 2007 : random_choose_OBB_Eurofima_rot;
							2008 .. 2100 : random_choose_OBB_Eurofima_grau;														
								random_choose_OBB_Eurofima_grau;}	   								
					
						switch(FEAT_TRAINS, SELF, switch_length_OBB_Eurofima, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}	

						switch (FEAT_TRAINS, PARENT, switch_running_cost_OBB_Eurofima,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 2650;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_OBB_Eurofima,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}								
							
						switch(FEAT_TRAINS, SELF, switch_OBB_Eurofima_graphics_build, position_in_articulated_veh  % 3) {
							0:     spriteset_empty;
							1:     return switch_build_year_OBB_Eurofima;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Eurofima_build, extra_callback_info1) {
							1 .. 2: return ITEM_OBB_EUROFIMA_BUILD;												
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_EUROFIMA_BUILD, 6457)
