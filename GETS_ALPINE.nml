						0: 4;
						1: 6;}		
						
					switch(FEAT_TRAINS, SELF, switch_FX_BLS_Re_425, position_in_vehid_chain % 2) {
						0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						 return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}													

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BLS_Re_425, 1){
							return 4025;}
								
						switch (FEAT_TRAINS,SELF, switch_BLS_Re_425_build_year,build_year){
							   0 .. 1981: return random_choose_BLS_Re_425_Schere;
							1982 .. 2050: return random_choose_BLS_Re_425_all;
								random_choose_BLS_Re_425_all;}
								
					switch(FEAT_TRAINS, SELF, switch_graphics_BLS_Re_425, position_in_vehid_chain % 2) {
						0:	   spriteset_empty;
						1:     return switch_BLS_Re_425_build_year;}

					switch (FEAT_TRAINS, SELF, switch_articulated_BLS_Re_425, extra_callback_info1) {
						1: return ITEM_BLS_RE_425; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


item (FEAT_TRAINS , ITEM_BLS_RE_425, 1817)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_RE_425);					
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1964,01,01);
						model_life: 					50;
						vehicle_life: 					50;
						retire_early: 					-10;							
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							140 km/h;
						refit_cost: 					0;
						track_type: 					AC15;
						power:  						6770 hp;
						weight: 						80 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.393;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							:switch_graphics_BLS_Re_425;
			additional_text					:string(STR_CONCAT_3, 
											 string(STR_GAUGE_STANDARD), 
											 string(STR_TRACTION_ELECTRIC), 
											 string(STR_DESC_UNIVERSAL),);
			length							:switch_length_BLS_Re_425;
			articulated_part				:switch_articulated_BLS_Re_425;
			purchase_cargo_capacity		    :0 ;
			cargo_capacity	                :return 0 ;
			purchase						:spriteset_BLS_Re_425_purchase;
			cost_factor						:180;
			running_cost_factor				:switch_running_cost_BLS_Re_425;			
			visual_effect_and_powered		:switch_FX_BLS_Re_425;	
			}
	}	
