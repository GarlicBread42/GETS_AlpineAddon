							0: spriteset_OBB_KFNB_Ib_kkstb_purchase;
							1: spriteset_OBB_KFNB_Ib_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_Ib_purchase,current_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_Ib_KFNB_purchase;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_Ib_kkstb_purchase;					 					 
								switch_spritestack_OBB_KFNB_Ib_kkstb_purchase;}																				

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_Ib, motion_counter % 4) {
							0: spriteset_OBB_KFNB_Ib_anim1;
							1: spriteset_OBB_KFNB_Ib_anim2;
							2: spriteset_OBB_KFNB_Ib_anim3;
							3: spriteset_OBB_KFNB_Ib_anim4;}
							
