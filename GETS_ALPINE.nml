		alternative_sprites (spriteset_OBB_Eurofima_BD_grau, ZOOM_LEVEL_IN_4X, BIT_DEPTH_32BPP, "gfx/OBB_Eurofima_BD/OBB_Eurofima_BD_grau_4x_32bpp.png", "gfx/OBB_Eurofima_BD/OBB_Eurofima_BD_grau_4x_mask.png")
					{template_158trains_4x(0,0)}
					
