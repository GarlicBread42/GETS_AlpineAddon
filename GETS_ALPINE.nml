//Switches									

						switch (FEAT_TRAINS,SELF,switch_purchase_OBB_Rh_1016,current_year) {
							   0 .. 2002 : spriteset_OBB_Rh_1016_Pflatsch_purchase;
							2003 .. 2050 : spriteset_OBB_Rh_1016_Wort_purchase;
								spriteset_OBB_Rh_1016_Wort_purchase;}																

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_Rh_1016_Pflatsch, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_Rh_1016_Pflatsch;
							1: spriteset_OBB_Rh_1016_lights_front;
							2: spriteset_OBB_Rh_1016_lights_back;
							3: spriteset_OBB_Rh_1016_panto_back_up;}

