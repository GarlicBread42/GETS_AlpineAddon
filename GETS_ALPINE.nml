spriteset (spriteset_RhB_Fac_RhB_870x_purchase, "gfx\RhB_Fac/RhB_Fac_RhB-870x_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_RhB_Fac_RhB_870x_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\RhB_Fac/RhB_Fac_RhB-870x_1x_32bpp.png", "gfx\RhB_Fac/RhB_Fac_RhB-870x_1x_mask.png")
					{template_purchase(0, 0)}	

spriteset (spriteset_RhB_Fac_RhB_xxx1_purchase, "gfx\RhB_Fac/RhB_Fac_RhB-xxx1_1x_8bpp.png")
					{template_purchase(0, 0)}	
		alternative_sprites (spriteset_RhB_Fac_RhB_xxx1_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx\RhB_Fac/RhB_Fac_RhB-xxx1_1x_32bpp.png", "gfx\RhB_Fac/RhB_Fac_RhB-xxx1_1x_mask.png")
					{template_purchase(0, 0)}					
					
//Switches

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base_purchase;
        1: spriteset_RhB_Fac_RhB_870x_purchase;
        2: spriteset_RhB_Fac_RhB_xxx1_purchase;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_brown_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_brown_purchase;
        1: spriteset_RhB_Fac_RhB_870x_purchase;
        2: spriteset_RhB_Fac_RhB_xxx1_purchase;}

    switch (FEAT_TRAINS,SELF, switch_RhB_Fac_purchase,current_year){
           0 .. 1999: switch_spritestack_RhB_Fac_brown_purchase;
        2000 .. 2050: switch_spritestack_RhB_Fac_base_purchase;				 					 
        switch_spritestack_RhB_Fac_base_purchase;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit1_uneven, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_871x;
        2: spriteset_RhB_Fac_RhB_873x;
        3: spriteset_RhB_Fac_RhB_875x;
        4: spriteset_RhB_Fac_RhB_877x;
        5: spriteset_RhB_Fac_RhB_871x;
        6: spriteset_RhB_Fac_RhB_873x;
        7: spriteset_RhB_Fac_RhB_875x;
            spriteset_RhB_Fac_RhB_877x;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit1_even, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_870x;
        2: spriteset_RhB_Fac_RhB_872x;
        3: spriteset_RhB_Fac_RhB_874x;
        4: spriteset_RhB_Fac_RhB_876x;
        5: spriteset_RhB_Fac_RhB_870x;
        6: spriteset_RhB_Fac_RhB_872x;
        7: spriteset_RhB_Fac_RhB_874x;
            spriteset_RhB_Fac_RhB_876x;}

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit2_uneven, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_xxx1;
        2: spriteset_RhB_Fac_RhB_xxx3;
        3: spriteset_RhB_Fac_RhB_xxx5;
        4: spriteset_RhB_Fac_RhB_xxx7;
        5: spriteset_RhB_Fac_RhB_xxx9;
        6: spriteset_RhB_Fac_RhB_xxx7;
        7: spriteset_RhB_Fac_RhB_xxx5;
            spriteset_RhB_Fac_RhB_xxx3;}            

    switch (FEAT_TRAINS, SELF, random_choose_RhB_Fac_numbers_digit2_even, switch_alternative_var_random_bits(1, 3)) {
        1: spriteset_RhB_Fac_RhB_xxx2;
        2: spriteset_RhB_Fac_RhB_xxx4;
        3: spriteset_RhB_Fac_RhB_xxx6;
        4: spriteset_RhB_Fac_RhB_xxx8;
        5: spriteset_RhB_Fac_RhB_xxx6;
        6: spriteset_RhB_Fac_RhB_xxx4;
        7: spriteset_RhB_Fac_RhB_xxx2;
            spriteset_RhB_Fac_RhB_xxx6;}              

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_uneven;
        2: return random_choose_RhB_Fac_numbers_digit2_uneven;
        3: spritegroup_RhB_Fac_load;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_uneven;
        2: return random_choose_RhB_Fac_numbers_digit2_even;
        3: spritegroup_RhB_Fac_load;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_even;
        2: return random_choose_RhB_Fac_numbers_digit2_uneven;
        3: spritegroup_RhB_Fac_load;}              

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_base_Var4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_base;
        1: return random_choose_RhB_Fac_numbers_digit1_even;
        2: return random_choose_RhB_Fac_numbers_digit2_even;
        3: spritegroup_RhB_Fac_load;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_brown_Var1, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_brown;
        1: return random_choose_RhB_Fac_numbers_digit1_uneven;
        2: return random_choose_RhB_Fac_numbers_digit2_uneven;
        3: spritegroup_RhB_Fac_load;}

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_brown_Var2, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_brown;
        1: return random_choose_RhB_Fac_numbers_digit1_uneven;
        2: return random_choose_RhB_Fac_numbers_digit2_even;
        3: spritegroup_RhB_Fac_load;}  

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_brown_Var3, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_brown;
        1: return random_choose_RhB_Fac_numbers_digit1_even;
        2: return random_choose_RhB_Fac_numbers_digit2_uneven;
        3: spritegroup_RhB_Fac_load;}              

    switch(FEAT_TRAINS, SELF, switch_spritestack_RhB_Fac_brown_Var4, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
        0: spriteset_RhB_Fac_brown;
        1: return random_choose_RhB_Fac_numbers_digit1_even;
        2: return random_choose_RhB_Fac_numbers_digit2_even;
        3: spritegroup_RhB_Fac_load;}  

    switch(FEAT_TRAINS, SELF, switch_position_RhB_Fac_base, position_in_vehid_chain) {
        1: return switch_spritestack_RhB_Fac_base_Var1;
        2: return switch_spritestack_RhB_Fac_base_Var3;
        3: return switch_spritestack_RhB_Fac_base_Var2;
        4: return switch_spritestack_RhB_Fac_base_Var4;
        5: return switch_spritestack_RhB_Fac_base_Var2;
        6: return switch_spritestack_RhB_Fac_base_Var3;
        7: return switch_spritestack_RhB_Fac_base_Var1;
        8: return switch_spritestack_RhB_Fac_base_Var4;
            default: switch_spritestack_RhB_Fac_base_Var3;}               

    switch(FEAT_TRAINS, SELF, switch_position_RhB_Fac_brown, position_in_vehid_chain) {
        1: return switch_spritestack_RhB_Fac_brown_Var1;
        2: return switch_spritestack_RhB_Fac_brown_Var3;
        3: return switch_spritestack_RhB_Fac_brown_Var2;
        4: return switch_spritestack_RhB_Fac_brown_Var4;
        5: return switch_spritestack_RhB_Fac_brown_Var2;
        6: return switch_spritestack_RhB_Fac_brown_Var3;
        7: return switch_spritestack_RhB_Fac_brown_Var1;
        8: return switch_spritestack_RhB_Fac_brown_Var4;
            default: switch_spritestack_RhB_Fac_brown_Var3;}    

    switch (FEAT_TRAINS,SELF, switch_RhB_Fac_current_year,current_year){
           0 .. 1999: switch_position_RhB_Fac_brown;
        2000 .. 2050: switch_position_RhB_Fac_base;				 					 
        switch_position_RhB_Fac_base;}

    switch(FEAT_TRAINS,PARENT,switch_running_cost_RhB_Fac, 1){
        return 175;}
						
item (FEAT_TRAINS , ITEM_RHB_FAC, 5900)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_RHB_FAC);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1993,01,01);
						model_life: 					33;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes: 		bitmask(CC_BULK);
						cargo_allow_refit:              [COAL, IORE, CORE, COKE, AORE, CLAY, FECR, GRVL, KAOL, LIME, PHOS, PORE, POTA, SAND, SULP, URAN, CASS, MNO2, NICK, NITR, NKOR, QLME, RCYC, SALT, SASH, SLAG, TOFF, GRAI, WHEA, FRUT, MAIZ, BEAN, SUGR,];
						cargo_disallow_refit: 			[BDMT, CMNT, FERT, FICR, RCYC, SALT, SCMT, SCRP, PEAT, BEAN, SUGR, SGBT, SGCN, TWOD, WDPR,];
						misc_flags: 					bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_SPRITE_STACK);
						loading_speed:					10;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							80 km/h;
						refit_cost: 					0;
						track_type: 					NGRL;							
						weight: 						15 ton;
						dual_headed: 					0;
						default_cargo_type:				IORE;
						cargo_capacity:					33;
						ai_engine_rank: 				0;
						length: 						8;
												
			}
			
	//Vehicels Graphics
			graphics
			{
			default							: switch_RhB_Fac_current_year;
			additional_text					: string(STR_CONCAT_2, 
											  string(STR_GAUGE_NARROW), 
											  string(STR_DESC_GOODS),);
			purchase						: switch_RhB_Fac_purchase;
			cost_factor						: 75;
			running_cost_factor				: switch_running_cost_RhB_Fac;				
			colour_mapping					: switch_generic_recolour;
			 }
		}

