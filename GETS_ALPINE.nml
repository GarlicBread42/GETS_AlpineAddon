						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_DZ2_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_DZ2_gruen;
							1: spritegroup_BLS_DZ2_gruen_loading;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BLS_DZ2_gruen, 1){
							return 1250;}

item (FEAT_TRAINS , ITEM_BLS_DZ2, 7767)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_BLS_DZ2);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1966,01,01);
						model_life: 					VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					40;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_MAIL);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[MAIL, GOOD, VALU];
						loading_speed:					5;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							125 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						20 ton;
						dual_headed: 					0;
						default_cargo_type:				MAIL;
						cargo_capacity:					108;
						ai_engine_rank: 				0;
						length: 						8;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: switch_spritestack_BLS_DZ2_gruen;
			additional_text					: string(STR_CONCAT_2,
											  string(STR_GAUGE_STANDARD),
											  string(STR_DESC_BAGG_EXP),);
			purchase						: spriteset_BLS_DZ2_gruen_purchase;
			cost_factor						: 410;
			running_cost_factor				: switch_running_cost_BLS_DZ2_gruen;
			purchase_running_cost_factor	: 1950;
			}
		}
