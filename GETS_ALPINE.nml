							2:	   spriteset_empty;}									

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Vectron_SBBC, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_VECTRON_SBBC;				
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
														
item (FEAT_TRAINS , ITEM_SBB_VECTRON_SBBC, 1770)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_SBB_VECTRON_SBBC);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(2017,01,01);
						model_life:						VEHICLE_NEVER_EXPIRES;
						vehicle_life: 					30;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
						track_type: 					ELEC;
						power:  						8704 hp;
						weight: 						87 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_ELECTRIC;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.345;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default							: switch_SBB_Vectron_graphics_SBBC;
			additional_text					: string(STR_CONCAT_3, 
											  string(STR_GAUGE_STANDARD), 
											  string(STR_TRACTION_MULTISYS), 
											  string(STR_DESC_UNIVERSAL),);
			length							: switch_length_SBB_Vectron;
			articulated_part				: switch_articulated_SBB_Vectron_SBBC;
			purchase_cargo_capacity		    : 0 ;
			cargo_capacity	                : return 0 ;
			purchase						: spriteset_SBB_Vectron_Blue_purchase;
			cost_factor						: 314;
			running_cost_factor				: switch_running_cost_SBB_Vectron;
			visual_effect_and_powered		: switch_FX_SBB_Vectron;
			}
	}	


