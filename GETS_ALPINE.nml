							return 225;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_IXa, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}		
								
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IXa_Loco_build_year,build_year){
							    0 .. 1867: switch_spritestack_OBB_KFNB_IXa_KFNB;
							 1868 .. 1908: switch_spritestack_OBB_KFNB_IXa_KFNB_roofed;	
