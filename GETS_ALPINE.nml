								spriteset_SBB_Re_446_rot_purchase;}									

						switch(FEAT_TRAINS, SELF, switch_length_SBB_Re_446, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
	
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Re_446, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}							

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Re_446, 1){
							return 3700;}

						switch (FEAT_TRAINS, SELF, random_choose_SBB_Re_446, switch_alternative_var_random_bits(1, 2)) {
							1: spriteset_SBB_Re_446_silber;
							2: spriteset_SBB_Re_446_10103;
							3: spriteset_SBB_Re_446_10104;
							   spriteset_SBB_Re_446_grau;}	
					
																								
						switch (FEAT_TRAINS,SELF, switch_SBB_Re_446_build_year,build_year){
							   0 .. 1985: return random_choose_SBB_Re_446;
							1986 .. 1992: spriteset_SBB_Re_446_Bahn_2000;
							1993 .. 2050: spriteset_SBB_Re_446_rot;
								spriteset_SBB_Re_446_rot;}

					switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Re_446_build, position_in_vehid_chain % 2) {
						0:	   spriteset_empty;
						1:     return switch_SBB_Re_446_build_year;}

