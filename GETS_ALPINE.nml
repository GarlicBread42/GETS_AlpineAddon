    switch(FEAT_TRAINS,SELF, switch_purchase_SBB_BDe_577_CJ, current_year){
           0 .. 1979: spriteset_SBB_BDe_577_CJ_creme_purchase;
        1980 .. 1994: spriteset_SBB_BDe_577_CJ_red_101_purchase;
