//Switches

						 switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1044_purchase,current_year){
							   0 .. 1979: spriteset_OBB_Rh_1044_orange_purchase;
							1980 .. 1982: spriteset_OBB_Rh_1044_orange_mod_purchase;
							1983 .. 1989: spriteset_OBB_Rh_1044_Valousek_purchase;	
							1990 .. 2007: spriteset_OBB_Rh_1044_rot_purchase;
							2008 .. 2050: spriteset_OBB_Rh_1044_rot_Wort_purchase;				 					 
										spriteset_OBB_Rh_1044_rot_Wort_purchase;}							

						switch (FEAT_TRAINS, SELF, random_choose_OBB_Rh_1044_orange, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_OBB_Rh_1044_orange;
							   spriteset_OBB_Rh_1044_orange_grey;}
							   
						switch (FEAT_TRAINS, SELF, random_choose_OBB_Rh_1044_orange_mod, switch_alternative_var_random_bits(1, 2)) {
							1: spriteset_OBB_Rh_1044_orange;
							2: spriteset_OBB_Rh_1044_orange_mod;
							3: spriteset_OBB_Rh_1044_orange_grey;
							   spriteset_OBB_Rh_1044_orange_grey_mod;}	
							   
						switch (FEAT_TRAINS, SELF, random_choose_OBB_Rh_1044_rot, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_OBB_Rh_1044_rot;
							   spriteset_OBB_Rh_1044_rot_mod;}		
							   
						switch (FEAT_TRAINS, SELF, random_choose_OBB_Rh_1044_rot_Wort, switch_alternative_var_random_bits(1, 1)) {
							1: spriteset_OBB_Rh_1044_rot_mod_Wort;
							   spriteset_OBB_Rh_1044_rot_Wort;}								   					   						   
							   							
						switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1044_build_year,build_year){
							   0 .. 1979: random_choose_OBB_Rh_1044_orange;
							1980 .. 1982: random_choose_OBB_Rh_1044_orange_mod;
							1983 .. 1989: spriteset_OBB_Rh_1044_Valousek;	
							1990 .. 2007: random_choose_OBB_Rh_1044_rot;
							2008 .. 2050: random_choose_OBB_Rh_1044_rot_Wort;
										random_choose_OBB_Rh_1044_rot_Wort;}	
							
						switch (FEAT_TRAINS,SELF, switch_OBB_Rh_1044_current_year,current_year){
							   0 .. 1979: random_choose_OBB_Rh_1044_orange;
							1980 .. 1982: random_choose_OBB_Rh_1044_orange_mod;
							1983 .. 1989: spriteset_OBB_Rh_1044_Valousek;	
							1990 .. 2007: random_choose_OBB_Rh_1044_rot;
							2008 .. 2050: random_choose_OBB_Rh_1044_rot_Wort;
										random_choose_OBB_Rh_1044_rot_Wort;}						
					
						switch(FEAT_TRAINS, SELF, switch_length_OBB_Rh_1044, position_in_vehid_chain % 2) {
							0: 4;
							1: 6;}
						
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_Rh_1044, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
							return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_Rh_1044, 1){
							return 3800;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_Rh_1044_501, 1){
							return 5500;}
						
						switch(FEAT_TRAINS, SELF, switch_OBB_Rh_1044_graphics_build, position_in_vehid_chain % 2) {
							0:	   spriteset_empty;
							1:     switch_OBB_Rh_1044_build_year;}	

						switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Rh_1044_build, extra_callback_info1) {
							1: return ITEM_OBB_RH_1044_BUILD;
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}
																			
item (FEAT_TRAINS , ITEM_OBB_RH_1044_BUILD, 1120)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_RH_1044_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						engine_class: 					ENGINE_CLASS_ELECTRIC;						
						introduction_date: 				date(1976,01,01);
						model_life:						40;
						vehicle_life: 					40;
						retire_early: 					-10;							
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base:   			RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							160 km/h;
						refit_cost: 					0;
