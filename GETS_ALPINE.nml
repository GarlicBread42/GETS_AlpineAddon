								switch_spritestack_SBB_RBe_540_Serie_Kolibri_front;}																																	

						switch (FEAT_TRAINS,SELF,switch_current_year_SBB_RBe_540,current_year) {
							   0 .. 1962: random_choose_SBB_RBe_540_Proto_gruen;
							1963 .. 1986: random_choose_SBB_RBe_540_Serie_gruen;
							1987 .. 1989: random_choose_SBB_RBe_540_Serie_gruen_neu;
							1990 .. 1991: random_choose_SBB_RBe_540_Serie_rot;
							1992 .. 2050: random_choose_SBB_RBe_540_Serie_Kolibri;
								random_choose_SBB_RBe_540_Serie_Kolibri;}

						switch (FEAT_TRAINS,SELF,switch_build_year_SBB_RBe_540,build_year) {
							   0 .. 1962: random_choose_SBB_RBe_540_Proto_gruen;
							1963 .. 1986: random_choose_SBB_RBe_540_Serie_gruen;
							1987 .. 1989: random_choose_SBB_RBe_540_Serie_gruen_neu;
							1990 .. 1991: random_choose_SBB_RBe_540_Serie_rot;
							1992 .. 2050: random_choose_SBB_RBe_540_Serie_Kolibri;
								random_choose_SBB_RBe_540_Serie_Kolibri;}

						switch(FEAT_TRAINS, SELF, switch_length_SBB_RBe_540, position_in_vehid_chain % 3) {
							0: 4;
							1: 5;
							2: 4;}
							
						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_RBe_540, 1){
							return 725;}							

						switch(FEAT_TRAINS, SELF, switch_FX_SBB_RBe_540_front, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,0, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);}	

						switch(FEAT_TRAINS, SELF, switch_FX_SBB_RBe_540_back, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC,-2, DISABLE_WAGON_POWER);
							1: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,  0, DISABLE_WAGON_POWER);
							2: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE,  0, DISABLE_WAGON_POWER);}	

						switch (FEAT_TRAINS, SELF, switch_FX_SBB_RBe_540, switch_alternative_var_random_bits(1, 1)) {
							1: switch_FX_SBB_RBe_540_back;
								switch_FX_SBB_RBe_540_front;}

						switch(FEAT_TRAINS, SELF, switch_SBB_RBe_540_graphics_build, position_in_vehid_chain % 3) {
							0:	 		spriteset_empty;
