//Switches

						switch (FEAT_TRAINS,SELF, switch_SBB_EW2_DVTD_purchase,build_year){
							   0 .. 1984: spriteset_SBB_EW2_DVTD_gruen_purchase;
							1985 .. 1989: spriteset_SBB_EW2_DVTD_gruen_neu_purchase;
							1990 .. 2050: spriteset_SBB_EW2_DVTD_rot_purchase;
								spriteset_SBB_EW2_DVTD_rot_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_DVTD_gruen, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_DVTD_gruen;
							1: spritegroup_SBB_EW2_DVTD_loading;}																		

						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_DVTD_gruen_neu, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_DVTD_gruen_neu;
							1: spritegroup_SBB_EW2_DVTD_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_DVTD_rot, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_DVTD_rot;
							1: spritegroup_SBB_EW2_DVTD_rot_loading;}
							
						switch(FEAT_TRAINS, SELF, switch_loadstack_SBB_EW2_DVTD_Seethal, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_EW2_DVTD_Seethal;
							1: spritegroup_SBB_EW2_DVTD_loading;}	
							
							   
						switch(FEAT_TRAINS, SELF, switch_length_SBB_EW2_DVTD, position_in_articulated_veh % 3) {
							0: 4;
							1: 7;
							2: 4;}	

						switch (FEAT_TRAINS, PARENT, switch_running_cost_SBB_EW2_DVTD,  switch_check_Restaurant_0()) {
							1: return 0;
							0: return 1700;}	
							
						switch (FEAT_TRAINS, PARENT, switch_cargo_aging_SBB_EW2_DVTD,  switch_check_Restaurant_0()) {
							1: return 233;
							0: return 185;}																					

						switch (FEAT_TRAINS,SELF, switch_SBB_EW2_DVTD_build_year,build_year){
							   0 .. 1984: switch_loadstack_SBB_EW2_DVTD_gruen;							   
							1985 .. 1989: switch_loadstack_SBB_EW2_DVTD_gruen_neu;
