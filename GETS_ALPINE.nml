							0:	   return switch_spritestack_OBB_Mazeppa;
							1:     spriteset_OBB_Juno_Tender;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Mazeppa, extra_callback_info1) {
							1: return ITEM_OBB_MAZEPPA; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_MAZEPPA, 0032)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_MAZEPPA);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1857,01,01);
						model_life: 					20;
						vehicle_life: 					20;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							60 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						223 hp;
						weight: 						31 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_graphics_OBB_Mazeppa;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_PASS),);
			length						   : switch_length_OBB_Mazeppa;
			articulated_part			   : switch_articulated_OBB_Mazeppa;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_spritestack_OBB_Mazeppa_purchase;
			cost_factor					    :5;
			running_cost_factor				:switch_running_cost_OBB_Mazeppa;
			visual_effect_and_powered		:switch_FX_OBB_Mazeppa;
			
			}
	}
