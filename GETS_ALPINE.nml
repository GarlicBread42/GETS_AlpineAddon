							0: spriteset_SBB_Ce_68_3_brown;
							1: return switch_animation_SBB_Ce_68_3;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Ce_68_3_green, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Ce_68_3_green;
							1: return switch_animation_SBB_Ce_68_3;}
														
						switch(FEAT_TRAINS, SELF, switch_length_SBB_Ce_68_3, position_in_vehid_chain % 3) {
							0: 4;
							1: 4;
							2: 4;}		
						
						switch(FEAT_TRAINS, SELF, switch_FX_SBB_Ce_68_3, position_in_vehid_chain % 3) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
								1 .. 2:return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}													

						switch(FEAT_TRAINS,PARENT,switch_running_cost_SBB_Ce_68_3, 1){
							return 2800;}
								
						switch (FEAT_TRAINS,SELF, switch_SBB_Ce_68_3_build_year,build_year){
							   0 .. 1928: return switch_spritestack_SBB_Ce_68_3_brown;
							1929 .. 2050: return switch_spritestack_SBB_Ce_68_3_green;
								switch_spritestack_SBB_Ce_68_3_green;}
								
						switch(FEAT_TRAINS, SELF, switch_graphics_SBB_Ce_68_3_build, position_in_vehid_chain % 3) {
							0:	   spriteset_empty;
							1:     return switch_SBB_Ce_68_3_build_year;
							2:     spriteset_empty;}

						switch (FEAT_TRAINS, SELF, switch_articulated_SBB_Ce_68_3_build, extra_callback_info1) {
							1 .. 2: return ITEM_SBB_CE_68_3_BUILD; 
								return CB_RESULT_NO_MORE_ARTICULATED_PARTS; }


item (FEAT_TRAINS , ITEM_SBB_CE_68_3_BUILD, 1586)
		{
	//property Block
			property 
			{
			//common properties
