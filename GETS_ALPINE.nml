	alternative_sprites (spriteset_OBB_KFNB_VI_KFNB_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/OBB_KFNB_VI/OBB_KFNB_VI_KFNB_1x_32bpp.png", "gfx/OBB_KFNB_VI/OBB_KFNB_VI_KFNB_1x_mask.png")
									{template_purchase(0, 0)}
									
