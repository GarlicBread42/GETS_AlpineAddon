//Spriteset purchase

spriteset(spriteset_BLS_Re_420_purchase, "gfx/BLS_Re_420/BLS_Re_420_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_BLS_Re_420_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_Re_420/BLS_Re_420_1x_32bpp.png", "gfx/BLS_Re_420/BLS_Re_420_1x_mask.png")
									{template_purchase(0, 0)}									

spriteset(spriteset_BLS_Re_420_panto_back_up_purchase, "gfx/BLS_Re_420/BLS_Re_420_panto_back_up_1x_8bpp.png")
									{ template_purchase(0, 0)}
		alternative_sprites (spriteset_BLS_Re_420_panto_back_up_purchase, ZOOM_LEVEL_NORMAL, BIT_DEPTH_32BPP, "gfx/BLS_Re_420/BLS_Re_420_panto_back_up_1x_32bpp.png", "gfx/BLS_Re_420/BLS_Re_420_panto_back_up_1x_mask.png")
									{ template_purchase(0, 0)}									
									
//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Re_420_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_Re_420_purchase;
							1: spriteset_BLS_Re_420_panto_back_up_purchase;}
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Re_420, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_Re_420;
							1: spriteset_BLS_Re_420_lights_front;
							2: spriteset_BLS_Re_420_lights_back;
							3: spriteset_BLS_Re_420_panto_back_up;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Re_420_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_Re_420_REV;
							1: spriteset_BLS_Re_420_lights_front_REV;
							2: spriteset_BLS_Re_420_lights_back_REV;
							3: spriteset_BLS_Re_420_panto_back_up_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Re_420_Wendezug, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_Re_420_Wendezug;
							1: spriteset_BLS_Re_420_lights_front_Wendezug;
							2: spriteset_BLS_Re_420_panto_back_up_Wendezug;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_Re_420_Wendezug_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 3 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_Re_420_REV;
							1: spriteset_BLS_Re_420_lights_back_Wendezug_REV;
							2: spriteset_BLS_Re_420_panto_front_up_REV;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_BLS_EW3_silber_DVT_Wendezug, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_BLS_EW3_silber_DVT_Reverse;
							1: spritegroup_BLS_EW3_silber_DVT_Reverse_loading;
							2: spriteset_BLS_EW3_DVT_lights_front_REV;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_BLS_Re_420, 1){
							return 1675;}
														
//Wendezug-Stuff
														
						switch(FEAT_TRAINS, SELF, switch_length_BLS_Re_420, position_in_vehid_chain % 3) {
							0: 4;
							1: 2;
							2: 4;}		

						switch(FEAT_TRAINS, SELF, switch_length_BLS_Re_420_Wendezug, position_in_articulated_veh % 3) {
							0: 4;
							1: 6;
							2: 4;}	
							
						switch (FEAT_TRAINS,PARENT,switch_1818_length_check_EW3,(count_veh_id(6870)+count_veh_id(1818)==num_vehs_in_consist)) {
							0: switch_length_BLS_Re_420; 
								switch_length_BLS_Re_420_Wendezug;}														
													
						switch(FEAT_TRAINS, SELF, switch_FX_BLS_Re_420, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}	
						 
						switch(FEAT_TRAINS, SELF, switch_FX_BLS_Re_420_NoFX, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 2, DISABLE_WAGON_POWER);
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}							 												

						switch (FEAT_TRAINS, PARENT, switch_FX_BLS_Re_420_Wendezug, vehicle_is_reversed) {
							0: switch_FX_BLS_Re_420;
								switch_FX_BLS_Re_420_NoFX;}	
								
						switch (FEAT_TRAINS,PARENT,switch_1818_FX_check_EW3,(count_veh_id(6870)+count_veh_id(1818)==num_vehs_in_consist)) {
							0: switch_FX_BLS_Re_420; 
								switch_FX_BLS_Re_420_Wendezug;}																
								
						switch (FEAT_TRAINS, PARENT, switch_reverse_BLS_Re_420_Wendezug_EW3, vehicle_is_reversed) {
							0: switch_spritestack_BLS_Re_420_Wendezug;
								switch_spritestack_BLS_EW3_silber_DVT_Wendezug;}
								
						switch (FEAT_TRAINS,PARENT,switch_1818_graphics_check_BLS_EW3_2,(count_veh_id(6870))) {
							0: switch_spritestack_BLS_Re_420; 
								switch_reverse_BLS_Re_420_Wendezug_EW3;}

