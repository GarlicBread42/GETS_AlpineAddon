//Switches

						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IX901_KFNB_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IX901_KFNB_purchase;
							1: spriteset_OBB_KFNB_IX901_anim_purchase;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IX901_kkstb_purchase, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_OBB_KFNB_IX901_kkstb_purchase;
							1: spriteset_OBB_KFNB_IX901_anim_purchase;}
							
						switch (FEAT_TRAINS,SELF, switch_OBB_KFNB_IX901_purchase,current_year){
							    0 .. 1908: switch_spritestack_OBB_KFNB_IX901_KFNB_purchase;	
							 1909 .. 2050: switch_spritestack_OBB_KFNB_IX901_kkstb_purchase;					 					 
								switch_spritestack_OBB_KFNB_IX901_kkstb_purchase;}																				

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_IX901, motion_counter % 4) {
							0: spriteset_OBB_KFNB_IX901_anim1;
							1: spriteset_OBB_KFNB_IX901_anim2;
							2: spriteset_OBB_KFNB_IX901_anim3;
							3: spriteset_OBB_KFNB_IX901_anim4;}							

						switch (FEAT_TRAINS, SELF, switch_animation_OBB_KFNB_IX901_REV, motion_counter % 4) {
							0: spriteset_OBB_KFNB_IX901_anim1_REV;
							1: spriteset_OBB_KFNB_IX901_anim2_REV;
							2: spriteset_OBB_KFNB_IX901_anim3_REV;
							3: spriteset_OBB_KFNB_IX901_anim4_REV;}							
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IX901_KFNB, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spritegroup_OBB_KFNB_IX901_KFNB;
							1: return switch_animation_OBB_KFNB_IX901;}			
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IX901_KFNB_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spritegroup_OBB_KFNB_IX901_KFNB_REV;
							1: return switch_animation_OBB_KFNB_IX901_REV;}	
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IX901_kkstb, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spritegroup_OBB_KFNB_IX901_kkstb;
							1: return switch_animation_OBB_KFNB_IX901;}			
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_OBB_KFNB_IX901_kkstb_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spritegroup_OBB_KFNB_IX901_kkstb_REV;
							1: return switch_animation_OBB_KFNB_IX901_REV;}																											
							
						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_KFNB_IX901_KFNB, vehicle_is_reversed) {
							0: switch_spritestack_OBB_KFNB_IX901_KFNB;
								switch_spritestack_OBB_KFNB_IX901_KFNB_REV;}

						switch (FEAT_TRAINS, PARENT, switch_reverse_OBB_KFNB_IX901_kkstb, vehicle_is_reversed) {
							0: switch_spritestack_OBB_KFNB_IX901_kkstb;
								switch_spritestack_OBB_KFNB_IX901_kkstb_REV;}

						switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_IX901, 1){
							return 225;}
							
						switch(FEAT_TRAINS, SELF, switch_FX_OBB_KFNB_IX901, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-4, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}
																							
						switch (FEAT_TRAINS,SELF,switch_OBB_KFNB_IX901_build_year,build_year){
							   0 .. 1908: switch_reverse_OBB_KFNB_IX901_KFNB;
							1909 .. 2050: switch_reverse_OBB_KFNB_IX901_kkstb;
								switch_reverse_OBB_KFNB_IX901_kkstb;}								


item (FEAT_TRAINS , ITEM_OBB_KFNB_IX901_BUILD, 0087)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_IX901_BUILD);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1880,01,01);
						model_life: 					30;
						vehicle_life: 					30;
						retire_early: 					-10;						
						reliability_decay: 				20;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);	
						refittable_cargo_classes:		bitmask();
						cargo_allow_refit:				[MAIL, GOOD, VALU];
						loading_speed:					3;
						cost_factor:                    108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							45 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						376 hp;
						weight: 						60 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						default_cargo_type:				MAIL;
						cargo_capacity:					30;
						length: 						5;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_OBB_KFNB_IX901_build_year;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_BAGG),);
			purchase					   : switch_OBB_KFNB_IX901_purchase;
			cost_factor					    :7;
			running_cost_factor				:switch_running_cost_OBB_KFNB_IX901;
			visual_effect_and_powered		:switch_FX_OBB_KFNB_IX901;
			
			}
	}


						switch (FEAT_TRAINS,SELF,switch_OBB_KFNB_IX901_current_year,current_year){
