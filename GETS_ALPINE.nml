					switch(FEAT_TRAINS, SELF, switch_FX_OBB_Koloss, position_in_vehid_chain % 2) {
							0: return visual_effect_and_powered(VISUAL_EFFECT_STEAM,-2, DISABLE_WAGON_POWER);														
								return visual_effect_and_powered(VISUAL_EFFECT_DISABLE, 0, DISABLE_WAGON_POWER);}								   
							   
					switch(FEAT_TRAINS, SELF, switch_graphics_OBB_Koloss, position_in_vehid_chain % 2) {
							0:	   return switch_spritestack_OBB_Koloss;
							1:     spriteset_OBB_Koloss_Tender;}					

					switch (FEAT_TRAINS, SELF, switch_articulated_OBB_Koloss, extra_callback_info1) {
							1: return ITEM_OBB_KOLOSS; 
						return CB_RESULT_NO_MORE_ARTICULATED_PARTS;}

item (FEAT_TRAINS , ITEM_OBB_KOLOSS, 0045)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KOLOSS);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1844,01,01);
						model_life: 					20;
						vehicle_life: 					20;
						retire_early: 					-10;						
						reliability_decay: 				20;
						cargo_allow_refit: 				[PASS] ;
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);								
						cargo_capacity: 				1 ;
						cost_factor: 					108;
						running_cost_base: 				RUNNING_COST_STEAM;						
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							30 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;
						power:  						96 hp;
						weight: 						25 ton;
						ai_engine_rank: 				0;
						engine_class: 					ENGINE_CLASS_STEAM;
						visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_STEAM, -2, DISABLE_WAGON_POWER);
						dual_headed: 					0;
						tractive_effort_coefficient: 	0.3;
						length: 						8;
												
			}

		//Vehicels Graphics
			graphics
			{
			default						   : switch_graphics_OBB_Koloss;
			additional_text				   : string(STR_CONCAT_3, 
											string(STR_GAUGE_STANDARD),
											string(STR_TRACTION_STEAM), 
											string(STR_DESC_GOODS),);
			length						   : switch_length_OBB_Koloss;
			articulated_part			   : switch_articulated_OBB_Koloss;
			purchase_cargo_capacity        : 0 ;
			cargo_capacity                 : return 0 ;
			purchase					   : switch_spritestack_OBB_Koloss_purchase;
			cost_factor					    :4;
			running_cost_factor				:switch_running_cost_OBB_Koloss;
			visual_effect_and_powered		:switch_FX_OBB_Koloss;
			
			}
	}
