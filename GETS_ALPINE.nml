						switch (FEAT_TRAINS, SELF, random_choose_OBB_KFNB_1837, switch_alternative_var_random_bits(1, 3)) {
							1: spritegroup_OBB_KFNB_1837_D2;
							2: spritegroup_OBB_KFNB_1837_C;
							3: spritegroup_OBB_KFNB_1837_B;
							4: spritegroup_OBB_KFNB_1837_A;
							5: spritegroup_OBB_KFNB_1837_A;
							6: spritegroup_OBB_KFNB_1837_C;
							7: spritegroup_OBB_KFNB_1837_B;
							   spritegroup_OBB_KFNB_1837_D1;}									   							  					   												

					switch(FEAT_TRAINS,PARENT,switch_running_cost_OBB_KFNB_1837, 1){
							return 200;}
																						
item (FEAT_TRAINS , ITEM_OBB_KFNB_1837, 6000)
		{
	//property Block
			property 
			{
			//common properties
						name: 							string(STR_NAME_OBB_KFNB_1837);
						extra_flags:					bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW);
						climates_available: 			ALL_CLIMATES;
						introduction_date: 				date(1837,01,01);
						model_life: 					30;
						vehicle_life: 					30;
						retire_early:					-10;						
						reliability_decay: 				20;
						refittable_cargo_classes:		bitmask(CC_PASSENGERS);
						misc_flags: 					bitmask(TRAIN_FLAG_SPRITE_STACK);						
						cargo_allow_refit:				[PASS, TOUR];
						loading_speed:					3;
						cost_factor:                    108;
						running_cost_base:              RUNNING_COST_DIESEL;
						running_cost_factor: 			90;
						
			//Train specific properties
						sprite_id: 						SPRITE_ID_NEW_TRAIN;
						speed: 							50 km/h;
						refit_cost: 					0;
						track_type: 					RAIL;						
						weight: 						8 ton;
						dual_headed: 					0;
						default_cargo_type:				PASS;
						cargo_capacity:					20;
						ai_engine_rank: 				0;
						length: 						4;												
			}
			
	//Vehicels Graphics
			graphics{
			default							: random_choose_OBB_KFNB_1837;
			additional_text					: string(STR_DESC_PASS);
			purchase						: spriteset_OBB_KFNB_1837_purchase;
			cost_factor						: 45;
			running_cost_factor				: switch_running_cost_OBB_KFNB_1837;
			}
		}
