						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_Mueller, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_840_Mueller;
							1: spriteset_SBB_Bm_840_lights_new_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_Mueller_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_840_Mueller_REV;
							1: spriteset_SBB_Bm_840_lights_new_back_REV;}		
							
						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_SRT, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_840_SRT;
							1: spriteset_SBB_Bm_840_lights_old_front;}

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_SRT_REV, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
							0: spriteset_SBB_Bm_840_SRT_REV;
							1: spriteset_SBB_Bm_840_lights_old_back_REV;}																					

						switch(FEAT_TRAINS, SELF, switch_spritestack_SBB_Bm_840_Stauffer, [STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100), getbits(extra_callback_info1, 8, 8)]) {
